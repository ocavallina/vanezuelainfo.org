// ── Clima (fase C: 100% Nyx) ─────────────────────────────────────────────────
// Tarjeta de la portada (#w-body) y página /clima completa. Open-Meteo con
// timezone=auto devuelve ISO LOCALES: se muestran con substring y se comparan
// entre sí con iso_to_epoch (tratados como "hora local plana").

// Redondeo al entero más cercano (Math.round; float_to_int trunca hacia 0)
fn round_i(v: float) -> int {
    if v >= 0.0 { return float_to_int(v + 0.5) }
    return 0 - float_to_int(0.0 - v + 0.5)
}

// Array JSON "key":[...] dentro de seg → elementos crudos (Strings, sin comillas)
fn jarr(seg: String, key: String) -> Array {
    let empty: Array = []
    let i0: int = jvalpos(seg, key)
    if i0 < 0 { return empty }
    if seg.substring(i0, i0 + 1) != "[" { return empty }
    let rest: String = seg.substring(i0 + 1, seg.length())
    let e: int = rest.indexOf("]")
    if e < 0 { return empty }
    let inner: String = rest.substring(0, e)
    if inner.length() == 0 { return empty }
    let parts: Array = inner.split(",")
    var out: Array = []
    var i: int = 0
    while i < parts.length() {
        var p: String = parts[i]
        if p.startsWith("\"") { p = p.substring(1, p.length()) }
        if p.endsWith("\"") { p = p.substring(0, p.length() - 1) }
        out.push(p)
        i = i + 1
    }
    return out
}

// Estado: [0]=lat [1]=lon [2]=nombre (compartido tarjeta/página vía localStorage)
var wc: Array = [""]
// Resultados del buscador de ciudades: nombre, lat, lon, subtítulo
var cr_name: Array = [""]
var cr_lat: Array = [""]
var cr_lon: Array = [""]
var cr_sub: Array = [""]

// Coordenadas guardadas (w_* de localStorage) con fallback opcional a ulat/ulon
// (solo la tarjeta) y default Caracas.
fn wc_load_coords(usa_ulat: int) {
    wc = ["10.4806", "-66.9036", "Caracas"]
    let sla: String = ls_get("w_lat")
    let slo: String = ls_get("w_lon")
    let snm: String = ls_get("w_name")
    if sla.length() > 0 and slo.length() > 0 {
        wc[0] = sla
        wc[1] = slo
        if snm.length() > 0 { wc[2] = snm } else { wc[2] = "Tu ciudad" }
        return
    }
    if usa_ulat == 1 {
        let ula: String = ls_get("ulat")
        let ulo: String = ls_get("ulon")
        if ula.length() > 0 and ulo.length() > 0 {
            wc[0] = ula
            wc[1] = ulo
            wc[2] = "Tu ubicacion"
        }
    }
}

// — Tarjeta de la portada —

fn wcard_fetch() {
    let la: String = wc[0]
    let lo: String = wc[1]
    browser_fetch("https://api.open-meteo.com/v1/forecast?latitude=" + la + "&longitude=" + lo + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m&timezone=auto", "GET", "", "wcard_on_meteo")
}

fn revgeo_fetch(handler: String) {
    let la: String = wc[0]
    let lo: String = wc[1]
    browser_fetch("https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" + la + "&longitude=" + lo + "&localityLanguage=es", "GET", "", handler)
}

#[export_name = "wcard_on_meteo"]
fn wcard_on_meteo(status: int, body: String) {
    if status != 200 {
        dom_set_text("#w-body", "No se pudo cargar el clima.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    if cur.length() == 0 {
        dom_set_text("#w-body", "Sin datos de clima.")
        return
    }
    let code: String = jnum(cur, "weather_code")
    var wcode: int = 0 - 1
    if code.length() > 0 { wcode = float_to_int(string_to_float(code)) }
    let w: Array = wdesc(wcode).split("|")
    let wt: String = w[0]
    let wi: String = w[1]
    let t: int = round_i(string_to_float(jnum(cur, "temperature_2m")))
    let st: int = round_i(string_to_float(jnum(cur, "apparent_temperature")))
    let hum: String = jnum(cur, "relative_humidity_2m")
    let vi: int = round_i(string_to_float(jnum(cur, "wind_speed_10m")))
    var h: String = "<div class=\"w-main\"><span class=\"w-emoji\">" + wi + "</span><span class=\"w-temp\">" + t.to_string() + "°C</span></div>"
    h = h + "<div class=\"w-desc\">" + wt + "</div>"
    h = h + "<div class=\"w-meta\">Sensacion " + st.to_string() + "°C · Humedad " + hum + "% · Viento " + vi.to_string() + " km/h</div>"
    dom_set_html("#w-body", h)
}

#[export_name = "wcard_on_revgeo"]
fn wcard_on_revgeo(status: int, body: String) {
    if status != 200 { return }
    var cc: String = jstr(body, "city")
    if cc.length() == 0 { cc = jstr(body, "locality") }
    if cc.length() == 0 { cc = jstr(body, "principalSubdivision") }
    if cc.length() == 0 { return }
    wc[2] = cc
    dom_set_text("#w-city-name", cc)
    ls_set("w_name", cc)
}

#[export_name = "wcard_geo_ok"]
fn wcard_geo_ok(lat: String, lon: String) {
    wc[0] = lat
    wc[1] = lon
    ls_set("w_lat", lat)
    ls_set("w_lon", lon)
    wcard_fetch()
    revgeo_fetch("wcard_on_revgeo")
}

fn wcard_boot() {
    wc_load_coords(1)
    let nm: String = wc[2]
    dom_set_text("#w-city-name", nm)
    wcard_fetch()
    if nm == "Tu ubicacion" or nm == "Mi ubicacion" {
        revgeo_fetch("wcard_on_revgeo")
    }
    js_geo("wcard_geo_ok", "")
}

// — Página /clima —

fn clima_fetch_all() {
    let la: String = wc[0]
    let lo: String = wc[1]
    let nm: String = wc[2]
    dom_set_text("#c-title", nm)
    dom_set_text("#c-actual", "Cargando…")
    browser_fetch("https://api.open-meteo.com/v1/forecast?latitude=" + la + "&longitude=" + lo + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,cloud_cover,surface_pressure,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation&hourly=temperature_2m,precipitation_probability,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset&forecast_days=7&timezone=auto", "GET", "", "clima_on_forecast")
    browser_fetch("https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" + la + "&longitude=" + lo + "&current=pm2_5,pm10,us_aqi&timezone=auto", "GET", "", "clima_on_aire")
}

// "2026-07-02T06:15" local → "06:15"
fn hm_of(iso: String) -> String {
    if iso.length() < 16 { return "" }
    return iso.substring(11, 16)
}

fn wdesc_of(code_raw: String) -> Array {
    var wcode: int = 0 - 1
    if code_raw.length() > 0 { wcode = float_to_int(string_to_float(code_raw)) }
    return wdesc(wcode).split("|")
}

#[export_name = "clima_on_forecast"]
fn clima_on_forecast(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-actual", "No se pudo cargar el clima.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    let w: Array = wdesc_of(jnum(cur, "weather_code"))
    let wt: String = w[0]
    let wi: String = w[1]
    var per: String = "Dia"
    if jnum(cur, "is_day") == "0" { per = "Noche" }
    var h: String = "<div class=\"ca-main\"><span class=\"ca-emoji\">" + wi + "</span><span class=\"ca-temp\">" + round_i(string_to_float(jnum(cur, "temperature_2m"))).to_string() + "°C</span><span class=\"ca-desc\">" + wt + "</span></div>"
    h = h + "<div class=\"ca-grid\">"
    h = h + "<div><span>Sensacion</span><b>" + round_i(string_to_float(jnum(cur, "apparent_temperature"))).to_string() + "°</b></div>"
    h = h + "<div><span>Humedad</span><b>" + jnum(cur, "relative_humidity_2m") + "%</b></div>"
    h = h + "<div><span>Viento</span><b>" + round_i(string_to_float(jnum(cur, "wind_speed_10m"))).to_string() + " km/h " + compass(round_i(string_to_float(jnum(cur, "wind_direction_10m")))) + "</b></div>"
    h = h + "<div><span>Rafagas</span><b>" + round_i(string_to_float(jnum(cur, "wind_gusts_10m"))).to_string() + " km/h</b></div>"
    h = h + "<div><span>Presion</span><b>" + round_i(string_to_float(jnum(cur, "surface_pressure"))).to_string() + " hPa</b></div>"
    h = h + "<div><span>Nubosidad</span><b>" + jnum(cur, "cloud_cover") + "%</b></div>"
    var prec: String = jnum(cur, "precipitation")
    if prec.length() == 0 { prec = "0" }
    h = h + "<div><span>Precipitacion</span><b>" + prec + " mm</b></div>"
    h = h + "<div><span>Periodo</span><b>" + per + "</b></div></div>"
    let daily: String = jseg(body, "\"daily\":{")
    let sunrise: Array = jarr(daily, "sunrise")
    if sunrise.length() > 0 {
        let sunset: Array = jarr(daily, "sunset")
        let uv: Array = jarr(daily, "uv_index_max")
        let sr: String = sunrise[0]
        let ss: String = sunset[0]
        let u0: String = uv[0]
        h = h + "<div class=\"ca-sun\">Amanece " + hm_of(sr) + " · Anochece " + hm_of(ss) + " · UV max " + u0 + "</div>"
    }
    dom_set_html("#c-actual", h)
    clima_render_horas(body)
    clima_render_dias(daily)
}

fn clima_render_horas(body: String) {
    let hr: String = jseg(body, "\"hourly\":{")
    let times: Array = jarr(hr, "time")
    if times.length() == 0 {
        dom_set_text("#c-horas", "")
        return
    }
    let temps: Array = jarr(hr, "temperature_2m")
    let probs: Array = jarr(hr, "precipitation_probability")
    let codes: Array = jarr(hr, "weather_code")
    // "ahora" en hora local plana (los ISO de Open-Meteo son locales)
    let now_loc: int = time() + tz_offset() * 60
    var out: String = ""
    var cnt: int = 0
    var i: int = 0
    while i < times.length() and cnt < 12 {
        let ti: String = times[i]
        if iso_to_epoch(ti) >= now_loc - 3600 {
            let ci: String = codes[i]
            let w: Array = wdesc_of(ci)
            let wi: String = w[1]
            let tv: String = temps[i]
            var pv: String = "0"
            if i < probs.length() {
                let p0: String = probs[i]
                if p0.length() > 0 { pv = p0 }
            }
            out = out + "<div class=\"ch-item\"><span class=\"ch-h\">" + ti.substring(11, 13) + ":00</span><span class=\"ch-e\">" + wi + "</span><span class=\"ch-t\">" + round_i(string_to_float(tv)).to_string() + "°</span><span class=\"ch-p\">" + pv + "%</span></div>"
            cnt = cnt + 1
        }
        i = i + 1
    }
    dom_set_html("#c-horas", out)
}

fn clima_render_dias(daily: String) {
    let times: Array = jarr(daily, "time")
    if times.length() == 0 {
        dom_set_text("#c-dias", "")
        return
    }
    let codes: Array = jarr(daily, "weather_code")
    let tmax: Array = jarr(daily, "temperature_2m_max")
    let tmin: Array = jarr(daily, "temperature_2m_min")
    let pmax: Array = jarr(daily, "precipitation_probability_max")
    var out: String = ""
    var i: int = 0
    while i < times.length() {
        let di: String = times[i]
        let y: int = float_to_int(string_to_float(di.substring(0, 4)))
        let mo: int = float_to_int(string_to_float(di.substring(5, 7)))
        let dd: int = float_to_int(string_to_float(di.substring(8, 10)))
        let dow: int = (days_from_civil(y, mo, dd) + 4) % 7
        var dn: String = "Dom"
        if dow == 1 { dn = "Lun" }
        if dow == 2 { dn = "Mar" }
        if dow == 3 { dn = "Mie" }
        if dow == 4 { dn = "Jue" }
        if dow == 5 { dn = "Vie" }
        if dow == 6 { dn = "Sab" }
        let ci: String = codes[i]
        let w: Array = wdesc_of(ci)
        let wi: String = w[1]
        let mx: String = tmax[i]
        let mn: String = tmin[i]
        var pp: String = "0"
        if i < pmax.length() {
            let p0: String = pmax[i]
            if p0.length() > 0 { pp = p0 }
        }
        out = out + "<div class=\"cd-item\"><span class=\"cd-d\">" + dn + "</span><span class=\"cd-e\">" + wi + "</span><span class=\"cd-mx\">" + round_i(string_to_float(mx)).to_string() + "°</span><span class=\"cd-mn\">" + round_i(string_to_float(mn)).to_string() + "°</span><span class=\"cd-p\">" + pp + "%</span></div>"
        i = i + 1
    }
    dom_set_html("#c-dias", out)
}

#[export_name = "clima_on_aire"]
fn clima_on_aire(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-aire", "Sin datos de calidad del aire.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    let aqi: String = jnum(cur, "us_aqi")
    if aqi.length() == 0 {
        dom_set_text("#c-aire", "Sin datos.")
        return
    }
    let l: Array = aqi_label(float_to_int(string_to_float(aqi))).split("|")
    let lt: String = l[0]
    let lc: String = l[1]
    var pm25: String = jnum(cur, "pm2_5")
    var pm10: String = jnum(cur, "pm10")
    dom_set_html("#c-aire", "<div class=\"ca-aqi\" style=\"border-color:" + lc + "\"><span class=\"aqi-num\" style=\"color:" + lc + "\">" + aqi + "</span><span class=\"aqi-lab\">AQI (US): " + lt + "</span><span class=\"aqi-pm\">PM2.5 " + pm25 + " · PM10 " + pm10 + "</span></div>")
}

// — Buscador de ciudades —

#[export_name = "clima_buscar"]
fn clima_buscar() {
    let term: String = dom_get_value("#c-q").trim()
    if term.length() == 0 { return }
    dom_set_text("#c-results", "Buscando…")
    browser_fetch("https://geocoding-api.open-meteo.com/v1/search?name=" + url_encode(term) + "&count=6&language=es", "GET", "", "clima_on_geo")
}

#[export_name = "clima_on_geo"]
fn clima_on_geo(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-results", "Error de busqueda.")
        return
    }
    cr_name = []
    cr_lat = []
    cr_lon = []
    cr_sub = []
    let p: int = body.indexOf("\"results\":[")
    if p < 0 {
        dom_set_text("#c-results", "Sin resultados.")
        return
    }
    let seg: String = body.substring(p + 11, body.length())
    let parts: Array = seg.split("},{")
    var out: String = "<input type=\"hidden\" id=\"c-sel\">"
    var i: int = 0
    while i < parts.length() and i < 6 {
        let ob: String = parts[i]
        let nm: String = jstr(ob, "name")
        let la: String = jnum(ob, "latitude")
        let lo: String = jnum(ob, "longitude")
        if nm.length() > 0 and la.length() > 0 and lo.length() > 0 {
            let a1: String = jstr(ob, "admin1")
            let cc: String = jstr(ob, "country_code")
            var sub: String = ""
            if a1.length() > 0 { sub = ", " + a1 }
            if cc.length() > 0 { sub = sub + " (" + cc + ")" }
            cr_name.push(nm)
            cr_lat.push(la)
            cr_lon.push(lo)
            cr_sub.push(sub)
            out = out + "<button type=\"button\" class=\"c-res\" data-i=\"" + (cr_name.length() - 1).to_string() + "\">" + esc(nm) + "<small>" + esc(sub) + "</small></button>"
        }
        i = i + 1
    }
    if cr_name.length() == 0 {
        dom_set_text("#c-results", "Sin resultados.")
        return
    }
    dom_set_html("#c-results", out)
}

fn clima_set_city(la: String, lo: String, nm: String) {
    wc[0] = la
    wc[1] = lo
    wc[2] = nm
    ls_set("w_lat", la)
    ls_set("w_lon", lo)
    ls_set("w_name", nm)
    clima_fetch_all()
}

#[export_name = "clima_pick"]
fn clima_pick() {
    let iv: String = dom_get_value("#c-sel")
    if iv.length() == 0 { return }
    let i: int = float_to_int(string_to_float(iv))
    if i < 0 or i >= cr_name.length() { return }
    let nm: String = cr_name[i]
    let la: String = cr_lat[i]
    let lo: String = cr_lon[i]
    let sub: String = cr_sub[i]
    dom_set_html("#c-results", "")
    js_set_value("#c-q", "")
    var full: String = nm
    let cm: int = sub.indexOf(" (")
    if cm > 0 { full = nm + sub.substring(0, cm) } else if sub.length() > 0 { full = nm + sub }
    clima_set_city(la, lo, full)
}

#[export_name = "clima_geo_click"]
fn clima_geo_click() {
    dom_set_text("#c-results", "Obteniendo ubicacion…")
    js_geo("clima_geo_ok", "clima_geo_err")
}

#[export_name = "clima_geo_ok"]
fn clima_geo_ok(lat: String, lon: String) {
    dom_set_text("#c-results", "")
    clima_set_city(lat, lon, "Mi ubicacion")
}

#[export_name = "clima_geo_err"]
fn clima_geo_err() {
    dom_set_text("#c-results", "No se pudo obtener la ubicacion.")
}

fn clima_boot() {
    wc_load_coords(0)
    dom_on("#c-buscar", "click", "clima_buscar")
    js_on_enter("#c-q", "clima_buscar")
    dom_on("#c-geo", "click", "clima_geo_click")
    js_delegate("#c-results", ".c-res", "data-i", "#c-sel", "clima_pick")
    clima_fetch_all()
}

