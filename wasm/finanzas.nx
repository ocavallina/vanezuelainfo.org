// ── Finanzas (fase B: 100% Nyx) ─────────────────────────────────────────────
// El propio módulo pide las 5 APIs vía js_fetch (pasarela) y extrae los floats
// con los scanners de JSON de arriba. Estado en holders del módulo; cada
// respuesta re-pinta (idempotente). Mismo markup que el fx.js retirado.

fn fin_row(l: String, v: String) -> String {
    return "<div class=\"fin-row\"><span class=\"fin-lab\">" + l + "</span><span class=\"fin-val\">" + v + "</span></div>"
}

fn fz_item(l: String, v: String, s: String) -> String {
    var out: String = "<div class=\"fz-item\"><span class=\"fz-l\">" + l + "</span><span class=\"fz-v\">" + v + "</span>"
    if s.length() > 0 {
        out = out + "<span class=\"fz-s\">" + s + "</span>"
    }
    return out + "</div>"
}

// Estado: [0]=bcv [1]=eur [2]=uc [3]=uv [4]=cop [5]=fch (local, ya formateada)
var fxv: Array = [""]
// Cripto: [0]=btc [1]=eth [2]=usdt
var fxc: Array = [""]

// Pinta la tarjeta de la portada (#fin-body) y/o la página /finanzas (#fz-div);
// dom_set_html es no-op si el selector no existe, así que la misma fn sirve
// para ambas.
fn fx_paint() {
    let bcv: String = fxv[0]
    let eur: String = fxv[1]
    let uc: String = fxv[2]
    let uv: String = fxv[3]
    let cop: String = fxv[4]
    let fch: String = fxv[5]

    var base: float = 0.0
    if uc.length() > 0 and uv.length() > 0 {
        base = (string_to_float(uc) + string_to_float(uv)) / 2.0
    } else if bcv.length() > 0 {
        base = string_to_float(bcv)
    }
    var copf: float = 0.0
    if cop.length() > 0 {
        copf = string_to_float(cop)
    }

    // Tarjeta de la portada
    var h: String = ""
    if bcv.length() > 0 { h = h + fin_row("Dólar BCV", " Bs " + fmt_bs(bcv)) }
    if uc.length() > 0 and uv.length() > 0 {
        h = h + fin_row("Dólar Binance", "Bs " + fmt_f(base, 2, 2))
    }
    if eur.length() > 0 { h = h + fin_row("Euro BCV", "Bs " + fmt_bs(eur)) }
    if cop.length() > 0 { h = h + fin_row("USD en COP", "COP " + fmt_cop(cop)) }
    if base > 0.0 and copf > 0.0 {
        h = h + fin_row("1.000 COP", "Bs " + fmt_f(base / copf * 1000.0, 2, 2))
    }
    if fch.length() > 0 {
        h = h + "<div class=\"fin-meta\">Actualizado " + fch + "</div>"
    }
    if h.length() == 0 { h = "Cargando…" }
    dom_set_html("#fin-body", h)

    // Página /finanzas (divisas)
    var g: String = ""
    if bcv.length() > 0 { g = g + fz_item("USD oficial (BCV)", "Bs " + fmt_bs(bcv), "") }
    if eur.length() > 0 { g = g + fz_item("EUR oficial (BCV)", "Bs " + fmt_bs(eur), "") }
    if uc.length() > 0 { g = g + fz_item("USDT compra (P2P)", "Bs " + fmt_bs(uc), "Binance P2P") }
    if uv.length() > 0 { g = g + fz_item("USDT venta (P2P)", "Bs " + fmt_bs(uv), "Binance P2P") }
    if cop.length() > 0 { g = g + fz_item("USD en Colombia", "COP " + fmt_cop(cop), "1 USD") }
    if base > 0.0 and copf > 0.0 {
        let bpc: float = base / copf
        g = g + fz_item("Peso ↔ Bolívar", "1.000 COP = Bs " + fmt_f(bpc * 1000.0, 2, 2), "Bs 100 = " + fmt_f(100.0 / bpc, 0, 0) + " COP (vía USDT)")
    }
    if g.length() == 0 { g = "Cargando…" }
    dom_set_html("#fz-div", g)
}

// Cripto de /finanzas (#fz-cripto).
fn fx_paint_cripto() {
    let btc: String = fxc[0]
    let eth: String = fxc[1]
    let usdt: String = fxc[2]
    var h: String = ""
    if btc.length() > 0 { h = h + fz_item("Bitcoin (BTC)", "$ " + fmt_f(string_to_float(btc), 0, 3), "") }
    if eth.length() > 0 { h = h + fz_item("Ethereum (ETH)", "$ " + fmt_f(string_to_float(eth), 0, 3), "") }
    if usdt.length() > 0 { h = h + fz_item("Tether (USDT)", "$ " + fmt_f(string_to_float(usdt), 2, 3), "") }
    if h.length() == 0 { h = "Sin datos." }
    dom_set_html("#fz-cripto", h)
}

// ── Calculadora de conversión (/calculadora) ────────────────────────────────
// Tres tasas (Dólar BCV, Euro BCV, Dólar Binance) tomadas del estado (fxv), con
// conversión bidireccional Bs↔divisa. rate_bs() devuelve Bs por 1 unidad de la
// divisa (0.0 si falta la tasa base → la UI muestra "Esperando tasas…").

fn cf(s: String) -> float {
    if s.length() == 0 { return 0.0 }
    return string_to_float(s)
}

// Tasa en Bs por 1 unidad de la divisa elegida en el selector.
// sel ∈ {"bcv" (Dólar BCV), "eur" (Euro BCV), "bin" (Dólar Binance = promedio
// compra/venta P2P)}. Devuelve 0.0 si aún falta la tasa base.
fn rate_bs(sel: String) -> float {
    if sel == "bcv" { return cf(fxv[0]) }
    if sel == "eur" { return cf(fxv[1]) }
    if sel == "bin" {
        let uc: float = cf(fxv[2])
        let uv: float = cf(fxv[3])
        if uc > 0.0 and uv > 0.0 { return (uc + uv) / 2.0 }
        return 0.0
    }
    return 0.0
}

// Nombre largo de la tasa (línea "1 X = … Bs").
fn div_name(sel: String) -> String {
    if sel == "bcv" { return "Dólar BCV" }
    if sel == "eur" { return "Euro BCV" }
    if sel == "bin" { return "Dólar Binance" }
    return ""
}

// Símbolo/etiqueta de la divisa (junto al monto/resultado).
fn div_sym(sel: String) -> String {
    if sel == "eur" { return "€" }
    return "$"
}

// Monto de divisa formateado con su símbolo (para resultado en sentido Bs→divisa).
fn fmt_div(sel: String, v: float) -> String {
    return div_sym(sel) + " " + fmt_f(v, 2, 2)
}

// Pinta la conversión. Lee la tasa (#calc-rate-sel), el sentido (#calc-dir:
// "d2b" divisa→Bs por defecto, "b2d" Bs→divisa) y el monto (#calc-amt).
#[export_name = "calc_render"]
fn calc_render() {
    let sel: String = dom_get_value("#calc-rate-sel")
    let dir: String = dom_get_value("#calc-dir")
    let r: float = rate_bs(sel)
    if r <= 0.0 {
        dom_set_html("#calc-result", "<span class=\"calc-wait\">Esperando tasas&hellip;</span>")
        dom_set_html("#calc-rate", "")
        return
    }
    let amt_s: String = dom_get_value("#calc-amt")
    var amt: float = 0.0
    if amt_s.length() > 0 { amt = string_to_float(amt_s) }
    if dir == "b2d" {
        // Bs → divisa (la unidad la muestra el span #calc-to-unit, no el resultado)
        dom_set_html("#calc-from-unit", "Bs")
        dom_set_html("#calc-to-unit", div_sym(sel))
        dom_set_html("#calc-result", fmt_f(amt / r, 2, 2))
    } else {
        // divisa → Bs
        dom_set_html("#calc-from-unit", div_sym(sel))
        dom_set_html("#calc-to-unit", "Bs")
        dom_set_html("#calc-result", fmt_f(amt * r, 2, 2))
    }
    dom_set_html("#calc-rate", "1 " + div_name(sel) + " = " + fmt_f(r, 2, 2) + " Bs")
}

// Invierte el sentido (divisa↔Bs) y recalcula.
#[export_name = "calc_swap"]
fn calc_swap() {
    let dir: String = dom_get_value("#calc-dir")
    if dir == "b2d" {
        js_set_value("#calc-dir", "d2b")
    } else {
        js_set_value("#calc-dir", "b2d")
    }
    calc_render()
}

// Texto de la conversión actual (para compartir/copiar).
fn calc_line() -> String {
    let sel: String = dom_get_value("#calc-rate-sel")
    let dir: String = dom_get_value("#calc-dir")
    let r: float = rate_bs(sel)
    if r <= 0.0 { return "" }
    let amt_s: String = dom_get_value("#calc-amt")
    var amt: float = 0.0
    if amt_s.length() > 0 { amt = string_to_float(amt_s) }
    if dir == "b2d" {
        return fmt_f(amt, 2, 2) + " Bs = " + fmt_div(sel, amt / r)
    }
    return fmt_div(sel, amt) + " = " + fmt_f(amt * r, 2, 2) + " Bs"
}

// Compartir la conversión actual (Web Share / portapapeles via pasarela). El
// texto se arma aquí; el enlace lo completa el loader con location.origin.
#[export_name = "calc_share"]
fn calc_share() {
    let line: String = calc_line()
    var txt: String = "Convierte Bolívares y Dólar BCV, Euro BCV o Dólar Binance en"
    if line.length() > 0 {
        txt = line + " · Convierte divisas de Venezuela en"
    }
    js_share(txt, "/calculadora")
}

// Copiar solo el resultado al portapapeles (js_copy de la pasarela).
#[export_name = "calc_copy"]
fn calc_copy() {
    let sel: String = dom_get_value("#calc-rate-sel")
    let dir: String = dom_get_value("#calc-dir")
    let r: float = rate_bs(sel)
    if r <= 0.0 { return }
    let amt_s: String = dom_get_value("#calc-amt")
    var amt: float = 0.0
    if amt_s.length() > 0 { amt = string_to_float(amt_s) }
    if dir == "b2d" {
        js_copy(fmt_div(sel, amt / r))
    } else {
        js_copy(fmt_f(amt * r, 2, 2) + " Bs")
    }
}

// Handlers de las respuestas (re-entran desde js_fetch de la pasarela)

#[export_name = "fx_on_dolares"]
fn fx_on_dolares(status: int, body: String) {
    if status != 200 { return }
    let seg: String = jseg(body, "\"oficial\"")
    if seg.length() == 0 { return }
    let v: String = jnum(seg, "promedio")
    if v.length() > 0 { fxv[0] = v }
    let f: String = jstr(seg, "fechaActualizacion")
    if f.length() > 0 { fxv[5] = fmt_dmy_hm(iso_to_epoch(f)) }
    fx_paint()
    calc_render()
}

#[export_name = "fx_on_euros"]
fn fx_on_euros(status: int, body: String) {
    if status != 200 { return }
    let seg: String = jseg(body, "\"oficial\"")
    if seg.length() == 0 { return }
    let v: String = jnum(seg, "promedio")
    if v.length() > 0 { fxv[1] = v }
    fx_paint()
    calc_render()
}

#[export_name = "fx_on_criptoya"]
fn fx_on_criptoya(status: int, body: String) {
    if status != 200 { return }
    let seg: String = jseg(body, "\"binancep2p\"")
    if seg.length() == 0 { return }
    let a: String = jnum(seg, "ask")
    let b: String = jnum(seg, "bid")
    if a.length() > 0 { fxv[2] = a }
    if b.length() > 0 { fxv[3] = b }
    fx_paint()
    calc_render()
}

#[export_name = "fx_on_cop"]
fn fx_on_cop(status: int, body: String) {
    if status != 200 { return }
    let v: String = jnum(body, "COP")
    if v.length() > 0 { fxv[4] = v }
    fx_paint()
    calc_render()
}

#[export_name = "fx_on_cripto"]
fn fx_on_cripto(status: int, body: String) {
    if status != 200 {
        dom_set_html("#fz-cripto", "No se pudo cargar cripto.")
        return
    }
    let b: String = jnum(jseg(body, "\"bitcoin\""), "usd")
    let e: String = jnum(jseg(body, "\"ethereum\""), "usd")
    let t: String = jnum(jseg(body, "\"tether\""), "usd")
    if b.length() > 0 { fxc[0] = b }
    if e.length() > 0 { fxc[1] = e }
    if t.length() > 0 { fxc[2] = t }
    fx_paint_cripto()
    calc_render()
}

// Arranque de tasas: con_cripto=1 trae también CoinGecko (cripto + USDT-USD),
// necesario en /finanzas (sección cripto) y /calculadora (USDT).
fn fx_boot(con_cripto: int) {
    fxv = ["", "", "", "", "", ""]
    fxc = ["", "", ""]
    browser_fetch("https://ve.dolarapi.com/v1/dolares", "GET", "", "fx_on_dolares")
    browser_fetch("https://criptoya.com/api/USDT/VES/1", "GET", "", "fx_on_criptoya")
    browser_fetch("https://ve.dolarapi.com/v1/euros", "GET", "", "fx_on_euros")
    browser_fetch("https://open.er-api.com/v6/latest/USD", "GET", "", "fx_on_cop")
    if con_cripto == 1 {
        browser_fetch("https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,tether&vs_currencies=usd", "GET", "", "fx_on_cripto")
    }
}

// Re-descarga la tasa Binance P2P (fx_on_criptoya re-pinta tarjeta y calculadora).
// Se dispara cada hora desde calc_boot para que el paralelo no quede viejo.
#[export_name = "fx_tick_binance"]
fn fx_tick_binance() {
    browser_fetch("https://criptoya.com/api/USDT/VES/1", "GET", "", "fx_on_criptoya")
}

// Arranque de la calculadora (página propia /calculadora). Reusa las tasas que
// deja fx_boot(0); cablea los controles, pinta y refresca Binance cada hora.
// ── Mini-calculadora de expresión (junto al monto) ─────────────────────────
// Evaluador recursivo-descendente sobre la cadena. Estado en holders de 1 elem
// (patrón del módulo). Al calcular, el resultado se escribe en #calc-amt y se
// dispara la conversión. Todo en Nyx→WASM sobre la pasarela (js_delegate/…).

var me_src: Array = [""]   // expresión normalizada
var me_pos: Array = [0]    // cursor
var me_ok: Array = [1]     // 1 = válida
var mc_open: Array = [0]   // panel abierto?

fn me_isdig(c: String) -> bool {
    if c == "0" or c == "1" or c == "2" or c == "3" or c == "4" { return true }
    if c == "5" or c == "6" or c == "7" or c == "8" or c == "9" { return true }
    return false
}

fn me_cur() -> String {
    let s: String = me_src[0]
    let p: int = me_pos[0]
    if p >= s.length() { return "" }
    return s.substring(p, p + 1)
}

fn me_adv() {
    me_pos[0] = me_pos[0] + 1
}

fn me_number() -> float {
    let s: String = me_src[0]
    let n: int = s.length()
    let start: int = me_pos[0]
    var i: int = start
    var go: bool = true
    while i < n and go {
        let ch: String = s.substring(i, i + 1)
        if me_isdig(ch) or ch == "." { i = i + 1 } else { go = false }
    }
    if i == start { me_ok[0] = 0; return 0.0 }
    let tok: String = s.substring(start, i)
    me_pos[0] = i
    return string_to_float(tok)
}

fn me_factor() -> float {
    let c: String = me_cur()
    if c == "-" { me_adv(); return 0.0 - me_factor() }
    if c == "+" { me_adv(); return me_factor() }
    if c == "(" {
        me_adv()
        let v: float = me_expr()
        if me_cur() == ")" { me_adv() } else { me_ok[0] = 0 }
        return v
    }
    return me_number()
}

fn me_term() -> float {
    var v: float = me_factor()
    var go: bool = true
    while go {
        let c: String = me_cur()
        if c == "*" {
            me_adv()
            let r: float = me_factor()
            v = v * r
        } else if c == "/" {
            me_adv()
            let r: float = me_factor()
            if r == 0.0 { me_ok[0] = 0; return 0.0 }
            v = v / r
        } else {
            go = false
        }
    }
    return v
}

fn me_expr() -> float {
    var v: float = me_term()
    var go: bool = true
    while go {
        let c: String = me_cur()
        if c == "+" { me_adv(); v = v + me_term() }
        else if c == "-" { me_adv(); v = v - me_term() }
        else { go = false }
    }
    return v
}

// Evalúa la expresión cruda. me_ok[0]=0 si hay error de sintaxis o /0.
fn me_eval(raw: String) -> float {
    var s: String = raw.replace("×", "*")
    s = s.replace("÷", "/")
    s = s.replace(",", ".")
    s = s.replace(" ", "")
    me_src[0] = s
    me_pos[0] = 0
    me_ok[0] = 1
    if s.length() == 0 { me_ok[0] = 0; return 0.0 }
    let v: float = me_expr()
    if me_pos[0] < s.length() { me_ok[0] = 0 }  // sobró basura → inválida
    return v
}

// float -> número plano con PUNTO (para el input[type=number]); hasta 4 decimales,
// recortando ceros/punto finales.
fn me_fmt(v: float) -> String {
    var neg: bool = false
    var x: float = v
    if x < 0.0 { neg = true; x = 0.0 - x }
    let scaled: int = float_to_int(x * 10000.0 + 0.5)
    let whole: int = scaled / 10000
    let frac: int = scaled % 10000
    var out: String = int_to_string(whole)
    if frac > 0 {
        var fs: String = int_to_string(frac)
        while fs.length() < 4 { fs = "0" + fs }
        var end: int = fs.length()
        while end > 0 and fs.substring(end - 1, end) == "0" { end = end - 1 }
        out = out + "." + fs.substring(0, end)
    }
    if neg { out = "-" + out }
    return out
}

#[export_name = "mcalc_toggle"]
fn mcalc_toggle() {
    mc_open[0] = 1 - mc_open[0]
    js_toggle_class("#mc-panel", "open", mc_open[0])
}

#[export_name = "mcalc_eval"]
fn mcalc_eval() {
    let expr: String = dom_get_value("#mc-expr")
    if expr.length() == 0 {
        dom_set_html("#mc-out", "")
        return
    }
    let r: float = me_eval(expr)
    if me_ok[0] == 0 {
        dom_set_html("#mc-out", "Expresi&oacute;n no v&aacute;lida")
        return
    }
    js_set_value("#calc-amt", me_fmt(r))
    calc_render()
    dom_set_html("#mc-out", "= " + fmt_f(r, 0, 4))
}

#[export_name = "mcalc_ins"]
fn mcalc_ins() {
    let k: String = dom_get_value("#mc-opkey")
    let cur: String = dom_get_value("#mc-expr")
    if k == "del" {
        if cur.length() > 0 { js_set_value("#mc-expr", cur.substring(0, cur.length() - 1)) }
    } else if k == "clr" {
        js_set_value("#mc-expr", "")
        dom_set_html("#mc-out", "")
    } else {
        js_set_value("#mc-expr", cur + k)
    }
}

fn calc_boot() {
    dom_on("#calc-amt", "input", "calc_render")
    dom_on("#calc-rate-sel", "change", "calc_render")
    dom_on("#calc-swap", "click", "calc_swap")
    dom_on("#calc-share", "click", "calc_share")
    dom_on("#calc-copy", "click", "calc_copy")
    mc_open[0] = 0
    dom_on("#mc-toggle", "click", "mcalc_toggle")
    dom_on("#mc-eq", "click", "mcalc_eval")
    js_on_enter("#mc-expr", "mcalc_eval")
    js_delegate("#mc-ops", "button", "data-op", "#mc-opkey", "mcalc_ins")
    browser_interval(3600000, "fx_tick_binance") // 1 h: refresca la tasa Binance
    calc_render()
}

