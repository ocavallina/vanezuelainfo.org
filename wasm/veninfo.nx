// veninfo.nx — módulo Nyx→WASM del front de venezuelainfo.org.
// Se compila con deploy/build-wasm.sh (make wasm del monorepo NyxLang) y se
// carga en el navegador vía static/assets/nyx-loader.js (shim nyx-wasi-shim.js).
// Regla de marshalling: SOLO int (BigInt en JS) y String cruzan la frontera;
// los floats entran como String (string_to_float) y salen ya formateados.
// Multi-valor: campos separados por "|". Sin GC en wasm (leak-by-design):
// no regenerar strings grandes en bucles calientes.

import "std/dom"
import "std/url"
import "std/browser"
import "std/json"
// Módulos del front (scope global plano; se re-inlinan en una sola unidad).
import "common"
import "finanzas"
import "clima"
import "sismos"
import "noticias"
import "chat"

// ── Pasarela de capacidades del navegador (los provee nyx-loader.js) ────────
// Patrón callback-por-NOMBRE-de-export (como dom_on): lo async re-entra al
// módulo llamando al export indicado. fetch/timers/localStorage/tz/media ahora
// vienen de std/browser (browser_fetch/browser_interval/…/ls_get/ls_set/
// tz_offset/match_media). Se quedan como externs propios los que std/browser NO
// cubre o cubriría con regresión: js_geo (con err_handler), js_delegate,
// js_on_enter, js_count, y los js_* de DOM extra (set_attr/…/set_value/share).
extern "js" fn js_geo(handler: String, err_handler: String)
extern "js" fn js_delegate(cont: String, item: String, attr: String, hidden: String, handler: String)
extern "js" fn js_on_enter(sel: String, handler: String)
extern "js" fn js_count(sel: String) -> int
extern "js" fn js_set_attr(sel: String, name: String, val: String)
extern "js" fn js_remove_attr(sel: String, name: String)
extern "js" fn js_toggle_class(sel: String, cls: String, on: int)
extern "js" fn js_set_value(sel: String, v: String)
extern "js" fn js_share(text: String, url: String)
extern "js" fn js_copy(text: String)

// Chat (Fase F): WebSocket + submit/visibility + historial en DOM (js_chat_*).
extern "js" fn js_ws(url: String, on_open: String, on_msg: String, on_close: String)
extern "js" fn js_ws_send(data: String)
extern "js" fn js_ws_close()
extern "js" fn js_on_submit(sel: String, handler: String)
extern "js" fn js_on_visibility(handler: String)
extern "js" fn js_hidden() -> int
extern "js" fn js_now_epoch() -> int
extern "js" fn js_chat_add(key: String, html: String, from_ws: int)
extern "js" fn js_chat_clear()
extern "js" fn js_chat_empty_check()

// Router de arranque: el servidor emite <input type="hidden" id="pg" value="X">
// en cada página; aquí se decide qué boots disparar (así el fetch de finanzas
// no corre en /sismos, etc.).
fn main() {
    console_log("veninfo.wasm: módulo Nyx cargado")
    // Dimensionar TODOS los holders globales aquí (gotcha: los literales
    // globales multi-elemento no se materializan; y así ningún handler
    // re-entrante pilla un holder corto aunque su boot no haya corrido).
    fxv = ["", "", "", "", "", ""]
    fxc = ["", "", ""]
    wc = ["10.4806", "-66.9036", "Caracas"]
    cr_name = []
    cr_lat = []
    cr_lon = []
    cr_sub = []
    let pg: String = dom_get_value("#pg")
    if pg == "index" {
        fx_boot(0)
        wcard_boot()
        rot_boot()
    }
    if pg == "finanzas" {
        fx_boot(1)
        news_boot() // lista de comunicados BVC (mismo markup expandible)
    }
    if pg == "clima" {
        clima_boot()
    }
    if pg == "sismos" {
        sismos_boot()
    }
    if pg == "noticias" {
        news_boot()
    }
    if pg == "chat" {
        chat_boot()
    }
    if pg == "calculadora" {
        fx_boot(1)
        calc_boot()
    }
}
