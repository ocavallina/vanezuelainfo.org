// veninfo.nx — módulo Nyx→WASM del front de venezuelainfo.org.
// Se compila con deploy/build-wasm.sh (make wasm del monorepo NyxLang) y se
// carga en el navegador vía static/assets/nyx-loader.js (shim nyx-wasi-shim.js).
// Regla de marshalling: SOLO int (BigInt en JS) y String cruzan la frontera;
// los floats entran como String (string_to_float) y salen ya formateados.
// Multi-valor: campos separados por "|". Sin GC en wasm (leak-by-design):
// no regenerar strings grandes en bucles calientes.

import "std/dom"

// ── Helpers puros compartidos (fase 1) ──────────────────────────────────────

// Código WMO → "texto|icono" (tarjeta del clima y página /clima)
#[export_name = "wdesc"]
fn wdesc(c: int) -> String {
    if c == 0 { return "Despejado|☀" }
    if c == 1 or c == 2 { return "Parcialmente nublado|⛅" }
    if c == 3 { return "Nublado|☁" }
    if c == 45 or c == 48 { return "Niebla|☁" }
    if c >= 51 and c <= 57 { return "Llovizna|☔" }
    if c >= 61 and c <= 67 { return "Lluvia|☔" }
    if c >= 71 and c <= 77 { return "Nieve|❄" }
    if c >= 80 and c <= 82 { return "Chubascos|☔" }
    if c >= 95 { return "Tormenta|⛈" }
    return "Clima|☁"
}

// Delta en segundos → "hace X s/min/h/d" (fechas de noticias)
#[export_name = "rel_time"]
fn rel_time(delta_s: int) -> String {
    var s: int = delta_s
    if s < 0 { s = 0 }
    if s < 60 { return "hace " + s.to_string() + " s" }
    if s < 3600 { return "hace " + (s / 60).to_string() + " min" }
    if s < 86400 { return "hace " + (s / 3600).to_string() + " h" }
    return "hace " + (s / 86400).to_string() + " d"
}

// Grados → punto cardinal (viento en /clima). Igual que el JS original:
// round(deg/45) % 8 sobre [N, NE, E, SE, S, SO, O, NO]
#[export_name = "compass"]
fn compass(deg: int) -> String {
    var d: int = deg % 360
    if d < 0 { d = d + 360 }
    let idx: int = ((d + 22) / 45) % 8
    if idx == 0 { return "N" }
    if idx == 1 { return "NE" }
    if idx == 2 { return "E" }
    if idx == 3 { return "SE" }
    if idx == 4 { return "S" }
    if idx == 5 { return "SO" }
    if idx == 6 { return "O" }
    return "NO"
}

// AQI (US) → "etiqueta|#color" (calidad del aire en /clima)
#[export_name = "aqi_label"]
fn aqi_label(v: int) -> String {
    if v <= 50 { return "Buena|#2e7d32" }
    if v <= 100 { return "Moderada|#f9a825" }
    if v <= 150 { return "Danina (sensibles)|#ef6c00" }
    if v <= 200 { return "Danina|#c62828" }
    if v <= 300 { return "Muy danina|#6a1b9a" }
    return "Peligrosa|#4a148c"
}

// Haversine en km (redondeado a entero). Coordenadas como String porque los
// floats no cruzan la frontera JS. Usado por /sismos y /sismos/{id}.
fn hav_f(la1: float, lo1: float, la2: float, lo2: float) -> float {
    let t: float = 3.141592653589793 / 180.0
    let dla: float = (la2 - la1) * t
    let dlo: float = (lo2 - lo1) * t
    let a: float = math_sin(dla / 2.0) * math_sin(dla / 2.0) + math_cos(la1 * t) * math_cos(la2 * t) * math_sin(dlo / 2.0) * math_sin(dlo / 2.0)
    return 6371.0 * 2.0 * math_atan2(math_sqrt(a), math_sqrt(1.0 - a))
}

#[export_name = "hav_km"]
fn hav_km(la1s: String, lo1s: String, la2s: String, lo2s: String) -> String {
    let la1: float = string_to_float(la1s)
    let lo1: float = string_to_float(lo1s)
    let la2: float = string_to_float(la2s)
    let lo2: float = string_to_float(lo2s)
    let d: float = hav_f(la1, lo1, la2, lo2)
    let km: int = float_to_int(d + 0.5)
    return km.to_string()
}

// ── Formateo de números estilo es-VE / es-CO ────────────────────────────────

// Agrupa miles con "." (es-VE y es-CO usan el mismo separador)
fn group_miles(n: int) -> String {
    let s: String = n.to_string()
    let ln: int = s.length()
    if ln <= 3 { return s }
    var out: String = ""
    var i: int = 0
    while i < ln {
        if i > 0 and (ln - i) % 3 == 0 {
            out = out + "."
        }
        out = out + s.substring(i, i + 1)
        i = i + 1
    }
    return out
}

// Formateo estilo toLocaleString es-VE/es-CO: miles con ".", decimales con
// ",", entre min_d y max_d decimales (los ceros finales se recortan hasta min_d)
fn fmt_f(v: float, min_d: int, max_d: int) -> String {
    var scale: int = 1
    var i: int = 0
    while i < max_d {
        scale = scale * 10
        i = i + 1
    }
    let n: int = float_to_int(v * int_to_float(scale) + 0.5)
    let ip: int = n / scale
    let fr: int = n % scale
    var fs: String = fr.to_string()
    while fs.length() < max_d {
        fs = "0" + fs
    }
    while fs.length() > min_d and fs.endsWith("0") {
        fs = fs.substring(0, fs.length() - 1)
    }
    if fs.length() == 0 or max_d == 0 {
        return group_miles(ip)
    }
    return group_miles(ip) + "," + fs
}

// Float (como String) → "1.234,56" (es-VE, 2 decimales)
#[export_name = "fmt_bs"]
fn fmt_bs(vs: String) -> String {
    return fmt_f(string_to_float(vs), 2, 2)
}

// Float (como String) → "4.124" (es-CO, 0 decimales, redondeado)
#[export_name = "fmt_cop"]
fn fmt_cop(vs: String) -> String {
    return fmt_f(string_to_float(vs), 0, 0)
}

// ── Finanzas (fase 2) ───────────────────────────────────────────────────────
// fx.js hace los fetch (wasm no tiene fetch), extrae los floats del JSON y los
// pasa como "clave=valor|clave=valor" (los valores no llevan | ni =; JS los
// sanea). Aquí se calcula y se arma el HTML. Mismo markup que el fx.js viejo.

fn kv_get(data: String, key: String) -> String {
    let pairs: Array = data.split("|")
    var i: int = 0
    while i < pairs.length() {
        let p: String = pairs[i]
        let eq: int = p.indexOf("=")
        if eq > 0 {
            let k: String = p.substring(0, eq)
            if k == key {
                return p.substring(eq + 1, p.length())
            }
        }
        i = i + 1
    }
    return ""
}

fn fin_row(l: String, v: String) -> String {
    return "<div class=\"fin-row\"><span class=\"fin-lab\">" + l + "</span><span class=\"fin-val\">" + v + "</span></div>"
}

fn fz_item(l: String, v: String, s: String) -> String {
    var out: String = "<div class=\"fz-item\"><span class=\"fz-l\">" + l + "</span><span class=\"fz-v\">" + v + "</span>"
    if s.length() > 0 {
        out = out + "<span class=\"fz-s\">" + s + "</span>"
    }
    return out + "</div>"
}

// Pinta la tarjeta de la portada (#fin-body) y/o la página /finanzas (#fz-div);
// dom_set_html es no-op si el selector no existe, así que el mismo export sirve
// para ambas. data: bcv, eur, uc (USDT compra), uv (USDT venta), cop, fch
// (fecha YA formateada en hora local por JS).
#[export_name = "fx_render"]
fn fx_render(data: String) {
    let bcv: String = kv_get(data, "bcv")
    let eur: String = kv_get(data, "eur")
    let uc: String = kv_get(data, "uc")
    let uv: String = kv_get(data, "uv")
    let cop: String = kv_get(data, "cop")
    let fch: String = kv_get(data, "fch")

    var base: float = 0.0
    if uc.length() > 0 and uv.length() > 0 {
        base = (string_to_float(uc) + string_to_float(uv)) / 2.0
    } else if bcv.length() > 0 {
        base = string_to_float(bcv)
    }
    var copf: float = 0.0
    if cop.length() > 0 {
        copf = string_to_float(cop)
    }

    // Tarjeta de la portada
    var h: String = ""
    if bcv.length() > 0 { h = h + fin_row("BCV", " Bs " + fmt_bs(bcv)) }
    if uc.length() > 0 { h = h + fin_row("USDT compra", "Bs " + fmt_bs(uc)) }
    if uv.length() > 0 { h = h + fin_row("USDT venta", "Bs " + fmt_bs(uv)) }
    if eur.length() > 0 { h = h + fin_row("Euro BCV", "Bs " + fmt_bs(eur)) }
    if cop.length() > 0 { h = h + fin_row("USD en COP", "COP " + fmt_cop(cop)) }
    if base > 0.0 and copf > 0.0 {
        h = h + fin_row("1.000 COP", "Bs " + fmt_f(base / copf * 1000.0, 2, 2))
    }
    if fch.length() > 0 {
        h = h + "<div class=\"fin-meta\">Actualizado " + fch + "</div>"
    }
    if h.length() == 0 { h = "Cargando…" }
    dom_set_html("#fin-body", h)

    // Página /finanzas (divisas)
    var g: String = ""
    if bcv.length() > 0 { g = g + fz_item("USD oficial (BCV)", "Bs " + fmt_bs(bcv), "") }
    if eur.length() > 0 { g = g + fz_item("EUR oficial (BCV)", "Bs " + fmt_bs(eur), "") }
    if uc.length() > 0 { g = g + fz_item("USDT compra (P2P)", "Bs " + fmt_bs(uc), "Binance P2P") }
    if uv.length() > 0 { g = g + fz_item("USDT venta (P2P)", "Bs " + fmt_bs(uv), "Binance P2P") }
    if cop.length() > 0 { g = g + fz_item("USD en Colombia", "COP " + fmt_cop(cop), "1 USD") }
    if base > 0.0 and copf > 0.0 {
        let bpc: float = base / copf
        g = g + fz_item("Peso ↔ Bolívar", "1.000 COP = Bs " + fmt_f(bpc * 1000.0, 2, 2), "Bs 100 = " + fmt_f(100.0 / bpc, 0, 0) + " COP (vía USDT)")
    }
    if g.length() == 0 { g = "Cargando…" }
    dom_set_html("#fz-div", g)
}

// Cripto de /finanzas (#fz-cripto). data: btc, eth, usdt (USD, floats crudos).
#[export_name = "fx_render_cripto"]
fn fx_render_cripto(data: String) {
    let btc: String = kv_get(data, "btc")
    let eth: String = kv_get(data, "eth")
    let usdt: String = kv_get(data, "usdt")
    var h: String = ""
    if btc.length() > 0 { h = h + fz_item("Bitcoin (BTC)", "$ " + fmt_f(string_to_float(btc), 0, 3), "") }
    if eth.length() > 0 { h = h + fz_item("Ethereum (ETH)", "$ " + fmt_f(string_to_float(eth), 0, 3), "") }
    if usdt.length() > 0 { h = h + fz_item("Tether (USDT)", "$ " + fmt_f(string_to_float(usdt), 2, 3), "") }
    if h.length() == 0 { h = "Sin datos." }
    dom_set_html("#fz-cripto", h)
}

// ── Sismos (fase 3) ─────────────────────────────────────────────────────────
// sismos.js serializa UNA vez las filas <tr data-*> que renderizó el servidor
// (registros por "\n", campos por "\t") y llama sismos_load. Filtrado, orden,
// paginación, selección y destacado 24h viven aquí; el tbody de la página
// visible se regenera con dom_set_html. La geolocalización y los timers se
// quedan en sismos.js (no existen en wasm). El MARKUP de fila debe ser
// idéntico al de render_quakes en src/sismos.nx (duplicación consciente).

// Externs propios (los provee static/assets/nyx-loader.js)
extern "js" fn js_ls_get(k: String) -> String
extern "js" fn js_ls_set(k: String, v: String)
extern "js" fn js_set_attr(sel: String, name: String, val: String)
extern "js" fn js_remove_attr(sel: String, name: String)
extern "js" fn js_toggle_class(sel: String, cls: String, on: int)
extern "js" fn js_set_value(sel: String, v: String)

fn esc(s: String) -> String {
    var out: String = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    return out
}

// Estado del módulo: arrays paralelos por sismo + holders escalares de 1
// elemento (patrón del proyecto: los literales globales multi-elemento no se
// materializan fiables; TODO se reasigna en sismos_load).
var s_id: Array = [""]
var s_iso: Array = [""]
var s_dia: Array = [""]
var s_hora: Array = [""]
var s_depth: Array = [""]
var s_mtype: Array = [""]
var s_mag: Array = [""]
var s_place: Array = [""]
var s_lats: Array = [""]
var s_lons: Array = [""]
var s_epoch: Array = [0]
var s_lat4: Array = [0]
var s_lon4: Array = [0]
var s_mag10: Array = [0]
var s_dist: Array = [0]
var s_n: Array = [0]
var s_page: Array = [0]
var s_sel: Array = [""]
var s_uloc: Array = [0]
var s_ulat4: Array = [0]
var s_ulon4: Array = [0]
var s_dmax: Array = [0]
var s_open: Array = [0]

fn s_minmag10() -> int {
    let v: String = dom_get_value("#f-mag")
    if v.length() == 0 { return 0 }
    return float_to_int(string_to_float(v) * 10.0 + 0.5)
}

// Distancia máxima activa del slider (0 = sin límite)
fn s_maxdist() -> int {
    if s_uloc[0] == 0 { return 0 }
    let v: String = dom_get_value("#f-dist")
    if v.length() == 0 { return 0 }
    let d: int = float_to_int(string_to_float(v))
    let mx: int = s_dmax[0]
    if d >= mx { return 0 }
    return d
}

fn s_orden() -> String {
    let v: String = dom_get_value("#f-orden")
    if v.length() == 0 { return "fecha" }
    return v
}

// ¿La fila i pasa los filtros actuales?
fn s_passes(i: int, minmag: int, maxd: int, q: String) -> int {
    let m: int = s_mag10[i]
    if m < minmag { return 0 }
    if maxd > 0 {
        let d: int = s_dist[i]
        if d >= 0 and d > maxd { return 0 }
    }
    if q.length() > 0 {
        let pl: String = s_place[i]
        if pl.toLower().indexOf(q) < 0 { return 0 }
    }
    return 1
}

// ¿idx[a] debe ir DESPUÉS de idx[b] según el orden elegido?
fn s_after(ia: int, ib: int, ord: String) -> int {
    if ord == "distancia" and s_uloc[0] == 1 {
        let da: int = s_dist[ia]
        let db: int = s_dist[ib]
        if da < 0 { return 1 }
        if db < 0 { return 0 }
        if da > db { return 1 }
        return 0
    }
    if ord == "magnitud" {
        let ma: int = s_mag10[ia]
        let mb: int = s_mag10[ib]
        if ma < mb { return 1 }
        if ma > mb { return 0 }
    }
    let ea: int = s_epoch[ia]
    let eb: int = s_epoch[ib]
    if ea < eb { return 1 }
    return 0
}

// Fila de la tabla (MISMO markup que render_quakes en src/sismos.nx, pero con
// fecha/hora local y la clase sel inline). Se escribe sobre el StringBuilder
// del render para minimizar strings intermedios (sin GC en wasm).
fn s_row_html(sb: StringBuilder, i: int, seld: int) {
    let id: String = s_id[i]
    let dia: String = s_dia[i]
    let hora: String = s_hora[i]
    let mag: String = s_mag[i]
    let depth: String = s_depth[i]
    let place: String = s_place[i]
    sb.append("<tr data-id=\"")
    sb.append(esc(id))
    if seld == 1 { sb.append("\" class=\"sel") }
    sb.append("\" style=\"cursor:pointer\"><td class=\"fh\"><span class=\"f-dia\">")
    sb.append(esc(dia))
    sb.append("</span><span class=\"f-hora\">")
    sb.append(esc(hora))
    sb.append("</span></td><td class=\"mag\">")
    sb.append(esc(mag))
    sb.append("</td><td>")
    if depth.length() > 0 {
        sb.append(esc(depth))
        sb.append(" km")
    } else {
        sb.append("-")
    }
    sb.append("</td><td>")
    sb.append(esc(place))
    sb.append("</td><td class=\"dist\">")
    let d: int = s_dist[i]
    if d >= 0 {
        sb.append(d.to_string())
        sb.append(" km")
    } else {
        sb.append("&mdash;")
    }
    sb.append("</td></tr>\n")
}

// Fila de detalle desplegable bajo la fila seleccionada
fn s_detail_html(sb: StringBuilder, i: int) {
    let id: String = s_id[i]
    let mag: String = s_mag[i]
    let mtype: String = s_mtype[i]
    let place: String = s_place[i]
    let dia: String = s_dia[i]
    let hora: String = s_hora[i]
    let depth: String = s_depth[i]
    let lats: String = s_lats[i]
    let lons: String = s_lons[i]
    sb.append("<tr class=\"detalle-row\"><td colspan=\"5\"><div class=\"detalle-band\"><b>M ")
    sb.append(esc(mag))
    sb.append(" ")
    sb.append(esc(mtype))
    sb.append("</b> &mdash; ")
    sb.append(esc(place))
    sb.append("<br>Fecha: ")
    sb.append(esc(dia))
    sb.append(" ")
    sb.append(esc(hora))
    sb.append("<br>Profundidad: ")
    sb.append(esc(depth))
    sb.append(" km<br>Coordenadas: ")
    sb.append(esc(lats))
    sb.append(", ")
    sb.append(esc(lons))
    let d: int = s_dist[i]
    if d >= 0 {
        sb.append("<br>Distancia desde ti: ")
        sb.append(d.to_string())
        sb.append(" km")
    }
    sb.append("<div class=\"detalle-acciones\"><a class=\"btn-map\" href=\"/sismos/")
    sb.append(esc(id))
    sb.append("\">Ver mapa y detalle &rarr;</a></div></div></td></tr>\n")
}

fn s_render() {
    let minmag: int = s_minmag10()
    let maxd: int = s_maxdist()
    let q: String = dom_get_value("#f-text").toLower()
    let ord: String = s_orden()

    // Filtrar
    var idx: Array = []
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        if s_passes(i, minmag, maxd, q) == 1 {
            idx.push(i)
        }
        i = i + 1
    }
    // Ordenar (inserción; <=200 elementos)
    var a: int = 1
    while a < idx.length() {
        let cur: int = idx[a]
        var b: int = a - 1
        var done: int = 0
        while b >= 0 and done == 0 {
            let pb: int = idx[b]
            if s_after(pb, cur, ord) == 1 {
                idx[b + 1] = pb
                b = b - 1
            } else {
                done = 1
            }
        }
        idx[b + 1] = cur
        a = a + 1
    }
    // Paginación
    let total: int = idx.length()
    var pages: int = (total + 11) / 12
    if pages < 1 { pages = 1 }
    var pg: int = s_page[0]
    if pg >= pages { pg = pages - 1 }
    if pg < 0 { pg = 0 }
    s_page[0] = pg
    // tbody de la página visible (+ detalle si la fila seleccionada está en ella)
    var sb: StringBuilder = StringBuilder.new()
    let sel: String = s_sel[0]
    var k: int = pg * 12
    let fin: int = (pg + 1) * 12
    while k < total and k < fin {
        let ri: int = idx[k]
        let rid: String = s_id[ri]
        var seld: int = 0
        if sel.length() > 0 and rid == sel { seld = 1 }
        s_row_html(sb, ri, seld)
        if seld == 1 {
            s_detail_html(sb, ri)
        }
        k = k + 1
    }
    dom_set_html("#qtbody", sb.to_string())
    dom_set_text("#s-count", total.to_string() + " sismos")
    dom_set_text("#p-info", (pg + 1).to_string() + " / " + pages.to_string())
    if pg <= 0 { js_set_attr("#p-prev", "disabled", "") } else { js_remove_attr("#p-prev", "disabled") }
    if pg >= pages - 1 { js_set_attr("#p-next", "disabled", "") } else { js_remove_attr("#p-next", "disabled") }
    // Badge de filtros activos + etiqueta del slider
    var act: int = 0
    if minmag > 0 or maxd > 0 or q.length() > 0 { act = 1 }
    js_toggle_class("#filtros-btn", "has-active", act)
    if s_uloc[0] == 0 {
        dom_set_text("#f-dist-val", "activa tu ubicacion")
    } else if maxd == 0 {
        dom_set_text("#f-dist-val", "sin limite")
    } else {
        dom_set_text("#f-dist-val", "hasta " + maxd.to_string() + " km")
    }
}

// Tarjeta "más fuerte 24 h" (#sismo-destacado)
fn s_destacado() {
    let now: int = time()
    var best: int = 0 - 1
    var bm: int = 0 - 1
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        let ep: int = s_epoch[i]
        if ep > 0 and now - ep <= 86400 and ep <= now + 3600 {
            let m: int = s_mag10[i]
            if m > bm {
                bm = m
                best = i
            } else if m == bm and best >= 0 {
                let eb: int = s_epoch[best]
                if ep > eb { best = i }
            }
        }
        i = i + 1
    }
    if best < 0 {
        js_remove_attr("#sismo-destacado", "href")
        js_toggle_class("#sismo-destacado", "vacio", 1)
        dom_set_html("#sismo-destacado", "<span class=\"destacado-tag\">Ultimas 24 h</span><span class=\"destacado-info\">Sin sismos registrados</span>")
        js_remove_attr("#sismo-destacado", "hidden")
        return
    }
    let id: String = s_id[best]
    let mag: String = s_mag[best]
    let mtype: String = s_mtype[best]
    let place: String = s_place[best]
    let dia: String = s_dia[best]
    let hora: String = s_hora[best]
    js_set_attr("#sismo-destacado", "href", "/sismos/" + esc(id))
    js_toggle_class("#sismo-destacado", "vacio", 0)
    dom_set_html("#sismo-destacado", "<span class=\"destacado-tag\">Mas fuerte (24 h)</span><span class=\"destacado-mag\">M " + esc(mag) + " " + esc(mtype) + "</span><span class=\"destacado-info\">" + esc(place) + " &middot; " + esc(dia) + " " + esc(hora) + "</span>")
    js_remove_attr("#sismo-destacado", "hidden")
}

fn s_apply_open() {
    if s_open[0] == 1 {
        js_remove_attr("#filtros", "hidden")
        js_set_attr("#filtros-btn", "aria-expanded", "true")
        js_toggle_class("#filtros-btn", "on", 1)
    } else {
        js_set_attr("#filtros", "hidden", "")
        js_set_attr("#filtros-btn", "aria-expanded", "false")
        js_toggle_class("#filtros-btn", "on", 0)
    }
}

// Handlers de dom_on (cero argumentos; el contexto va por estado del módulo)

#[export_name = "s_refiltrar"]
fn s_refiltrar() {
    js_ls_set("f_mag", dom_get_value("#f-mag"))
    js_ls_set("f_text", dom_get_value("#f-text"))
    js_ls_set("f_orden", dom_get_value("#f-orden"))
    if s_uloc[0] == 1 {
        js_ls_set("f_dist", dom_get_value("#f-dist"))
    }
    s_page[0] = 0
    s_render()
}

#[export_name = "s_prev"]
fn s_prev() {
    s_page[0] = s_page[0] - 1
    s_render()
}

#[export_name = "s_next"]
fn s_next() {
    s_page[0] = s_page[0] + 1
    s_render()
}

// Selección de fila: sismos.js escribe el data-id clicado en #s-selected
#[export_name = "s_select"]
fn s_select() {
    let id: String = dom_get_value("#s-selected")
    let cur: String = s_sel[0]
    if id == cur {
        s_sel[0] = ""
    } else {
        s_sel[0] = id
    }
    s_render()
}

#[export_name = "s_toggle_filtros"]
fn s_toggle_filtros() {
    if s_open[0] == 1 { s_open[0] = 0 } else { s_open[0] = 1 }
    if s_open[0] == 1 { js_ls_set("f_open", "1") } else { js_ls_set("f_open", "0") }
    s_apply_open()
}

// Ubicación del usuario (la llama sismos.js con la geolocalización; lat/lon
// como String porque los floats no cruzan la frontera)
#[export_name = "sismos_set_loc"]
fn sismos_set_loc(lats: String, lons: String) {
    let la: float = string_to_float(lats)
    let lo: float = string_to_float(lons)
    s_ulat4[0] = float_to_int(la * 10000.0)
    s_ulon4[0] = float_to_int(lo * 10000.0)
    s_uloc[0] = 1
    var mx: int = 0
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        let rla: float = int_to_float(s_lat4[i]) / 10000.0
        let rlo: float = int_to_float(s_lon4[i]) / 10000.0
        let d: int = float_to_int(hav_f(la, lo, rla, rlo) + 0.5)
        s_dist[i] = d
        if d > mx { mx = d }
        i = i + 1
    }
    mx = ((mx + 49) / 50) * 50
    if mx < 50 { mx = 50 }
    s_dmax[0] = mx
    js_set_attr("#f-dist", "max", mx.to_string())
    // aplicar f_dist guardado si cabe; si el slider estaba inerte, abrirlo al máximo
    let sd: String = js_ls_get("f_dist")
    var sdv: int = 0
    if sd.length() > 0 { sdv = float_to_int(string_to_float(sd)) }
    if sdv > 0 and sdv <= mx {
        js_set_value("#f-dist", sdv.to_string())
    } else {
        js_set_value("#f-dist", mx.to_string())
    }
    js_remove_attr("#f-dist", "disabled")
    s_render()
}

// Carga inicial: parsea la serialización, aplica filtros persistidos, registra
// los listeners y hace el primer render.
#[export_name = "sismos_load"]
fn sismos_load(data: String) {
    s_id = []
    s_iso = []
    s_dia = []
    s_hora = []
    s_depth = []
    s_mtype = []
    s_mag = []
    s_place = []
    s_lats = []
    s_lons = []
    s_epoch = []
    s_lat4 = []
    s_lon4 = []
    s_mag10 = []
    s_dist = []
    s_n = [0]
    s_page = [0]
    s_sel = [""]
    s_uloc = [0]
    s_ulat4 = [0]
    s_ulon4 = [0]
    s_dmax = [0]
    s_open = [0]

    let recs: Array = data.split("\n")
    var i: int = 0
    var n: int = 0
    while i < recs.length() {
        let rec: String = recs[i]
        let f: Array = rec.split("\t")
        if f.length() >= 11 {
            let f0: String = f[0]
            let f1: String = f[1]
            let f2: String = f[2]
            let f3: String = f[3]
            let f4: String = f[4]
            let f5: String = f[5]
            let f6: String = f[6]
            let f7: String = f[7]
            let f8: String = f[8]
            let f9: String = f[9]
            let f10: String = f[10]
            s_id.push(f0)
            s_epoch.push(float_to_int(string_to_float(f1)))
            s_iso.push(f2)
            s_lats.push(f3)
            s_lons.push(f4)
            s_lat4.push(float_to_int(string_to_float(f3) * 10000.0))
            s_lon4.push(float_to_int(string_to_float(f4) * 10000.0))
            s_depth.push(f5)
            s_mtype.push(f6)
            s_mag.push(f7)
            s_mag10.push(float_to_int(string_to_float(f7) * 10.0 + 0.5))
            s_place.push(f8)
            s_dia.push(f9)
            s_hora.push(f10)
            s_dist.push(0 - 1)
            n = n + 1
        }
        i = i + 1
    }
    s_n[0] = n

    // Filtros persistidos → controles (js_set_value fija la propiedad .value)
    let fm: String = js_ls_get("f_mag")
    if fm.length() > 0 { js_set_value("#f-mag", fm) }
    let ft: String = js_ls_get("f_text")
    if ft.length() > 0 { js_set_value("#f-text", ft) }
    let fo: String = js_ls_get("f_orden")
    if fo.length() > 0 { js_set_value("#f-orden", fo) }
    let fop: String = js_ls_get("f_open")
    if fop == "1" { s_open[0] = 1 }
    s_apply_open()

    // Listeners (por NOMBRE de export; re-entran a este módulo)
    dom_on("#f-mag", "change", "s_refiltrar")
    dom_on("#f-text", "change", "s_refiltrar")
    dom_on("#f-orden", "change", "s_refiltrar")
    dom_on("#f-dist", "change", "s_refiltrar")
    dom_on("#p-prev", "click", "s_prev")
    dom_on("#p-next", "click", "s_next")
    dom_on("#filtros-btn", "click", "s_toggle_filtros")

    s_destacado()
    s_render()
}

fn main() {
    console_log("veninfo.wasm: módulo Nyx cargado")
}
