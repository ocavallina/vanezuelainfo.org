// ── Clima (fase C: 100% Nyx) ─────────────────────────────────────────────────
// Tarjeta de la portada (#w-body) y página /clima completa. Open-Meteo con
// timezone=auto devuelve ISO LOCALES: se muestran con substring y se comparan
// entre sí con iso_to_epoch (tratados como "hora local plana").

// Redondeo al entero más cercano (Math.round; float_to_int trunca hacia 0)
fn round_i(v: float) -> int {
    if v >= 0.0 { return float_to_int(v + 0.5) }
    return 0 - float_to_int(0.0 - v + 0.5)
}

// Array JSON "key":[...] dentro de seg → elementos crudos (Strings, sin comillas)
fn jarr(seg: String, key: String) -> Array {
    let empty: Array = []
    let i0: int = jvalpos(seg, key)
    if i0 < 0 { return empty }
    if seg.substring(i0, i0 + 1) != "[" { return empty }
    let rest: String = seg.substring(i0 + 1, seg.length())
    let e: int = rest.indexOf("]")
    if e < 0 { return empty }
    let inner: String = rest.substring(0, e)
    if inner.length() == 0 { return empty }
    let parts: Array = inner.split(",")
    var out: Array = []
    var i: int = 0
    while i < parts.length() {
        var p: String = parts[i]
        if p.startsWith("\"") { p = p.substring(1, p.length()) }
        if p.endsWith("\"") { p = p.substring(0, p.length() - 1) }
        out.push(p)
        i = i + 1
    }
    return out
}

// Estado: [0]=lat [1]=lon [2]=nombre (compartido tarjeta/página vía localStorage)
var wc: Array = [""]
// Resultados del buscador de ciudades: nombre, lat, lon, subtítulo
var cr_name: Array = [""]
var cr_lat: Array = [""]
var cr_lon: Array = [""]
var cr_sub: Array = [""]

// Coordenadas guardadas (w_* de localStorage) con fallback opcional a ulat/ulon
// (solo la tarjeta) y default Caracas.
fn wc_load_coords(usa_ulat: int) {
    wc = ["10.4806", "-66.9036", "Caracas"]
    let sla: String = js_ls_get("w_lat")
    let slo: String = js_ls_get("w_lon")
    let snm: String = js_ls_get("w_name")
    if sla.length() > 0 and slo.length() > 0 {
        wc[0] = sla
        wc[1] = slo
        if snm.length() > 0 { wc[2] = snm } else { wc[2] = "Tu ciudad" }
        return
    }
    if usa_ulat == 1 {
        let ula: String = js_ls_get("ulat")
        let ulo: String = js_ls_get("ulon")
        if ula.length() > 0 and ulo.length() > 0 {
            wc[0] = ula
            wc[1] = ulo
            wc[2] = "Tu ubicacion"
        }
    }
}

// — Tarjeta de la portada —

fn wcard_fetch() {
    let la: String = wc[0]
    let lo: String = wc[1]
    js_fetch("https://api.open-meteo.com/v1/forecast?latitude=" + la + "&longitude=" + lo + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,weather_code,wind_speed_10m&timezone=auto", "GET", "", "wcard_on_meteo")
}

fn revgeo_fetch(handler: String) {
    let la: String = wc[0]
    let lo: String = wc[1]
    js_fetch("https://api.bigdatacloud.net/data/reverse-geocode-client?latitude=" + la + "&longitude=" + lo + "&localityLanguage=es", "GET", "", handler)
}

#[export_name = "wcard_on_meteo"]
fn wcard_on_meteo(status: int, body: String) {
    if status != 200 {
        dom_set_text("#w-body", "No se pudo cargar el clima.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    if cur.length() == 0 {
        dom_set_text("#w-body", "Sin datos de clima.")
        return
    }
    let code: String = jnum(cur, "weather_code")
    var wcode: int = 0 - 1
    if code.length() > 0 { wcode = float_to_int(string_to_float(code)) }
    let w: Array = wdesc(wcode).split("|")
    let wt: String = w[0]
    let wi: String = w[1]
    let t: int = round_i(string_to_float(jnum(cur, "temperature_2m")))
    let st: int = round_i(string_to_float(jnum(cur, "apparent_temperature")))
    let hum: String = jnum(cur, "relative_humidity_2m")
    let vi: int = round_i(string_to_float(jnum(cur, "wind_speed_10m")))
    var h: String = "<div class=\"w-main\"><span class=\"w-emoji\">" + wi + "</span><span class=\"w-temp\">" + t.to_string() + "°C</span></div>"
    h = h + "<div class=\"w-desc\">" + wt + "</div>"
    h = h + "<div class=\"w-meta\">Sensacion " + st.to_string() + "°C · Humedad " + hum + "% · Viento " + vi.to_string() + " km/h</div>"
    dom_set_html("#w-body", h)
}

#[export_name = "wcard_on_revgeo"]
fn wcard_on_revgeo(status: int, body: String) {
    if status != 200 { return }
    var cc: String = jstr(body, "city")
    if cc.length() == 0 { cc = jstr(body, "locality") }
    if cc.length() == 0 { cc = jstr(body, "principalSubdivision") }
    if cc.length() == 0 { return }
    wc[2] = cc
    dom_set_text("#w-city-name", cc)
    js_ls_set("w_name", cc)
}

#[export_name = "wcard_geo_ok"]
fn wcard_geo_ok(lat: String, lon: String) {
    wc[0] = lat
    wc[1] = lon
    js_ls_set("w_lat", lat)
    js_ls_set("w_lon", lon)
    wcard_fetch()
    revgeo_fetch("wcard_on_revgeo")
}

fn wcard_boot() {
    wc_load_coords(1)
    let nm: String = wc[2]
    dom_set_text("#w-city-name", nm)
    wcard_fetch()
    if nm == "Tu ubicacion" or nm == "Mi ubicacion" {
        revgeo_fetch("wcard_on_revgeo")
    }
    js_geo("wcard_geo_ok", "")
}

// — Página /clima —

fn clima_fetch_all() {
    let la: String = wc[0]
    let lo: String = wc[1]
    let nm: String = wc[2]
    dom_set_text("#c-title", nm)
    dom_set_text("#c-actual", "Cargando…")
    js_fetch("https://api.open-meteo.com/v1/forecast?latitude=" + la + "&longitude=" + lo + "&current=temperature_2m,relative_humidity_2m,apparent_temperature,is_day,weather_code,cloud_cover,surface_pressure,wind_speed_10m,wind_direction_10m,wind_gusts_10m,precipitation&hourly=temperature_2m,precipitation_probability,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,uv_index_max,sunrise,sunset&forecast_days=7&timezone=auto", "GET", "", "clima_on_forecast")
    js_fetch("https://air-quality-api.open-meteo.com/v1/air-quality?latitude=" + la + "&longitude=" + lo + "&current=pm2_5,pm10,us_aqi&timezone=auto", "GET", "", "clima_on_aire")
}

// "2026-07-02T06:15" local → "06:15"
fn hm_of(iso: String) -> String {
    if iso.length() < 16 { return "" }
    return iso.substring(11, 16)
}

fn wdesc_of(code_raw: String) -> Array {
    var wcode: int = 0 - 1
    if code_raw.length() > 0 { wcode = float_to_int(string_to_float(code_raw)) }
    return wdesc(wcode).split("|")
}

#[export_name = "clima_on_forecast"]
fn clima_on_forecast(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-actual", "No se pudo cargar el clima.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    let w: Array = wdesc_of(jnum(cur, "weather_code"))
    let wt: String = w[0]
    let wi: String = w[1]
    var per: String = "Dia"
    if jnum(cur, "is_day") == "0" { per = "Noche" }
    var h: String = "<div class=\"ca-main\"><span class=\"ca-emoji\">" + wi + "</span><span class=\"ca-temp\">" + round_i(string_to_float(jnum(cur, "temperature_2m"))).to_string() + "°C</span><span class=\"ca-desc\">" + wt + "</span></div>"
    h = h + "<div class=\"ca-grid\">"
    h = h + "<div><span>Sensacion</span><b>" + round_i(string_to_float(jnum(cur, "apparent_temperature"))).to_string() + "°</b></div>"
    h = h + "<div><span>Humedad</span><b>" + jnum(cur, "relative_humidity_2m") + "%</b></div>"
    h = h + "<div><span>Viento</span><b>" + round_i(string_to_float(jnum(cur, "wind_speed_10m"))).to_string() + " km/h " + compass(round_i(string_to_float(jnum(cur, "wind_direction_10m")))) + "</b></div>"
    h = h + "<div><span>Rafagas</span><b>" + round_i(string_to_float(jnum(cur, "wind_gusts_10m"))).to_string() + " km/h</b></div>"
    h = h + "<div><span>Presion</span><b>" + round_i(string_to_float(jnum(cur, "surface_pressure"))).to_string() + " hPa</b></div>"
    h = h + "<div><span>Nubosidad</span><b>" + jnum(cur, "cloud_cover") + "%</b></div>"
    var prec: String = jnum(cur, "precipitation")
    if prec.length() == 0 { prec = "0" }
    h = h + "<div><span>Precipitacion</span><b>" + prec + " mm</b></div>"
    h = h + "<div><span>Periodo</span><b>" + per + "</b></div></div>"
    let daily: String = jseg(body, "\"daily\":{")
    let sunrise: Array = jarr(daily, "sunrise")
    if sunrise.length() > 0 {
        let sunset: Array = jarr(daily, "sunset")
        let uv: Array = jarr(daily, "uv_index_max")
        let sr: String = sunrise[0]
        let ss: String = sunset[0]
        let u0: String = uv[0]
        h = h + "<div class=\"ca-sun\">Amanece " + hm_of(sr) + " · Anochece " + hm_of(ss) + " · UV max " + u0 + "</div>"
    }
    dom_set_html("#c-actual", h)
    clima_render_horas(body)
    clima_render_dias(daily)
}

fn clima_render_horas(body: String) {
    let hr: String = jseg(body, "\"hourly\":{")
    let times: Array = jarr(hr, "time")
    if times.length() == 0 {
        dom_set_text("#c-horas", "")
        return
    }
    let temps: Array = jarr(hr, "temperature_2m")
    let probs: Array = jarr(hr, "precipitation_probability")
    let codes: Array = jarr(hr, "weather_code")
    // "ahora" en hora local plana (los ISO de Open-Meteo son locales)
    let now_loc: int = time() + js_tz_offset_min() * 60
    var out: String = ""
    var cnt: int = 0
    var i: int = 0
    while i < times.length() and cnt < 12 {
        let ti: String = times[i]
        if iso_to_epoch(ti) >= now_loc - 3600 {
            let ci: String = codes[i]
            let w: Array = wdesc_of(ci)
            let wi: String = w[1]
            let tv: String = temps[i]
            var pv: String = "0"
            if i < probs.length() {
                let p0: String = probs[i]
                if p0.length() > 0 { pv = p0 }
            }
            out = out + "<div class=\"ch-item\"><span class=\"ch-h\">" + ti.substring(11, 13) + ":00</span><span class=\"ch-e\">" + wi + "</span><span class=\"ch-t\">" + round_i(string_to_float(tv)).to_string() + "°</span><span class=\"ch-p\">" + pv + "%</span></div>"
            cnt = cnt + 1
        }
        i = i + 1
    }
    dom_set_html("#c-horas", out)
}

fn clima_render_dias(daily: String) {
    let times: Array = jarr(daily, "time")
    if times.length() == 0 {
        dom_set_text("#c-dias", "")
        return
    }
    let codes: Array = jarr(daily, "weather_code")
    let tmax: Array = jarr(daily, "temperature_2m_max")
    let tmin: Array = jarr(daily, "temperature_2m_min")
    let pmax: Array = jarr(daily, "precipitation_probability_max")
    var out: String = ""
    var i: int = 0
    while i < times.length() {
        let di: String = times[i]
        let y: int = float_to_int(string_to_float(di.substring(0, 4)))
        let mo: int = float_to_int(string_to_float(di.substring(5, 7)))
        let dd: int = float_to_int(string_to_float(di.substring(8, 10)))
        let dow: int = (days_from_civil(y, mo, dd) + 4) % 7
        var dn: String = "Dom"
        if dow == 1 { dn = "Lun" }
        if dow == 2 { dn = "Mar" }
        if dow == 3 { dn = "Mie" }
        if dow == 4 { dn = "Jue" }
        if dow == 5 { dn = "Vie" }
        if dow == 6 { dn = "Sab" }
        let ci: String = codes[i]
        let w: Array = wdesc_of(ci)
        let wi: String = w[1]
        let mx: String = tmax[i]
        let mn: String = tmin[i]
        var pp: String = "0"
        if i < pmax.length() {
            let p0: String = pmax[i]
            if p0.length() > 0 { pp = p0 }
        }
        out = out + "<div class=\"cd-item\"><span class=\"cd-d\">" + dn + "</span><span class=\"cd-e\">" + wi + "</span><span class=\"cd-mx\">" + round_i(string_to_float(mx)).to_string() + "°</span><span class=\"cd-mn\">" + round_i(string_to_float(mn)).to_string() + "°</span><span class=\"cd-p\">" + pp + "%</span></div>"
        i = i + 1
    }
    dom_set_html("#c-dias", out)
}

#[export_name = "clima_on_aire"]
fn clima_on_aire(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-aire", "Sin datos de calidad del aire.")
        return
    }
    let cur: String = jseg(body, "\"current\":{")
    let aqi: String = jnum(cur, "us_aqi")
    if aqi.length() == 0 {
        dom_set_text("#c-aire", "Sin datos.")
        return
    }
    let l: Array = aqi_label(float_to_int(string_to_float(aqi))).split("|")
    let lt: String = l[0]
    let lc: String = l[1]
    var pm25: String = jnum(cur, "pm2_5")
    var pm10: String = jnum(cur, "pm10")
    dom_set_html("#c-aire", "<div class=\"ca-aqi\" style=\"border-color:" + lc + "\"><span class=\"aqi-num\" style=\"color:" + lc + "\">" + aqi + "</span><span class=\"aqi-lab\">AQI (US): " + lt + "</span><span class=\"aqi-pm\">PM2.5 " + pm25 + " · PM10 " + pm10 + "</span></div>")
}

// — Buscador de ciudades —

#[export_name = "clima_buscar"]
fn clima_buscar() {
    let term: String = dom_get_value("#c-q").trim()
    if term.length() == 0 { return }
    dom_set_text("#c-results", "Buscando…")
    js_fetch("https://geocoding-api.open-meteo.com/v1/search?name=" + url_encode(term) + "&count=6&language=es", "GET", "", "clima_on_geo")
}

#[export_name = "clima_on_geo"]
fn clima_on_geo(status: int, body: String) {
    if status != 200 {
        dom_set_text("#c-results", "Error de busqueda.")
        return
    }
    cr_name = []
    cr_lat = []
    cr_lon = []
    cr_sub = []
    let p: int = body.indexOf("\"results\":[")
    if p < 0 {
        dom_set_text("#c-results", "Sin resultados.")
        return
    }
    let seg: String = body.substring(p + 11, body.length())
    let parts: Array = seg.split("},{")
    var out: String = "<input type=\"hidden\" id=\"c-sel\">"
    var i: int = 0
    while i < parts.length() and i < 6 {
        let ob: String = parts[i]
        let nm: String = jstr(ob, "name")
        let la: String = jnum(ob, "latitude")
        let lo: String = jnum(ob, "longitude")
        if nm.length() > 0 and la.length() > 0 and lo.length() > 0 {
            let a1: String = jstr(ob, "admin1")
            let cc: String = jstr(ob, "country_code")
            var sub: String = ""
            if a1.length() > 0 { sub = ", " + a1 }
            if cc.length() > 0 { sub = sub + " (" + cc + ")" }
            cr_name.push(nm)
            cr_lat.push(la)
            cr_lon.push(lo)
            cr_sub.push(sub)
            out = out + "<button type=\"button\" class=\"c-res\" data-i=\"" + (cr_name.length() - 1).to_string() + "\">" + esc(nm) + "<small>" + esc(sub) + "</small></button>"
        }
        i = i + 1
    }
    if cr_name.length() == 0 {
        dom_set_text("#c-results", "Sin resultados.")
        return
    }
    dom_set_html("#c-results", out)
}

fn clima_set_city(la: String, lo: String, nm: String) {
    wc[0] = la
    wc[1] = lo
    wc[2] = nm
    js_ls_set("w_lat", la)
    js_ls_set("w_lon", lo)
    js_ls_set("w_name", nm)
    clima_fetch_all()
}

#[export_name = "clima_pick"]
fn clima_pick() {
    let iv: String = dom_get_value("#c-sel")
    if iv.length() == 0 { return }
    let i: int = float_to_int(string_to_float(iv))
    if i < 0 or i >= cr_name.length() { return }
    let nm: String = cr_name[i]
    let la: String = cr_lat[i]
    let lo: String = cr_lon[i]
    let sub: String = cr_sub[i]
    dom_set_html("#c-results", "")
    js_set_value("#c-q", "")
    var full: String = nm
    let cm: int = sub.indexOf(" (")
    if cm > 0 { full = nm + sub.substring(0, cm) } else if sub.length() > 0 { full = nm + sub }
    clima_set_city(la, lo, full)
}

#[export_name = "clima_geo_click"]
fn clima_geo_click() {
    dom_set_text("#c-results", "Obteniendo ubicacion…")
    js_geo("clima_geo_ok", "clima_geo_err")
}

#[export_name = "clima_geo_ok"]
fn clima_geo_ok(lat: String, lon: String) {
    dom_set_text("#c-results", "")
    clima_set_city(lat, lon, "Mi ubicacion")
}

#[export_name = "clima_geo_err"]
fn clima_geo_err() {
    dom_set_text("#c-results", "No se pudo obtener la ubicacion.")
}

fn clima_boot() {
    wc_load_coords(0)
    dom_on("#c-buscar", "click", "clima_buscar")
    js_on_enter("#c-q", "clima_buscar")
    dom_on("#c-geo", "click", "clima_geo_click")
    js_delegate("#c-results", ".c-res", "data-i", "#c-sel", "clima_pick")
    clima_fetch_all()
}

// ── Sismos (fase 3) ─────────────────────────────────────────────────────────
// sismos.js serializa UNA vez las filas <tr data-*> que renderizó el servidor
// (registros por "\n", campos por "\t") y llama sismos_load. Filtrado, orden,
// paginación, selección y destacado 24h viven aquí; el tbody de la página
// visible se regenera con dom_set_html. La geolocalización y los timers se
// quedan en sismos.js (no existen en wasm). El MARKUP de fila debe ser
// idéntico al de render_quakes en src/sismos.nx (duplicación consciente).

// Externs propios (los provee static/assets/nyx-loader.js)
extern "js" fn js_ls_get(k: String) -> String
extern "js" fn js_ls_set(k: String, v: String)
extern "js" fn js_set_attr(sel: String, name: String, val: String)
extern "js" fn js_remove_attr(sel: String, name: String)
extern "js" fn js_toggle_class(sel: String, cls: String, on: int)
extern "js" fn js_set_value(sel: String, v: String)
extern "js" fn js_share(text: String, url: String)

fn esc(s: String) -> String {
    var out: String = s.replace("&", "&amp;")
    out = out.replace("<", "&lt;")
    out = out.replace(">", "&gt;")
    out = out.replace("\"", "&quot;")
    return out
}

// Estado del módulo: arrays paralelos por sismo + holders escalares de 1
// elemento (patrón del proyecto: los literales globales multi-elemento no se
// materializan fiables; TODO se reasigna en sismos_load).
var s_id: Array = [""]
var s_iso: Array = [""]
var s_dia: Array = [""]
var s_hora: Array = [""]
var s_depth: Array = [""]
var s_mtype: Array = [""]
var s_mag: Array = [""]
var s_place: Array = [""]
var s_lats: Array = [""]
var s_lons: Array = [""]
var s_epoch: Array = [0]
var s_lat4: Array = [0]
var s_lon4: Array = [0]
var s_mag10: Array = [0]
var s_dist: Array = [0]
var s_n: Array = [0]
var s_page: Array = [0]
var s_sel: Array = [""]
var s_uloc: Array = [0]
var s_ulat4: Array = [0]
var s_ulon4: Array = [0]
var s_dmax: Array = [0]
var s_open: Array = [0]

fn s_minmag10() -> int {
    let v: String = dom_get_value("#f-mag")
    if v.length() == 0 { return 0 }
    return float_to_int(string_to_float(v) * 10.0 + 0.5)
}

// Distancia máxima activa del slider (0 = sin límite)
fn s_maxdist() -> int {
    if s_uloc[0] == 0 { return 0 }
    let v: String = dom_get_value("#f-dist")
    if v.length() == 0 { return 0 }
    let d: int = float_to_int(string_to_float(v))
    let mx: int = s_dmax[0]
    if d >= mx { return 0 }
    return d
}

fn s_orden() -> String {
    let v: String = dom_get_value("#f-orden")
    if v.length() == 0 { return "fecha" }
    return v
}

// ¿La fila i pasa los filtros actuales?
fn s_passes(i: int, minmag: int, maxd: int, q: String) -> int {
    let m: int = s_mag10[i]
    if m < minmag { return 0 }
    if maxd > 0 {
        let d: int = s_dist[i]
        if d >= 0 and d > maxd { return 0 }
    }
    if q.length() > 0 {
        let pl: String = s_place[i]
        if pl.toLower().indexOf(q) < 0 { return 0 }
    }
    return 1
}

// ¿idx[a] debe ir DESPUÉS de idx[b] según el orden elegido?
fn s_after(ia: int, ib: int, ord: String) -> int {
    if ord == "distancia" and s_uloc[0] == 1 {
        let da: int = s_dist[ia]
        let db: int = s_dist[ib]
        if da < 0 { return 1 }
        if db < 0 { return 0 }
        if da > db { return 1 }
        return 0
    }
    if ord == "magnitud" {
        let ma: int = s_mag10[ia]
        let mb: int = s_mag10[ib]
        if ma < mb { return 1 }
        if ma > mb { return 0 }
    }
    let ea: int = s_epoch[ia]
    let eb: int = s_epoch[ib]
    if ea < eb { return 1 }
    return 0
}

// Fila de la tabla (MISMO markup que render_quakes en src/sismos.nx, pero con
// fecha/hora local y la clase sel inline). Se escribe sobre el StringBuilder
// del render para minimizar strings intermedios (sin GC en wasm).
fn s_row_html(sb: StringBuilder, i: int, seld: int) {
    let id: String = s_id[i]
    let dia: String = s_dia[i]
    let hora: String = s_hora[i]
    let mag: String = s_mag[i]
    let depth: String = s_depth[i]
    let place: String = s_place[i]
    sb.append("<tr data-id=\"")
    sb.append(esc(id))
    if seld == 1 { sb.append("\" class=\"sel") }
    sb.append("\" style=\"cursor:pointer\"><td class=\"fh\"><span class=\"f-dia\">")
    sb.append(esc(dia))
    sb.append("</span><span class=\"f-hora\">")
    sb.append(esc(hora))
    sb.append("</span></td><td class=\"mag\">")
    sb.append(esc(mag))
    sb.append("</td><td>")
    if depth.length() > 0 {
        sb.append(esc(depth))
        sb.append(" km")
    } else {
        sb.append("-")
    }
    sb.append("</td><td>")
    sb.append(esc(place))
    sb.append("</td><td class=\"dist\">")
    let d: int = s_dist[i]
    if d >= 0 {
        sb.append(d.to_string())
        sb.append(" km")
    } else {
        sb.append("&mdash;")
    }
    sb.append("</td></tr>\n")
}

// Fila de detalle desplegable bajo la fila seleccionada
fn s_detail_html(sb: StringBuilder, i: int) {
    let id: String = s_id[i]
    let mag: String = s_mag[i]
    let mtype: String = s_mtype[i]
    let place: String = s_place[i]
    let dia: String = s_dia[i]
    let hora: String = s_hora[i]
    let depth: String = s_depth[i]
    let lats: String = s_lats[i]
    let lons: String = s_lons[i]
    sb.append("<tr class=\"detalle-row\"><td colspan=\"5\"><div class=\"detalle-band\"><b>M ")
    sb.append(esc(mag))
    sb.append(" ")
    sb.append(esc(mtype))
    sb.append("</b> &mdash; ")
    sb.append(esc(place))
    sb.append("<br>Fecha: ")
    sb.append(esc(dia))
    sb.append(" ")
    sb.append(esc(hora))
    sb.append("<br>Profundidad: ")
    sb.append(esc(depth))
    sb.append(" km<br>Coordenadas: ")
    sb.append(esc(lats))
    sb.append(", ")
    sb.append(esc(lons))
    let d: int = s_dist[i]
    if d >= 0 {
        sb.append("<br>Distancia desde ti: ")
        sb.append(d.to_string())
        sb.append(" km")
    }
    sb.append("<div class=\"detalle-acciones\"><a class=\"btn-map\" href=\"/sismos/")
    sb.append(esc(id))
    sb.append("\">Ver mapa y detalle &rarr;</a></div></div></td></tr>\n")
}

fn s_render() {
    let minmag: int = s_minmag10()
    let maxd: int = s_maxdist()
    let q: String = dom_get_value("#f-text").toLower()
    let ord: String = s_orden()

    // Filtrar
    var idx: Array = []
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        if s_passes(i, minmag, maxd, q) == 1 {
            idx.push(i)
        }
        i = i + 1
    }
    // Ordenar (inserción; <=200 elementos)
    var a: int = 1
    while a < idx.length() {
        let cur: int = idx[a]
        var b: int = a - 1
        var done: int = 0
        while b >= 0 and done == 0 {
            let pb: int = idx[b]
            if s_after(pb, cur, ord) == 1 {
                idx[b + 1] = pb
                b = b - 1
            } else {
                done = 1
            }
        }
        idx[b + 1] = cur
        a = a + 1
    }
    // Paginación
    let total: int = idx.length()
    var pages: int = (total + 11) / 12
    if pages < 1 { pages = 1 }
    var pg: int = s_page[0]
    if pg >= pages { pg = pages - 1 }
    if pg < 0 { pg = 0 }
    s_page[0] = pg
    // tbody de la página visible (+ detalle si la fila seleccionada está en ella)
    var sb: StringBuilder = StringBuilder.new()
    let sel: String = s_sel[0]
    var k: int = pg * 12
    let fin: int = (pg + 1) * 12
    while k < total and k < fin {
        let ri: int = idx[k]
        let rid: String = s_id[ri]
        var seld: int = 0
        if sel.length() > 0 and rid == sel { seld = 1 }
        s_row_html(sb, ri, seld)
        if seld == 1 {
            s_detail_html(sb, ri)
        }
        k = k + 1
    }
    dom_set_html("#qtbody", sb.to_string())
    dom_set_text("#s-count", total.to_string() + " sismos")
    dom_set_text("#p-info", (pg + 1).to_string() + " / " + pages.to_string())
    if pg <= 0 { js_set_attr("#p-prev", "disabled", "") } else { js_remove_attr("#p-prev", "disabled") }
    if pg >= pages - 1 { js_set_attr("#p-next", "disabled", "") } else { js_remove_attr("#p-next", "disabled") }
    // Badge de filtros activos + etiqueta del slider
    var act: int = 0
    if minmag > 0 or maxd > 0 or q.length() > 0 { act = 1 }
    js_toggle_class("#filtros-btn", "has-active", act)
    if s_uloc[0] == 0 {
        dom_set_text("#f-dist-val", "activa tu ubicacion")
    } else if maxd == 0 {
        dom_set_text("#f-dist-val", "sin limite")
    } else {
        dom_set_text("#f-dist-val", "hasta " + maxd.to_string() + " km")
    }
}

// Tarjeta "más fuerte 24 h" (#sismo-destacado)
fn s_destacado() {
    let now: int = time()
    var best: int = 0 - 1
    var bm: int = 0 - 1
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        let ep: int = s_epoch[i]
        if ep > 0 and now - ep <= 86400 and ep <= now + 3600 {
            let m: int = s_mag10[i]
            if m > bm {
                bm = m
                best = i
            } else if m == bm and best >= 0 {
                let eb: int = s_epoch[best]
                if ep > eb { best = i }
            }
        }
        i = i + 1
    }
    if best < 0 {
        js_remove_attr("#sismo-destacado", "href")
        js_toggle_class("#sismo-destacado", "vacio", 1)
        dom_set_html("#sismo-destacado", "<span class=\"destacado-tag\">Ultimas 24 h</span><span class=\"destacado-info\">Sin sismos registrados</span>")
        js_remove_attr("#sismo-destacado", "hidden")
        return
    }
    let id: String = s_id[best]
    let mag: String = s_mag[best]
    let mtype: String = s_mtype[best]
    let place: String = s_place[best]
    let dia: String = s_dia[best]
    let hora: String = s_hora[best]
    js_set_attr("#sismo-destacado", "href", "/sismos/" + esc(id))
    js_toggle_class("#sismo-destacado", "vacio", 0)
    dom_set_html("#sismo-destacado", "<span class=\"destacado-tag\">Mas fuerte (24 h)</span><span class=\"destacado-mag\">M " + esc(mag) + " " + esc(mtype) + "</span><span class=\"destacado-info\">" + esc(place) + " &middot; " + esc(dia) + " " + esc(hora) + "</span>")
    js_remove_attr("#sismo-destacado", "hidden")
}

fn s_apply_open() {
    if s_open[0] == 1 {
        js_remove_attr("#filtros", "hidden")
        js_set_attr("#filtros-btn", "aria-expanded", "true")
        js_toggle_class("#filtros-btn", "on", 1)
    } else {
        js_set_attr("#filtros", "hidden", "")
        js_set_attr("#filtros-btn", "aria-expanded", "false")
        js_toggle_class("#filtros-btn", "on", 0)
    }
}

// Handlers de dom_on (cero argumentos; el contexto va por estado del módulo)

#[export_name = "s_refiltrar"]
fn s_refiltrar() {
    js_ls_set("f_mag", dom_get_value("#f-mag"))
    js_ls_set("f_text", dom_get_value("#f-text"))
    js_ls_set("f_orden", dom_get_value("#f-orden"))
    if s_uloc[0] == 1 {
        js_ls_set("f_dist", dom_get_value("#f-dist"))
    }
    s_page[0] = 0
    s_render()
}

#[export_name = "s_prev"]
fn s_prev() {
    s_page[0] = s_page[0] - 1
    s_render()
}

#[export_name = "s_next"]
fn s_next() {
    s_page[0] = s_page[0] + 1
    s_render()
}

// Selección de fila: sismos.js escribe el data-id clicado en #s-selected
#[export_name = "s_select"]
fn s_select() {
    let id: String = dom_get_value("#s-selected")
    let cur: String = s_sel[0]
    if id == cur {
        s_sel[0] = ""
    } else {
        s_sel[0] = id
    }
    s_render()
}

#[export_name = "s_toggle_filtros"]
fn s_toggle_filtros() {
    if s_open[0] == 1 { s_open[0] = 0 } else { s_open[0] = 1 }
    if s_open[0] == 1 { js_ls_set("f_open", "1") } else { js_ls_set("f_open", "0") }
    s_apply_open()
}

// Ubicación del usuario (lat/lon como String: los floats no cruzan la frontera)
fn s_set_loc_internal(lats: String, lons: String) {
    let la: float = string_to_float(lats)
    let lo: float = string_to_float(lons)
    s_ulat4[0] = float_to_int(la * 10000.0)
    s_ulon4[0] = float_to_int(lo * 10000.0)
    s_uloc[0] = 1
    var mx: int = 0
    var i: int = 0
    let n: int = s_n[0]
    while i < n {
        let rla: float = int_to_float(s_lat4[i]) / 10000.0
        let rlo: float = int_to_float(s_lon4[i]) / 10000.0
        let d: int = float_to_int(hav_f(la, lo, rla, rlo) + 0.5)
        s_dist[i] = d
        if d > mx { mx = d }
        i = i + 1
    }
    mx = ((mx + 49) / 50) * 50
    if mx < 50 { mx = 50 }
    s_dmax[0] = mx
    js_set_attr("#f-dist", "max", mx.to_string())
    // aplicar f_dist guardado si cabe; si el slider estaba inerte, abrirlo al máximo
    let sd: String = js_ls_get("f_dist")
    var sdv: int = 0
    if sd.length() > 0 { sdv = float_to_int(string_to_float(sd)) }
    if sdv > 0 and sdv <= mx {
        js_set_value("#f-dist", sdv.to_string())
    } else {
        js_set_value("#f-dist", mx.to_string())
    }
    js_remove_attr("#f-dist", "disabled")
    s_render()
}

// Export para la suite de tests (el flujo real entra por sismos_geo_ok)
#[export_name = "sismos_set_loc"]
fn sismos_set_loc(lats: String, lons: String) {
    s_set_loc_internal(lats, lons)
}

fn s_reset() {
    s_id = []
    s_iso = []
    s_dia = []
    s_hora = []
    s_depth = []
    s_mtype = []
    s_mag = []
    s_place = []
    s_lats = []
    s_lons = []
    s_epoch = []
    s_lat4 = []
    s_lon4 = []
    s_mag10 = []
    s_dist = []
    s_n = [0]
    s_page = [0]
    s_sel = [""]
    s_uloc = [0]
    s_ulat4 = [0]
    s_ulon4 = [0]
    s_dmax = [0]
    s_open = [0]
}

fn s_push_row(id: String, epoch: int, iso: String, lats: String, lons: String, depth: String, mtype: String, mag: String, place: String, dia: String, hora: String) {
    s_id.push(id)
    s_epoch.push(epoch)
    s_iso.push(iso)
    s_lats.push(lats)
    s_lons.push(lons)
    s_lat4.push(float_to_int(string_to_float(lats) * 10000.0))
    s_lon4.push(float_to_int(string_to_float(lons) * 10000.0))
    s_depth.push(depth)
    s_mtype.push(mtype)
    s_mag.push(mag)
    s_mag10.push(float_to_int(string_to_float(mag) * 10.0 + 0.5))
    s_place.push(place)
    s_dia.push(dia)
    s_hora.push(hora)
    s_dist.push(0 - 1)
    s_n[0] = s_n[0] + 1
}

fn s_finish_load() {
    // Filtros persistidos → controles (js_set_value fija la propiedad .value)
    let fm: String = js_ls_get("f_mag")
    if fm.length() > 0 { js_set_value("#f-mag", fm) }
    let ft: String = js_ls_get("f_text")
    if ft.length() > 0 { js_set_value("#f-text", ft) }
    let fo: String = js_ls_get("f_orden")
    if fo.length() > 0 { js_set_value("#f-orden", fo) }
    let fop: String = js_ls_get("f_open")
    if fop == "1" { s_open[0] = 1 }
    s_apply_open()

    // Listeners (por NOMBRE de export; re-entran a este módulo)
    dom_on("#f-mag", "change", "s_refiltrar")
    dom_on("#f-text", "change", "s_refiltrar")
    dom_on("#f-orden", "change", "s_refiltrar")
    dom_on("#f-dist", "change", "s_refiltrar")
    dom_on("#p-prev", "click", "s_prev")
    dom_on("#p-next", "click", "s_next")
    dom_on("#filtros-btn", "click", "s_toggle_filtros")
    js_delegate(".tabla-scroll", "tr[data-id]", "data-id", "#s-selected", "s_select")

    s_destacado()
    s_render()
}

// Carga desde serialización de 11 campos (id, epoch, iso, lat, lon, depth,
// type, mag, place, dia, hora) — la usa la suite de tests.
#[export_name = "sismos_load"]
fn sismos_load(data: String) {
    s_reset()
    let recs: Array = data.split("\n")
    var i: int = 0
    while i < recs.length() {
        let rec: String = recs[i]
        let f: Array = rec.split("\t")
        if f.length() >= 11 {
            let f0: String = f[0]
            let f1: String = f[1]
            let f2: String = f[2]
            let f3: String = f[3]
            let f4: String = f[4]
            let f5: String = f[5]
            let f6: String = f[6]
            let f7: String = f[7]
            let f8: String = f[8]
            let f9: String = f[9]
            let f10: String = f[10]
            s_push_row(f0, float_to_int(string_to_float(f1)), f2, f3, f4, f5, f6, f7, f8, f9, f10)
        }
        i = i + 1
    }
    s_finish_load()
}

// Arranque REAL de /sismos: lee el <textarea id="s-data"> que emite el
// servidor (8 campos: id, iso, lat, lon, depth, type, mag, place), deriva
// epoch y fecha/hora LOCAL él mismo, y arranca geolocalización y reloj.
#[export_name = "sismos_boot"]
fn sismos_boot() {
    let data: String = dom_get_value("#s-data")
    if data.length() == 0 { return }
    s_reset()
    let recs: Array = data.split("\n")
    var i: int = 0
    while i < recs.length() {
        let rec: String = recs[i]
        let f: Array = rec.split("\t")
        if f.length() >= 8 {
            let id: String = f[0]
            let iso: String = f[1]
            let lats: String = f[2]
            let lons: String = f[3]
            let depth: String = f[4]
            let mtype: String = f[5]
            let mag: String = f[6]
            let place: String = f[7]
            let ep: int = iso_to_epoch(iso)
            let cp: Array = civil_parts(ep).split("|")
            let cy: String = cp[0]
            let cmo: String = cp[1]
            let cd: String = cp[2]
            let ch: String = cp[3]
            let cmi: String = cp[4]
            let dia: String = cy + "-" + pad2(float_to_int(string_to_float(cmo))) + "-" + pad2(float_to_int(string_to_float(cd)))
            let hora: String = ch + ":" + cmi
            s_push_row(id, ep, iso, lats, lons, depth, mtype, mag, place, dia, hora)
        }
        i = i + 1
    }
    s_finish_load()
    // "Actualizado HH:MM" (hora local) desde el epoch de la última descarga
    let ue: String = dom_get_value("#s-upd-epoch")
    if ue.length() > 0 {
        let up: Array = civil_parts(float_to_int(string_to_float(ue))).split("|")
        let uh: String = up[3]
        let um: String = up[4]
        dom_set_text("#s-updated", "Actualizado " + uh + ":" + um)
    }
    // Geolocalización: la guardada primero, luego la fresca + refresco cada 2 min
    let ula: String = js_ls_get("ulat")
    let ulo: String = js_ls_get("ulon")
    if ula.length() > 0 and ulo.length() > 0 {
        dom_set_text("#geo-status", "Ubicacion guardada")
        s_set_loc_internal(ula, ulo)
    }
    js_geo("sismos_geo_ok", "")
    js_interval(120000, "sismos_geo_tick")
}

#[export_name = "sismos_geo_tick"]
fn sismos_geo_tick() {
    js_geo("sismos_geo_ok", "")
}

#[export_name = "sismos_geo_ok"]
fn sismos_geo_ok(lat: String, lon: String) {
    js_ls_set("ulat", lat)
    js_ls_set("ulon", lon)
    let np: Array = civil_parts(time()).split("|")
    let nh: String = np[3]
    let nm: String = np[4]
    dom_set_text("#geo-status", "Ubicacion " + nh + ":" + nm)
    s_set_loc_internal(lat, lon)
}

// ── Rotador de titulares y expand de noticias (fase E) ──────────────────────
// El rotador marca el slide activo con la clase .on vía :nth-child; el CSS
// (.rot-live en el stage) apaga el fallback estático de :first-child. El
// expand usa js_delegate + data-idx (los clicks en <a> se ignoran en la
// pasarela, así los enlaces siguen navegando).

var rot_n: Array = [0]
var rot_i: Array = [0]
var n_open: Array = [0]

fn rot_mark(k: int, on: int) {
    js_toggle_class(".news-rot .rot-slide:nth-child(" + (k + 1).to_string() + ")", "on", on)
}

#[export_name = "rot_tick"]
fn rot_tick() {
    if rot_n[0] < 2 { return }
    rot_mark(rot_i[0], 0)
    rot_i[0] = (rot_i[0] + 1) % rot_n[0]
    rot_mark(rot_i[0], 1)
}

fn rot_boot() {
    rot_n = [0]
    rot_i = [0]
    if js_media("(prefers-reduced-motion: reduce)") == 1 {
        return // sin animación: el CSS estático deja visible el primer slide
    }
    let n: int = js_count(".news-rot .rot-slide")
    if n <= 0 { return }
    rot_n[0] = n
    js_toggle_class(".news-rot .rot-stage", "rot-live", 1)
    rot_mark(0, 1)
    if n > 1 {
        js_interval(4500, "rot_tick")
    }
}

// Despliegue/colapso del detalle de una noticia (uno a la vez)
#[export_name = "news_toggle"]
fn news_toggle() {
    let iv: String = dom_get_value("#n-sel")
    if iv.length() == 0 { return }
    let idx: int = float_to_int(string_to_float(iv))
    if idx < 1 { return }
    let cur: int = n_open[0]
    if cur > 0 {
        js_toggle_class(".news-list .news-item:nth-child(" + cur.to_string() + ")", "open", 0)
    }
    if idx == cur {
        n_open[0] = 0
        return
    }
    js_toggle_class(".news-list .news-item:nth-child(" + idx.to_string() + ")", "open", 1)
    n_open[0] = idx
}

fn news_boot() {
    n_open = [0]
    js_delegate(".news-list", ".news-item", "data-idx", "#n-sel", "news_toggle")
}

// Router de arranque: el servidor emite <input type="hidden" id="pg" value="X">
// en cada página; aquí se decide qué boots disparar (así el fetch de finanzas
// no corre en /sismos, etc.).
fn main() {
    console_log("veninfo.wasm: módulo Nyx cargado")
    // Dimensionar TODOS los holders globales aquí (gotcha: los literales
    // globales multi-elemento no se materializan; y así ningún handler
    // re-entrante pilla un holder corto aunque su boot no haya corrido).
    fxv = ["", "", "", "", "", ""]
    fxc = ["", "", ""]
    wc = ["10.4806", "-66.9036", "Caracas"]
    cr_name = []
    cr_lat = []
    cr_lon = []
    cr_sub = []
    let pg: String = dom_get_value("#pg")
    if pg == "index" {
        fx_boot(0)
        wcard_boot()
        rot_boot()
    }
    if pg == "finanzas" {
        fx_boot(1)
        news_boot() // lista de comunicados BVC (mismo markup expandible)
    }
    if pg == "clima" {
        clima_boot()
    }
    if pg == "sismos" {
        sismos_boot()
    }
    if pg == "noticias" {
        news_boot()
    }
}
