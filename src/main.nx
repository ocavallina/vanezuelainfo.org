// Hilo en segundo plano: pre-calienta al arrancar y refresca, para que el
// contenido este siempre fresco aunque no haya trafico. Los SISMOS se refrescan
// cada 10 min (mas sensibles al tiempo); noticias/tasas + limpieza cada ~30 min
// (la cadencia del histórico de tasas está calibrada a 30 min, no acelerarla).
fn refresher_worker() -> int {
    news_warm()
    sismos_warm()
    rates_snapshot()
    var go: bool = true
    var tick: int = 0
    while go {
        sleep(600000)
        sismos_warm()
        tick = tick + 1
        if tick >= 3 {
            tick = 0
            news_warm()
            rates_snapshot()
            // Retención de visitas (~30 días) en nyx-db.
            sql_exec("DELETE FROM visits WHERE day < " + int_to_string(db_day() - 30))
        }
    }
    return 0
}

fn main() {
    let port_str: String = getenv("PORT")
    var port: int = 3010
    if port_str != "" {
        port = string_to_int(port_str)
    }

    sismos_init()
    funvisis_init()
    news_init()
    admin_init()
    ws_init()
    sqldb_init()
    thread_spawn(refresher_worker)

    let app: App = app_new()
    setup_routes(app)
    serve_ws(chat_ws_handler)
    serve_app(app, port, 16)
}

// Registro de rutas (extraído de main() para mantenerla legible).
fn setup_routes(app: App) {
    app_use(app, visit_middleware) // contador+log global (corre antes de las rutas)
    app_get(app, "/", handle_index)
    app_get(app, "/clima", handle_clima)
    app_get(app, "/finanzas", handle_finanzas)
    app_get(app, "/calculadora", handle_calculadora)
    app_get(app, "/noticias", handle_noticias)
    app_get(app, "/chat", handle_chat)
    app_get(app, "/api/rooms", handle_chat_rooms)
    app_get(app, "/api/chat", handle_chat_list)
    app_get(app, "/api/chat/{room}", handle_chat_room)
    app_post(app, "/api/chat/send", handle_chat_send)
    app_get(app, "/baquiano", handle_baquiano)
    app_get(app, "/api/rates", handle_rates)
    app_get(app, "/baquiano/{zona}", handle_baquiano_zone)
    app_get(app, "/admin", handle_admin)
    app_post(app, "/admin/login", handle_admin_login)
    app_post(app, "/admin/logout", handle_admin_logout)
    app_get(app, "/admin/baquiano", handle_admin_baquiano)
    app_post(app, "/admin/baquiano", handle_admin_baquiano_post)
    app_get(app, "/admin/salas", handle_admin_salas)
    app_post(app, "/admin/salas", handle_admin_salas_post)
    app_get(app, "/admin/visitas", handle_admin_visitas)
    app_post(app, "/admin/visitas", handle_admin_visitas_post)
    app_get(app, "/admin/noticias", handle_admin_noticias)
    app_post(app, "/admin/noticias", handle_admin_noticias_post)
    app_get(app, "/sismos", handle_sismos)
    app_get(app, "/sismos/{id}", handle_quake_detail)
    app_get(app, "/articulo/{slug}", handle_article)
    app_get(app, "/api/health", handle_health)
    app_get(app, "/manifest.webmanifest", handle_manifest)
    app_get(app, "/manifest-calc.webmanifest", handle_manifest_calc)
    app_get(app, "/sw.js", handle_sw)
    app_get(app, "/icon.svg", handle_icon_svg)
    app_get(app, "/icon-calc.svg", handle_icon_calc_svg)
    app_get(app, "/icon-calc-192.png", handle_icon_calc_192)
    app_get(app, "/icon-calc-512.png", handle_icon_calc_512)
    app_get(app, "/icon-192.png", handle_icon_192)
    app_get(app, "/icon-512.png", handle_icon_512)
    app_static(app, "/assets/", "static/assets/")
}
