// src/main.nx — venezuelainfo.org: portal de noticias e informacion sobre
// Venezuela, con seccion de sismos (datos del EMSC), PWA y pagina de detalle
// por evento con mapa. Construido sobre nyx-serve. Entry point (ver nyx.toml).

import "std/web"
import "std/http"
import "nyx-serve/src/server"
import "nyx-serve/src/files"
import "src/md"
import "src/layout"
import "src/articles"
import "src/sismos"
import "src/news"
import "src/funvisis"
import "src/chat"
import "src/ws"
import "src/baquiano"
import "src/admin"
import "src/rates"
import "src/sqldb"
import "src/bcv"

// Escapa un valor para un atributo HTML entre comillas dobles.
fn aesc(s: String) -> String {
    return html_escape(s).replace("\"", "&quot;")
}

// Respuesta HTML sin cachear (para que el gateway no sirva paginas viejas; los
// assets/iconos si se cachean).
fn html_nocache(status: int, html: String) -> Response {
    let h: Array = ["Content-Type", "text/html; charset=utf-8", "Cache-Control", "no-cache", "Content-Security-Policy", "upgrade-insecure-requests"]
    return Response { status: status, headers_flat: h, body: html }
}

// Respuesta JSON sin cachear (para los endpoints del chat).
fn json_nocache(status: int, json: String) -> Response {
    let h: Array = ["Content-Type", "application/json; charset=utf-8", "Cache-Control", "no-cache"]
    return Response { status: status, headers_flat: h, body: json }
}

// Tarjeta del clima (resumen) — enlaza a /clima. La pinta veninfo.wasm (wcard_boot).
fn weather_card() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a href=\"/clima\" class=\"weather weather-card\">\n")
    sb.append("<div class=\"weather-head\"><h2>Clima</h2><span id=\"w-city-name\" class=\"w-city-name\"></span></div>\n")
    sb.append("<div id=\"w-body\" class=\"weather-body\">Cargando clima&hellip;</div>\n")
    sb.append("<div class=\"weather-more\">Ver pronostico completo &rarr;</div>\n")
    sb.append("</a>\n")
    return sb.to_string()
}

// Tarjeta de finanzas (resumen) — enlaza a /finanzas. La pinta veninfo.wasm
// (fx_boot: fetch + parseo + render, todo en Nyx en el navegador).
fn finanzas_card() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a href=\"/finanzas\" class=\"finanzas finanzas-card\">\n")
    sb.append("<div class=\"fin-head\"><h2>Finanzas</h2><span class=\"fin-tag\">BCV &middot; Binance &middot; Euro</span></div>\n")
    sb.append("<div id=\"fin-body\" class=\"fin-body\">Cargando&hellip;</div>\n")
    sb.append("<div class=\"weather-more\">Ver finanzas completas &rarr;</div>\n")
    sb.append("</a>\n")
    return sb.to_string()
}

// Landing /finanzas — calculadora, divisas (USD/EUR), cripto (USD) y Bolsa de Caracas.
fn handle_finanzas(req: Request) -> Response {
    let ibc: String = bvc_ibc_text()
    let bvc: String = bvc_list_html()
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"finz\">\n")
    sb.append("<p><a href=\"/\">&larr; Volver al inicio</a></p>\n")
    sb.append("<h1>Finanzas</h1>\n")
    sb.append("<p class=\"lede\">Tipos de cambio, cripto e informacion de la Bolsa de Valores de Caracas.</p>\n")
    sb.append("<a href=\"/calculadora\" class=\"finz-calc-link\">")
    sb.append("<span class=\"finz-calc-ico\">&#128200;</span>")
    sb.append("<span class=\"finz-calc-txt\"><strong>Calculadora de cambio</strong><span>Bol&iacute;vares &middot; D&oacute;lar BCV &middot; Euro BCV &middot; D&oacute;lar Binance</span></span>")
    sb.append("<span class=\"finz-calc-arrow\">&rarr;</span>")
    sb.append("</a>\n")
    sb.append("<h2 class=\"finz-h\">Divisas</h2>\n")
    sb.append("<div id=\"fz-div\" class=\"finz-grid\">Cargando&hellip;</div>\n")
    sb.append("<h2 class=\"finz-h\">Hist&oacute;rico</h2>\n")
    sb.append(rates_history_html())
    sb.append("<h2 class=\"finz-h\">Cripto (USD)</h2>\n")
    sb.append("<div id=\"fz-cripto\" class=\"finz-grid\">Cargando&hellip;</div>\n")
    sb.append("<h2 class=\"finz-h\">Bolsa de Valores de Caracas</h2>\n")
    if ibc.length() > 0 {
        sb.append("<div class=\"finz-ibc\">")
        sb.append(html_escape(ibc))
        sb.append("</div>\n")
    }
    sb.append("<div class=\"news-list\">")
    sb.append(bvc)
    sb.append("</div>\n")
    sb.append("<p class=\"news-fuentes\">Divisas: DolarAPI &middot; USDT P2P: CriptoYa (Binance) &middot; USD/COP: open.er-api.com &middot; Cripto: CoinGecko &middot; Bolsa: bolsadecaracas.com</p>\n")
    sb.append("</section>\n")
    sb.append("<input type=\"hidden\" id=\"n-sel\">\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"finanzas\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    return html_nocache(200, page_fixed("Finanzas", sb.to_string()))
}

// Pagina propia de la calculadora de cambio (acceso desde /finanzas).
fn handle_calculadora(req: Request) -> Response {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"finz\">\n")
    sb.append("<p><a href=\"/finanzas\">&larr; Volver a Finanzas</a></p>\n")
    sb.append("<h1>Calculadora de cambio</h1>\n")
    sb.append("<p class=\"lede\">Convierte entre Bol&iacute;vares y D&oacute;lar BCV, Euro BCV o D&oacute;lar Binance con las tasas del d&iacute;a.</p>\n")
    sb.append("<button id=\"calc-install-link\" class=\"calc-install-link\" type=\"button\" hidden>&#128241; Instalar como app</button>\n")
    sb.append("<section class=\"fz-calc\">\n")
    sb.append("<div class=\"calc-head\">")
    sb.append("<h2 class=\"finz-h\">Calculadora</h2>")
    sb.append("<div class=\"calc-actions\">")
    sb.append("<button id=\"calc-copy\" class=\"calc-copy\" type=\"button\" aria-label=\"Copiar el resultado\">Copiar</button>")
    sb.append("<button id=\"calc-share\" class=\"calc-share\" type=\"button\" aria-label=\"Compartir esta conversion\">Compartir</button>")
    sb.append("</div>")
    sb.append("</div>\n")
    sb.append("<div class=\"calc-sels\">")
    sb.append("<select id=\"calc-rate-sel\" class=\"calc-rate-sel\" aria-label=\"Tasa de cambio\">")
    sb.append("<option value=\"bcv\" selected>D&oacute;lar BCV</option>")
    sb.append("<option value=\"eur\">Euro BCV</option>")
    sb.append("<option value=\"bin\">D&oacute;lar Binance</option>")
    sb.append("</select>")
    // Toggle Hoy/Mañana (oculto; el wasm lo muestra si hay tasa BCV de mañana publicada).
    sb.append("<span id=\"calc-day-wrap\" class=\"calc-day-wrap\" hidden><select id=\"calc-day\" class=\"calc-rate-sel\" aria-label=\"D&iacute;a de la tasa\"><option value=\"hoy\" selected>Hoy</option><option value=\"man\">Ma&ntilde;ana</option></select></span>")
    sb.append("</div>\n")
    sb.append("<div class=\"calc-panel\">")
    sb.append("<input id=\"calc-amt\" class=\"calc-amt\" type=\"number\" step=\"any\" min=\"0\" inputmode=\"decimal\" value=\"1\" aria-label=\"Monto\">")
    sb.append("<button id=\"mc-toggle\" class=\"mc-toggle\" type=\"button\" aria-label=\"Mini calculadora\" title=\"Calculadora\">&#129518;</button>")
    sb.append("<span id=\"calc-from-unit\" class=\"calc-unit\">$</span>")
    sb.append("</div>\n")
    sb.append("<div id=\"mc-panel\" class=\"mc-panel\">")
    sb.append("<div class=\"mc-row\"><input id=\"mc-expr\" class=\"mc-expr\" type=\"text\" inputmode=\"decimal\" autocomplete=\"off\" placeholder=\"ej. 12*3+5\" aria-label=\"Operaci&oacute;n\"><button id=\"mc-eq\" class=\"mc-eq\" type=\"button\" onmousedown=\"event.preventDefault()\">=</button></div>")
    sb.append("<div id=\"mc-ops\" class=\"mc-ops\" onmousedown=\"event.preventDefault()\">")
    sb.append("<button type=\"button\" data-op=\"+\">+</button>")
    sb.append("<button type=\"button\" data-op=\"-\">&minus;</button>")
    sb.append("<button type=\"button\" data-op=\"*\">&times;</button>")
    sb.append("<button type=\"button\" data-op=\"/\">&divide;</button>")
    sb.append("<button type=\"button\" data-op=\"(\">(</button>")
    sb.append("<button type=\"button\" data-op=\")\">)</button>")
    sb.append("<button type=\"button\" data-op=\"del\" aria-label=\"Borrar\">&#9003;</button>")
    sb.append("<button type=\"button\" data-op=\"clr\">C</button>")
    sb.append("</div>")
    sb.append("<div id=\"mc-out\" class=\"mc-out\"></div>")
    sb.append("</div>\n")
    sb.append("<input type=\"hidden\" id=\"mc-opkey\">\n")
    sb.append("<div class=\"calc-swap-wrap\"><button id=\"calc-swap\" class=\"calc-swap\" type=\"button\" aria-label=\"Invertir el sentido\" title=\"Invertir (Bs &harr; divisa)\">&#8645;</button></div>\n")
    sb.append("<div class=\"calc-panel\">")
    sb.append("<div id=\"calc-result\" class=\"calc-result\"><span class=\"calc-wait\">Esperando tasas&hellip;</span></div>")
    sb.append("<span id=\"calc-to-unit\" class=\"calc-unit\">Bs</span>")
    sb.append("</div>\n")
    sb.append("<div id=\"calc-rate\" class=\"calc-rate\"></div>\n")
    sb.append("</section>\n")
    sb.append("<input type=\"hidden\" id=\"calc-dir\" value=\"d2b\">\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"calculadora\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    return html_nocache(200, page_calc("Calculadora de cambio", sb.to_string()))
}

fn rot_news_card(rot: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a href=\"/noticias\" class=\"rot-card news-rot\">\n")
    sb.append("<div class=\"rot-head\"><span class=\"rot-ico news-ico\">&#128240;</span><h2>Noticias</h2><span class=\"rot-hint\">Ver todas &rarr;</span></div>\n")
    sb.append("<div class=\"rot-stage\">")
    sb.append(rot)
    sb.append("</div>\n</a>\n")
    return sb.to_string()
}

fn rot_sismos_card(srot: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a href=\"/sismos\" class=\"rot-card sismos-card\">\n")
    sb.append("<div class=\"rot-head\"><span class=\"rot-ico alert-ico\"><svg viewBox=\"0 0 24 24\" width=\"22\" height=\"22\"><path d=\"M12 2 L23 21 H1 Z\" fill=\"#f9a825\"/><rect x=\"11\" y=\"9\" width=\"2\" height=\"6\" fill=\"#7a1010\"/><rect x=\"11\" y=\"16.5\" width=\"2\" height=\"2\" fill=\"#7a1010\"/></svg></span><h2>Sismos</h2><span class=\"rot-hint\">Ver todos &rarr;</span></div>\n")
    sb.append("<div class=\"rot-stage\">")
    sb.append(srot)
    sb.append("</div>\n</a>\n")
    return sb.to_string()
}

fn handle_index(req: Request) -> Response {
    let rot: String = news_rotator_html()

    var sb: StringBuilder = StringBuilder.new()
    sb.append("<div class=\"cards-cfg\"><button id=\"cfg-btn\" type=\"button\" class=\"cfg-btn\" title=\"Ordenar tarjetas\" aria-label=\"Ordenar tarjetas\">&#9881;</button></div>\n")
    sb.append("<div id=\"home-cards\">\n")
    sb.append("<div class=\"home-card\" data-key=\"hero\"><section class=\"hero\"><h1>Venezuela al dia</h1><p class=\"lede\">Noticias, informacion y monitoreo sismico en vivo.</p><a class=\"cta\" href=\"/sismos\">Ver sismos recientes &rarr;</a></section></div>\n")
    sb.append("<div class=\"home-card\" data-key=\"clima\">")
    sb.append(weather_card())
    sb.append("</div>\n")
    sb.append("<div class=\"home-card\" data-key=\"finanzas\">")
    sb.append(finanzas_card())
    sb.append("</div>\n")
    if rot.length() > 0 {
        sb.append("<div class=\"home-card\" data-key=\"noticias\">")
        sb.append(rot_news_card(rot))
        sb.append("</div>\n")
    }
    sb.append("<div class=\"home-card\" data-key=\"baquiano\">")
    sb.append(baquiano_card())
    sb.append("</div>\n")
    sb.append("<div class=\"home-card\" data-key=\"chat\">")
    sb.append(chat_card())
    sb.append("</div>\n")
    sb.append("</div>\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"index\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    sb.append("<script src=\"/assets/home.js?v=3\" defer></script>\n")
    return html_nocache(200, page_fixed("Inicio", sb.to_string() + render_home()))
}

