    sb.append("<p class=\"news-fuentes\">Fuentes: Efecto Cocuyo, El Pitazo, Runrun.es, Cronica Uno, El Nacional.</p>\n")
    sb.append("<input type=\"hidden\" id=\"n-sel\">\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"noticias\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    sb.append("</section>\n")
    return html_nocache(200, page_fixed("Noticias", sb.to_string()))
}

// Tarjeta de chat para la portada (enlaza a /chat).
fn chat_card() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a class=\"chat-card\" href=\"/chat\">")
    sb.append("<div class=\"chat-card-ico\">&#128172;</div>")
    sb.append("<div class=\"chat-card-txt\"><h3>Chat colectivo</h3>")
    sb.append("<p>Conversa en vivo con otras personas sobre Venezuela.</p>")
    sb.append("<span class=\"chat-card-cta\">Entrar al chat &rarr;</span></div>")
    sb.append("</a>")
    return sb.to_string()
}

// Pagina /chat — chat colectivo publico. El cliente vive en
// static/assets/chat.js: WebSocket (wss:///ws/chat/<sala>) para recibir en
// vivo, con respaldo de polling si el WS no conecta. Envio por POST.
fn handle_chat(req: Request) -> Response {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"chat\">\n")
    sb.append("<p><a href=\"/\">&larr; Volver al inicio</a></p>\n")
    sb.append("<h1>Chat colectivo</h1>\n")
    sb.append("<p class=\"lede\">Publico y moderado. Elige una sala; los mensajes los ven todos. Se respetuoso.</p>\n")
    sb.append("<div class=\"chat-rooms-bar\"><label for=\"chat-room\">Sala:</label> <select id=\"chat-room\" class=\"chat-room\"><option value=\"general\">General</option></select> <span id=\"chat-live\" class=\"chat-live\" role=\"status\"></span></div>\n")
    sb.append("<div id=\"chat-log\" class=\"chat-log\" aria-live=\"polite\"></div>\n")
    sb.append("<form id=\"chat-form\" class=\"chat-form\" autocomplete=\"off\">\n")
    sb.append("<input id=\"chat-nick\" class=\"chat-nick\" maxlength=\"24\" placeholder=\"Tu nombre (opcional)\">\n")
    sb.append("<div class=\"chat-row\">\n")
    sb.append("<textarea id=\"chat-text\" class=\"chat-text\" maxlength=\"280\" rows=\"2\" placeholder=\"Escribe un mensaje...\" required></textarea>\n")
    sb.append("<button type=\"submit\" class=\"chat-send\">Enviar</button>\n")
    sb.append("</div>\n")
    sb.append("<div class=\"chat-meta\"><span id=\"chat-count\">0/280</span> <span id=\"chat-status\" class=\"chat-status\"></span></div>\n")
    sb.append("</form>\n")
    sb.append("</section>\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"chat\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    return html_nocache(200, page_fixed("Chat", sb.to_string()))
}

// GET /api/rooms — lista de salas disponibles en JSON.
fn handle_chat_rooms(req: Request) -> Response {
    return json_nocache(200, chat_rooms_json())
}

// GET /api/chat — ultimos mensajes de la sala general (compat).
fn handle_chat_list(req: Request) -> Response {
    return json_nocache(200, chat_list_json("general"))
}

// GET /api/chat/{room} — ultimos mensajes de una sala en JSON (sin cache).
fn handle_chat_room(req: Request) -> Response {
    let room: String = req.params.get("room")
    return json_nocache(200, chat_list_json(room))
}

// POST /api/chat/send — publica un mensaje (body urlencoded: room, nick, texto).
fn handle_chat_send(req: Request) -> Response {
    let err: String = chat_send_body(req.body)
    if err.length() == 0 {
        return json_nocache(200, "{\"ok\":true}")
    }
    return json_nocache(200, "{\"ok\":false,\"error\":\"" + err + "\"}")
}

// GET /baquiano — indice de zonas de la guia.
fn handle_baquiano(req: Request) -> Response {
    return html_nocache(200, page_fixed("Baquiano", render_baquiano_index()))
}

// GET /api/rates — tasas para el front (BCV hoy + próxima con fecha valor, + Binance).
fn handle_rates(req: Request) -> Response {
    let h: Array = ["Content-Type", "application/json; charset=utf-8", "Cache-Control", "no-cache"]
    return Response { status: 200, headers_flat: h, body: rates_api_json() }
}

// GET /baquiano/{zona} — sitios de una zona.
fn handle_baquiano_zone(req: Request) -> Response {
    let zona: String = req.params.get("zona")
    let content: String = render_baquiano_zone(zona)
    if content.length() == 0 {
        let nf: String = "<section class=\"baquiano\"><p><a href=\"/baquiano\">&larr; Todas las zonas</a></p><h1>Zona no encontrada</h1></section>"
        return html_nocache(404, page_fixed("Baquiano", nf))
    }
    return html_nocache(200, page_fixed("Baquiano", content))
}

// Landing /clima — pronostico completo de cualquier ciudad (buscador) o por
// geolocalizacion. Todo client-side con Open-Meteo (forecast + air-quality +
// geocoding). La ciudad se guarda en localStorage (compartida con la tarjeta).
fn handle_clima(req: Request) -> Response {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"clima\">\n")
    sb.append("<p><a href=\"/\">&larr; Volver al inicio</a></p>\n")
    sb.append("<h1>Clima</h1>\n")
    sb.append("<p class=\"lede\">Busca cualquier ciudad o usa tu ubicacion. Datos de Open-Meteo.</p>\n")
    sb.append("<div class=\"clima-buscar\">\n")
    sb.append("  <input id=\"c-q\" type=\"text\" placeholder=\"Buscar ciudad...\" autocomplete=\"off\">\n")
    sb.append("  <button id=\"c-buscar\" type=\"button\" class=\"geo-btn\">Buscar</button>\n")
    sb.append("  <button id=\"c-geo\" type=\"button\" class=\"geo-btn\">Mi ubicacion</button>\n")
    sb.append("</div>\n")
    sb.append("<div id=\"c-results\" class=\"clima-results\"></div>\n")
    sb.append("<h2 id=\"c-title\" class=\"clima-title\"></h2>\n")
    sb.append("<div id=\"c-actual\" class=\"clima-actual\">Cargando&hellip;</div>\n")
    sb.append("<h3 class=\"clima-h3\">Proximas horas</h3>\n")
    sb.append("<div id=\"c-horas\" class=\"clima-horas\"></div>\n")
    sb.append("<h3 class=\"clima-h3\">Proximos dias</h3>\n")
    sb.append("<div id=\"c-dias\" class=\"clima-dias\"></div>\n")
    sb.append("<h3 class=\"clima-h3\">Calidad del aire</h3>\n")
    sb.append("<div id=\"c-aire\" class=\"clima-aire\"></div>\n")
    sb.append("</section>\n")
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"clima\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    return html_nocache(200, page_fixed("Clima", sb.to_string()))
}

fn handle_article(req: Request) -> Response {
    let slug: String = req.params.get("slug")
    let content: String = render_article(slug)
    if content.length() == 0 {
        let nf: String = "<section class=\"notfound\"><h1>Articulo no encontrado</h1><p><a href=\"/\">Volver al inicio</a></p></section>"
        return html_nocache(404, page("No encontrado", nf))
    }
    return html_nocache(200, page("Articulo", content))
}

// Pagina de LISTA de sismos: encabezado con conteo + ultima actualizacion,
// lista paginada, filtros abajo, detalle desplegable al seleccionar (con boton
// a la pagina de detalle con mapa). Sin mapa en esta pagina (evita el secuestro
// de scroll); el mapa vive en /sismos/{id}.
fn handle_sismos(req: Request) -> Response {
    let lista: String = sismos_section()
    let ts_str: String = int_to_string(sismos_ts())
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"sismos\">\n")
    sb.append("<h1>Sismos recientes en Venezuela</h1>\n")
    sb.append("<p class=\"lede\">Sismos recientes en Venezuela y su zona fronteriza (magnitud &ge; 2). Fuentes: <a href=\"http://www.funvisis.gob.ve\">FUNVISIS</a> (red nacional) y <a href=\"https://www.emsc-csem.org\">EMSC</a>.</p>\n")
    sb.append("<p class=\"hint\">Nota: combinamos FUNVISIS (autoridad sismica nacional, cubre los locales pequenos) con EMSC (aporta los eventos fronterizos y costa afuera: Colombia, Golfo de Paria, Trinidad, mar Caribe). Las horas se muestran en tu hora local.</p>\n")
    sb.append("<div class=\"sismos-top\"><span id=\"s-count\" class=\"s-count\">&mdash; sismos</span>")
    sb.append("<span id=\"s-updated\" class=\"s-updated\" data-updated=\"")
    sb.append(ts_str)
    sb.append("\"></span>")
    sb.append("<button id=\"filtros-btn\" class=\"filtros-btn\" type=\"button\" aria-expanded=\"false\" title=\"Filtros\"><svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"currentColor\"><path d=\"M3 5h18l-7 8v6l-4-2v-4z\"></path></svg> Filtros</button>")
    sb.append("</div>\n")
    sb.append("<a id=\"sismo-destacado\" class=\"destacado\" hidden></a>\n")
    sb.append("<div class=\"tabla-scroll\">")
    sb.append(lista)
    sb.append("</div>\n")
    sb.append("<div class=\"pager\"><button id=\"p-prev\" type=\"button\" class=\"pg-btn\">&laquo; Anteriores</button><span id=\"p-info\" class=\"p-info\"></span><button id=\"p-next\" type=\"button\" class=\"pg-btn\">Siguientes &raquo;</button></div>\n")
    // Filtros (ocultos tras el icono de filtros)
    sb.append("<div id=\"filtros\" class=\"filtros\" hidden>\n")
    sb.append("  <label>Orden: <select id=\"f-orden\">")
    sb.append("<option value=\"fecha\">Fecha (recientes)</option><option value=\"distancia\">Distancia (cercanos)</option><option value=\"magnitud\">Magnitud (mayores)</option>")
    sb.append("</select></label>\n")
    sb.append("  <label>Magnitud min: <select id=\"f-mag\">")
    sb.append("<option value=\"0\">Todas</option><option value=\"3.5\" selected>3.5+</option><option value=\"4\">4.0+</option><option value=\"4.5\">4.5+</option><option value=\"5\">5.0+</option><option value=\"6\">6.0+</option>")
    sb.append("</select></label>\n")
    sb.append("  <label>Distancia max: <input id=\"f-dist\" type=\"range\" min=\"50\" max=\"2000\" step=\"50\" value=\"2000\" disabled> <span id=\"f-dist-val\" class=\"f-dist-val\">activa tu ubicacion</span></label>\n")
    sb.append("  <label>Lugar: <input id=\"f-text\" type=\"text\" placeholder=\"ej. Zulia\"></label>\n")
    sb.append("  <span id=\"geo-status\" class=\"geo-status\"></span>\n")
    sb.append("</div>\n")
    sb.append("<input type=\"hidden\" id=\"s-selected\">\n")
    sb.append("<input type=\"hidden\" id=\"s-upd-epoch\" value=\"")
    sb.append(ts_str)
    sb.append("\">\n")
    sb.append(sismos_data_block())
    sb.append("<input type=\"hidden\" id=\"pg\" value=\"sismos\">\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    sb.append("</section>\n")
    return html_nocache(200, page_fixed("Sismos", sb.to_string()))
}

// Pagina de DETALLE de un sismo: mapa grande (gesture-handling para no
// secuestrar el scroll), info completa y distancia si llegan coords del usuario.
fn handle_quake_detail(req: Request) -> Response {
    let id: String = req.params.get("id")
    let q: Array = quake_by_id(id)
    if q.length() == 0 {
        let nf: String = "<section class=\"sismos\"><p><a href=\"/sismos\">&larr; Volver a la lista</a></p><h1>Sismo no encontrado</h1><p>Este evento puede haber salido del listado reciente.</p></section>"
        return html_nocache(404, page("Sismo no encontrado", nf))
    }
    // q = [id, time, lat, lon, depth, mtype, mag, place]
    let qtime: String = q[1]
    let lat: String = q[2]
    let lon: String = q[3]
    let depth: String = q[4]
    let mtype: String = q[5]
    let mag: String = q[6]
    let place: String = q[7]

    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"sismo-detail\">\n")
    sb.append("<p><a href=\"/sismos\">&larr; Volver a la lista</a></p>\n")
    sb.append("<h1>Sismo M")
    sb.append(html_escape(mag))
    sb.append(" ")
    sb.append(html_escape(mtype))
    sb.append("</h1>\n<p class=\"lede\">")
    sb.append(html_escape(place))
    sb.append("</p>\n")
    sb.append("<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.css\">\n")
    sb.append("<link rel=\"stylesheet\" href=\"https://unpkg.com/leaflet-gesture-handling/dist/leaflet-gesture-handling.min.css\">\n")
    sb.append("<div id=\"qmap\" class=\"qmap\" data-lat=\"")
    sb.append(aesc(lat))
    sb.append("\" data-lon=\"")
    sb.append(aesc(lon))
    sb.append("\" data-mag=\"")
    sb.append(aesc(mag))
    sb.append("\" data-type=\"")
    sb.append(aesc(mtype))
    sb.append("\" data-place=\"")
    sb.append(aesc(place))
    sb.append("\" data-iso=\"")
    sb.append(aesc(qtime))
    sb.append("\"></div>\n")
    sb.append("<div class=\"detail-info\">\n")
    sb.append("<div><span>Magnitud</span><strong>M ")
    sb.append(html_escape(mag))
    sb.append(" ")
    sb.append(html_escape(mtype))
    sb.append("</strong></div>\n")
    sb.append("<div><span>Fecha</span><strong id=\"q-fecha\">")
    sb.append(html_escape(format_time(qtime)))
    sb.append("</strong></div>\n")
    sb.append("<div><span>Profundidad</span><strong>")
    sb.append(html_escape(depth))
    sb.append(" km</strong></div>\n")
    sb.append("<div><span>Coordenadas</span><strong>")
    sb.append(html_escape(lat))
    sb.append(", ")
    sb.append(html_escape(lon))
    sb.append("</strong></div>\n")
    sb.append("<div><span>Distancia desde ti</span><strong id=\"q-dist\">&mdash;</strong></div>\n")
    sb.append("</div>\n")
    sb.append("<script src=\"https://unpkg.com/leaflet@1.9.4/dist/leaflet.js\"></script>\n")
    sb.append("<script src=\"https://unpkg.com/leaflet-gesture-handling/dist/leaflet-gesture-handling.min.js\"></script>\n")
    sb.append("<script type=\"module\" src=\"/assets/nyx-loader.js?v=18\"></script>\n")
    sb.append("<script src=\"/assets/quake.js?v=2\" defer></script>\n")
    sb.append("</section>\n")
    return html_nocache(200, page_fixed("Sismo M" + mag, sb.to_string()))
}

fn handle_health(req: Request) -> Response {
    return response_json(200, "{\"status\":\"ok\",\"ws\":" + int_to_string(ws_count()) + "}")
}

// ---- PWA / iconos (servidos en la raiz con su content-type) ----
fn handle_manifest(req: Request) -> Response {
    let h: Array = ["Content-Type", "application/manifest+json; charset=utf-8"]
    return Response { status: 200, headers_flat: h, body: read_file("static/manifest.webmanifest") }
}

