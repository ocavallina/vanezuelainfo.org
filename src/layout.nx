// src/layout.nx — Plantilla HTML compartida (header, footer, wrapper).
// Tema visual con los colores de la bandera de Venezuela.

fn page_v(title: String, content: String, viewport: String, manifest: String, app_title: String, full_chrome: int) -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<!DOCTYPE html>\n<html lang=\"es\">\n<head>\n")
    sb.append("<meta charset=\"utf-8\">\n")
    sb.append("<meta name=\"viewport\" content=\"")
    sb.append(viewport)
    sb.append("\">\n")
    sb.append("<title>")
    sb.append(title)
    sb.append(" — VenezuelaInfo</title>\n")
    sb.append("<meta name=\"description\" content=\"Noticias, informacion y monitoreo sismico de Venezuela.\">\n")
    sb.append("<link rel=\"stylesheet\" href=\"/assets/style.css?v=66\">\n")
    // Iconos + PWA
    sb.append("<link rel=\"icon\" href=\"/icon.svg\" type=\"image/svg+xml\">\n")
    sb.append("<link rel=\"icon\" href=\"/icon-192.png\" type=\"image/png\" sizes=\"192x192\">\n")
    sb.append("<link rel=\"apple-touch-icon\" href=\"/icon-192.png\">\n")
    sb.append("<link rel=\"manifest\" href=\"")
    sb.append(manifest)
    sb.append("\">\n")
    sb.append("<meta name=\"theme-color\" content=\"#00247D\">\n")
    sb.append("<meta name=\"color-scheme\" content=\"light dark\">\n")
    sb.append("<meta name=\"apple-mobile-web-app-capable\" content=\"yes\">\n")
    sb.append("<meta name=\"apple-mobile-web-app-status-bar-style\" content=\"black-translucent\">\n")
    sb.append("<meta name=\"apple-mobile-web-app-title\" content=\"")
    sb.append(app_title)
    sb.append("\">\n")
    sb.append("</head>\n<body>\n")

    sb.append("<header class=\"site-header\">\n")
    sb.append("<div class=\"flag-stripe\"></div>\n")
    sb.append("<div class=\"header-inner\">\n")
    sb.append("<a class=\"brand\" href=\"/\">Venezuela<span>Info</span></a>\n")
    // Sin barra de navegación: se navega por las tarjetas de la portada (el logo
    // vuelve al inicio; cada página tiene su enlace "Volver al inicio"). En el
    // header solo quedan las acciones (Compartir + Instalar); en full_chrome=0
    // (Calculadora app aparte) ni eso.
    if full_chrome == 1 {
        sb.append("<div class=\"header-actions\">\n")
        sb.append("<button id=\"pwa-share\" class=\"pwa-share\" type=\"button\" aria-label=\"Compartir VenezuelaInfo\">Compartir</button>\n")
        sb.append("<button id=\"pwa-install\" class=\"pwa-install js-pwa-install\" type=\"button\" hidden>Instalar app</button>\n")
        sb.append("</div>\n")
    }
    sb.append("</div>\n</header>\n")

    sb.append("<main class=\"container\">\n")
    sb.append(content)
    sb.append("</main>\n")

    // full_chrome=0 (Calculadora app aparte): sin footer.
    if full_chrome == 1 {
        sb.append("<footer class=\"site-footer\">\n")
        // Avisos push (global): revelado por JS solo si el navegador los soporta. El
        // selector de temas va en un desplegable para no recargar el pie. Ver JS abajo.
        sb.append("<div id=\"push-box\" class=\"push-foot\" hidden>\n")
        sb.append("<span class=\"push-foot-lbl\">&#128276; Avisos:</span>\n")
        sb.append("<button id=\"push-btn\" class=\"push-btn\" type=\"button\">Activar</button>\n")
        sb.append("<button id=\"push-topics-btn\" class=\"push-topics-btn\" type=\"button\" aria-expanded=\"false\">temas &#9662;</button>\n")
        sb.append("<span id=\"push-status\" class=\"push-status\"></span>\n")
        sb.append("<div id=\"push-topics\" class=\"push-topics\" hidden>\n")
        sb.append("<label><input type=\"checkbox\" id=\"push-t-sismos\" checked> Sismos</label>\n")
        sb.append("<label><input type=\"checkbox\" id=\"push-t-tasas\" checked> Tasas BCV</label>\n")
        sb.append("<label><input type=\"checkbox\" id=\"push-t-chat\"> Chat</label>\n")
        sb.append("</div>\n")
        sb.append("</div>\n")
        sb.append("<p>venezuelainfo.org — Hecho con <a href=\"https://nyxlang.com\">Nyx</a>. ")
        sb.append("Datos sismicos: <a href=\"https://www.emsc-csem.org\">EMSC</a>. ")
        sb.append("Mapa: <a href=\"https://www.openstreetmap.org/copyright\">OpenStreetMap</a>. ")
        sb.append("Codigo: <a href=\"https://github.com/ocavallina/vanezuelainfo.org\">GitHub</a>.</p>\n")
        sb.append("</footer>\n")
    }
    // Registro del service worker (PWA)
    sb.append("<script>\n")
    sb.append("if('serviceWorker' in navigator){\n")
    sb.append("  window.addEventListener('load',function(){navigator.serviceWorker.register('/sw.js').catch(function(){});});\n")
    sb.append("}\n")
    // Cookie de visitante (para contar únicos server-side; el server solo la lee).
    sb.append("if(!/(?:^|; )vv=/.test(document.cookie)){document.cookie='vv=1; path=/; max-age=31536000; samesite=lax';}\n")
    if full_chrome == 1 {
        // Sitio: botón(es) de instalar del header (.js-pwa-install).
        sb.append("(function(){var dfp=null,btns=document.querySelectorAll('.js-pwa-install');\n")
        sb.append("function show(h){for(var i=0;i<btns.length;i++)btns[i].hidden=h;}\n")
        sb.append("window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();dfp=e;show(false);});\n")
        sb.append("for(var i=0;i<btns.length;i++)btns[i].addEventListener('click',function(){if(!dfp)return;dfp.prompt();dfp.userChoice.then(function(){dfp=null;show(true);});});\n")
        sb.append("window.addEventListener('appinstalled',function(){show(true);});\n")
        // iOS Safari NO emite beforeinstallprompt: revelamos el mismo botón y, al
        // tocarlo, mostramos las instrucciones "Compartir → Añadir a inicio".
        // Solo Safari (no CriOS/FxiOS/webviews, donde no crea app standalone).
        sb.append("var ua=navigator.userAgent||'';\n")
        sb.append("var iOS=/iphone|ipad|ipod/i.test(ua);\n")
        sb.append("var safari=iOS&&/Safari/.test(ua)&&!/(CriOS|FxiOS|EdgiOS|OPiOS|Mercury|FBAN|FBAV|Instagram|Line|GSA)/.test(ua);\n")
        sb.append("var sa=(navigator.standalone===true)||(window.matchMedia&&matchMedia('(display-mode: standalone)').matches);\n")
        sb.append("if(safari&&!sa){show(false);\n")
        sb.append("  var hint=null;\n")
        sb.append("  function iosHint(){\n")
        sb.append("    if(hint){hint.remove();hint=null;return;}\n")
        sb.append("    hint=document.createElement('div');hint.className='calc-ios-hint';\n")
        sb.append("    hint.innerHTML='<span>Para instalar: toca <strong>Compartir</strong> (el icono con la flecha) y elige <strong>\\u00abA\\u00f1adir a inicio\\u00bb</strong>.</span><button type=\"button\" aria-label=\"Cerrar\">\\u00d7</button>';\n")
        sb.append("    hint.querySelector('button').addEventListener('click',function(){hint.remove();hint=null;});\n")
        sb.append("    var m=document.querySelector('main.container')||document.body;m.insertBefore(hint,m.firstChild);\n")
        sb.append("    hint.scrollIntoView({block:'nearest'});\n")
        sb.append("  }\n")
        sb.append("  for(var j=0;j<btns.length;j++)btns[j].addEventListener('click',iosHint);\n")
        sb.append("}\n")
        sb.append("})();\n")
    } else {
        // Calculadora (app aparte): enlace discreto "Instalar como app". Se muestra en
        // navegadores que pueden instalar PWA (no iOS, no ya instalada); al tocarlo
        // dispara el diálogo (fiable: es un gesto del usuario). iOS lo cubre el hint.
        sb.append("(function(){var lnk=document.getElementById('calc-install-link');if(!lnk)return;\n")
        sb.append("var ua=navigator.userAgent||'',iOS=/iphone|ipad|ipod/i.test(ua);\n")
        sb.append("var sa=(navigator.standalone===true)||(window.matchMedia&&matchMedia('(display-mode: standalone)').matches);\n")
        sb.append("if(iOS||sa){lnk.remove();return;}\n")
        sb.append("lnk.hidden=false;var dfp=null;\n")
        sb.append("window.addEventListener('beforeinstallprompt',function(e){e.preventDefault();dfp=e;});\n")
        sb.append("lnk.addEventListener('click',function(){if(dfp){var p=dfp;dfp=null;p.prompt();p.userChoice.then(function(){});return;}\n")
        sb.append("alert('Para instalar: abre el men\\u00fa del navegador (\\u22ee) y elige \"Instalar aplicaci\\u00f3n\" o \"Agregar a pantalla principal\".');});\n")
        sb.append("window.addEventListener('appinstalled',function(){lnk.remove();});})();\n")
        // iOS Safari no emite beforeinstallprompt → hint dismissable "Compartir →
        // Añadir a inicio" (solo iOS, no instalada, una vez; recuerda el descarte).
        sb.append("(function(){var ua=navigator.userAgent||'';\n")
        sb.append("var iOS=/iphone|ipad|ipod/i.test(ua);\n")
        sb.append("var sa=(navigator.standalone===true)||(window.matchMedia&&matchMedia('(display-mode: standalone)').matches);\n")
        sb.append("var K='calc_ios_hint',d=false;try{d=localStorage.getItem(K)==='1';}catch(e){}\n")
        sb.append("if(!iOS||sa||d)return;\n")
        sb.append("var b=document.createElement('div');b.className='calc-ios-hint';\n")
        sb.append("b.innerHTML='<span>Para instalar la calculadora: toca <strong>Compartir</strong> y luego <strong>\\u00abA\\u00f1adir a inicio\\u00bb</strong>.</span><button type=\"button\" aria-label=\"Cerrar\">\\u00d7</button>';\n")
        sb.append("b.querySelector('button').addEventListener('click',function(){b.remove();try{localStorage.setItem(K,'1');}catch(e){}});\n")
        sb.append("var m=document.querySelector('main.container')||document.body;m.insertBefore(b,m.firstChild);})();\n")
    }
    // Compartir la app: Web Share API (movil) con respaldo a copiar el enlace.
    sb.append("(function(){var sh=document.getElementById('pwa-share');if(!sh)return;\n")
    sb.append("var U=location.origin+'/',D={title:'VenezuelaInfo',text:'Noticias, clima, finanzas y sismos de Venezuela en vivo',url:U};\n")
    sb.append("function flash(m){var o=sh.getAttribute('data-lbl')||sh.textContent;sh.setAttribute('data-lbl',o);sh.textContent=m;setTimeout(function(){sh.textContent=o;},1800);}\n")
    sb.append("function copiar(){if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(U).then(function(){flash('\\u00a1Enlace copiado!');},function(){prompt('Copia el enlace:',U);});return;}\n")
    sb.append("try{var t=document.createElement('textarea');t.value=U;t.style.position='fixed';t.style.opacity='0';document.body.appendChild(t);t.select();document.execCommand('copy');document.body.removeChild(t);flash('\\u00a1Enlace copiado!');}catch(e){prompt('Copia el enlace:',U);}}\n")
    sb.append("sh.addEventListener('click',function(){if(navigator.share){navigator.share(D).catch(function(){});}else{copiar();}});})();\n")
    // Avisos push: solo en paginas con #push-btn (p.ej. /sismos). Pide permiso,
    // se suscribe con la clave VAPID del server y envia la suscripcion por POST.
    sb.append("(function(){var btn=document.getElementById('push-btn');if(!btn)return;\n")
    sb.append("if(!('serviceWorker' in navigator)||!('PushManager' in window)||!('Notification' in window))return;\n")
    sb.append("var box=document.getElementById('push-box');if(box)box.hidden=false;\n")
    sb.append("var st=document.getElementById('push-status');function set(m){if(st)st.textContent=m;}\n")
    sb.append("var tb=document.getElementById('push-topics-btn'),tp=document.getElementById('push-topics');\n")
    sb.append("if(tb&&tp)tb.addEventListener('click',function(){var h=tp.hidden;tp.hidden=!h;tb.setAttribute('aria-expanded',String(h));});\n")
    sb.append("function b64u(buf){var b=btoa(String.fromCharCode.apply(null,new Uint8Array(buf)));return b.replace(/\\+/g,'-').replace(/\\//g,'_').replace(/=+$/,'');}\n")
    sb.append("function key2arr(s){var p='='.repeat((4-s.length%4)%4);var b=(s+p).replace(/-/g,'+').replace(/_/g,'/');var raw=atob(b);var a=new Uint8Array(raw.length);for(var i=0;i<raw.length;i++)a[i]=raw.charCodeAt(i);return a;}\n")
    sb.append("function topics(){var t=[];if(document.getElementById('push-t-sismos').checked)t.push('sismos');if(document.getElementById('push-t-tasas').checked)t.push('tasas');if(document.getElementById('push-t-chat').checked)t.push('chat');return t.join(',');}\n")
    sb.append("function mark(){btn.textContent='\\u2713 Avisos activados';btn.classList.add('on');}\n")
    sb.append("navigator.serviceWorker.ready.then(function(reg){return reg.pushManager.getSubscription();}).then(function(sub){if(sub)mark();}).catch(function(){});\n")
    sb.append("btn.addEventListener('click',function(){\n")
    sb.append("  if(btn.classList.contains('on'))return;\n")
    sb.append("  set('Pidiendo permiso\\u2026');\n")
    sb.append("  Notification.requestPermission().then(function(perm){\n")
    sb.append("    if(perm!=='granted'){set('Permiso denegado');return;}\n")
    sb.append("    navigator.serviceWorker.ready.then(function(reg){\n")
    sb.append("      return fetch('/api/push/config').then(function(r){return r.json();}).then(function(cfg){\n")
    sb.append("        return reg.pushManager.subscribe({userVisibleOnly:true,applicationServerKey:key2arr(cfg.key)});\n")
    sb.append("      });\n")
    sb.append("    }).then(function(sub){\n")
    sb.append("      var body='endpoint='+encodeURIComponent(sub.endpoint)+'&p256dh='+b64u(sub.getKey('p256dh'))+'&auth='+b64u(sub.getKey('auth'))+'&topics='+topics();\n")
    sb.append("      return fetch('/api/push/subscribe',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body});\n")
    sb.append("    }).then(function(r){return r.json();}).then(function(j){\n")
    sb.append("      if(j&&j.ok){mark();set('Listo');}else{set('Error: '+((j&&j.error)||'desconocido'));}\n")
    sb.append("    }).catch(function(){set('No se pudo activar');});\n")
    sb.append("  });\n")
    sb.append("});\n")
    sb.append("})();\n")
    sb.append("</script>\n")
    sb.append("</body>\n</html>\n")
    return sb.to_string()
}

pub fn page(title: String, content: String) -> String {
    return page_v(title, content, "width=device-width, initial-scale=1", "/manifest.webmanifest", "VenezuelaInfo", 1)
}

// Igual que page() pero bloquea el zoom del usuario (paginas con tabla/mapa que
// de otro modo obligan a alejar en movil).
pub fn page_fixed(title: String, content: String) -> String {
    return page_v(title, content, "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", "/manifest.webmanifest", "VenezuelaInfo", 1)
}

// Shell para la Calculadora como PWA instalable APARTE: su propio manifest
// (start_url/scope /calculadora), titulo de app, y SIN barra de navegacion
// (full_chrome=0) para que se sienta una app aparte.
pub fn page_calc(title: String, content: String) -> String {
    return page_v(title, content, "width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no", "/manifest-calc.webmanifest", "Calculadora VE", 0)
}
