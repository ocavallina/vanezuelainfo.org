// src/news.nx — Noticias: agrega RSS de medios venezolanos (server-side).
//
// Por que server-side: los RSS no mandan CORS, asi que un fetch client-side
// fallaria. Se baja con https_get (TLS) y se parsea con un parser RSS minimo
// (no hay XML en std; mismo enfoque de scanning que md.nx). Se cachea ~15 min.
// Solo se muestra titular + resumen corto + enlace al original (no se republica).

import "src/md"
import "src/kv"

// Caché de HTML renderizado (holders init en news_init(); el literal de array
// global multi-elemento se inicializa vacio -> hay que asignarlo en una funcion).
var __news_full: Array = [""]
var __news_prev: Array = [""]
var __news_rot: Array = [""]
var __news_ts: Array = [0]
var __bvc_list: Array = [""]
var __bvc_ibc: Array = [""]
var __bvc_ts: Array = [0]

const NEWS_TTL: int = 900

pub fn news_init() {
    __news_full = [""]
    __news_prev = [""]
    __news_rot = [""]
    __news_ts = [0]
    __bvc_list = [""]
    __bvc_ibc = [""]
    __bvc_ts = [0]
}

// ── Fuentes de noticias editables (nyx-kv: news:sources = lista "nombre|url") ──
// Editables desde el panel admin. Si la lista está vacía se siembra con las 5 por
// defecto; si nyx-kv no está disponible, refresh() cae a esas 5 hardcodeadas para
// que las noticias NUNCA queden vacías.

fn news_token() -> String {
    let e: String = getenv("NYXKV_CHAT_TOKEN")
    if e.length() > 0 {
        return md_trim(e)
    }
    let f: String = read_file("/home/admin/.veninfo-chat-token")
    return md_trim(f)
}

fn news_conn() -> int {
    return kv_connect_auth("127.0.0.1", 6380, news_token())
}

// Quita '|' y controles (a espacio), recorta y limita a maxb bytes.
fn news_clean(s: String, maxb: int) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = s.length()
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c == 124 or c < 32 {
            sb.append(" ")
        } else {
            sb.append(s.substring(i, i + 1))
        }
        i = i + 1
    }
    var out: String = md_trim(sb.to_string())
    if out.length() > maxb {
        out = out.substring(0, maxb)
    }
    return out
}

fn news_seed_defaults(h: int) {
    kv_rpush(h, "news:sources", "Efecto Cocuyo|https://efectococuyo.com/feed/")
    kv_rpush(h, "news:sources", "El Pitazo|https://elpitazo.net/feed/")
    kv_rpush(h, "news:sources", "Runrun.es|https://runrun.es/feed/")
    kv_rpush(h, "news:sources", "Cronica Uno|https://cronica.uno/feed/")
    kv_rpush(h, "news:sources", "El Nacional|https://www.elnacional.com/feed/")
}

// Lista de fuentes sobre una conexión abierta; siembra las 5 por defecto si está vacía.
fn news_sources_h(h: int) -> Array {
    var srcs: Array = kv_lrange(h, "news:sources", 0, -1)
    if srcs.length() == 0 {
        news_seed_defaults(h)
        srcs = kv_lrange(h, "news:sources", 0, -1)
    }
    return srcs
}

// Fuerza el próximo refresh (tras editar las fuentes).
pub fn news_invalidate() {
    __news_ts[0] = 0
}

// Lista de fuentes "nombre|url" para el panel admin ([] si el almacén no responde).
pub fn news_sources_list() -> Array {
    let h: int = news_conn()
    if h < 0 {
        return []
    }
    let srcs: Array = news_sources_h(h)
    kv_close(h)
    return srcs
}

// Añade una fuente. Devuelve "" si OK o el texto del error.
pub fn news_source_add(name_raw: String, url_raw: String) -> String {
    let nm: String = news_clean(name_raw, 60)
    let url: String = news_clean(url_raw, 300)
    if nm.length() == 0 {
        return "El nombre es obligatorio"
    }
    if !url.startsWith("https://") {
        return "La URL debe empezar por https://"
    }
    let h: int = news_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    news_sources_h(h)
    kv_rpush(h, "news:sources", nm + "|" + url)
    kv_close(h)
    news_invalidate()
    return ""
}

// Reemplaza la fuente en la posición `index` (reconstruye la lista).
pub fn news_source_edit(index: int, name_raw: String, url_raw: String) -> bool {
    let nm: String = news_clean(name_raw, 60)
    let url: String = news_clean(url_raw, 300)
    if nm.length() == 0 or !url.startsWith("https://") {
        return false
    }
    let h: int = news_conn()
    if h < 0 {
        return false
    }
    let srcs: Array = kv_lrange(h, "news:sources", 0, -1)
    if index < 0 or index >= srcs.length() {
        kv_close(h)
        return false
    }
    kv_del(h, "news:sources")
    var i: int = 0
    while i < srcs.length() {
        if i == index {
            kv_rpush(h, "news:sources", nm + "|" + url)
        } else {
            let s: String = srcs[i]
            kv_rpush(h, "news:sources", s)
        }
        i = i + 1
    }
    kv_close(h)
    news_invalidate()
    return true
}

// Borra la fuente en la posición `index` (reconstruye la lista).
pub fn news_source_delete(index: int) -> bool {
    let h: int = news_conn()
    if h < 0 {
        return false
    }
    let srcs: Array = kv_lrange(h, "news:sources", 0, -1)
    if index < 0 or index >= srcs.length() {
        kv_close(h)
        return false
    }
    var survivors: Array = []
    var i: int = 0
    while i < srcs.length() {
        if i != index {
            let s: String = srcs[i]
            survivors.push(s)
        }
        i = i + 1
    }
    kv_del(h, "news:sources")
    var j: int = 0
    while j < survivors.length() {
        let s2: String = survivors[j]
        kv_rpush(h, "news:sources", s2)
        j = j + 1
    }
    kv_close(h)
    news_invalidate()
    return true
}

pub fn news_ts() -> int {
    return __news_ts[0]
}

fn aesc2(s: String) -> String {
    return html_escape(s).replace("\"", "&quot;")
}

// indexOf con offset de inicio (std no lo trae).
fn find_from(hay: String, needle: String, start: int) -> int {
    if start >= hay.length() {
        return -1
    }
    let sub: String = hay.substring(start, hay.length())
    let i: int = sub.indexOf(needle)
    if i < 0 {
        return -1
    }
    return start + i
}

fn strip_cdata(s: String) -> String {
    let a: int = s.indexOf("<![CDATA[")
    if a < 0 {
        return s
    }
    let rest: String = s.substring(a + 9, s.length())
    let b: int = rest.indexOf("]]>")
    if b < 0 {
        return rest
    }
    return rest.substring(0, b)
}

// Texto entre <tag ...> y </tag> dentro de un item (primera aparicion).
fn tag_text(item: String, tag: String) -> String {
    let oi: int = item.indexOf("<" + tag)
    if oi < 0 {
        return ""
    }
    let gt: int = find_from(item, ">", oi)
    if gt < 0 {
        return ""
    }
    let ci: int = find_from(item, "</" + tag + ">", gt)
    if ci < 0 {
        return ""
    }
    let raw: String = item.substring(gt + 1, ci)
    return md_trim(strip_cdata(raw))
}

// Quita etiquetas HTML (todo lo que va entre '<' y '>').
fn strip_tags(s: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = s.length()
    var i: int = 0
    var depth: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c == 60 {
            depth = depth + 1
        } else if c == 62 {
            if depth > 0 {
                depth = depth - 1
            }
        } else {
            if depth == 0 {
                sb.append(s.substring(i, i + 1))
            }
        }
        i = i + 1
    }
    return sb.to_string()
}

// Desescapa entidades comunes (a ASCII aproximado donde aplica).
fn unescape(s: String) -> String {
    var o: String = s.replace("&lt;", "<")
    o = o.replace("&gt;", ">")
    o = o.replace("&quot;", "\"")
    o = o.replace("&#039;", "'")
    o = o.replace("&#39;", "'")
    o = o.replace("&#8217;", "'")
    o = o.replace("&#8216;", "'")
    o = o.replace("&#8220;", "\"")
    o = o.replace("&#8221;", "\"")
    o = o.replace("&#8211;", "-")
    o = o.replace("&#8212;", "-")
    o = o.replace("&#8230;", "...")
    o = o.replace("&hellip;", "...")
    o = o.replace("&nbsp;", " ")
    o = o.replace("&amp;", "&")
    return o
}

// Trunca en el ultimo espacio antes de maxb bytes (evita cortar a media palabra).
fn truncate_txt(s: String, maxb: int) -> String {
    if s.length() <= maxb {
        return s
    }
    let cut: String = s.substring(0, maxb)
    var k: int = cut.length() - 1
    var found: int = -1
    var go: bool = true
    while go and k >= 0 {
        if cut.charAt(k) == 32 {
            found = k
            go = false
        }
        k = k - 1
    }
    if found > 40 {
        return cut.substring(0, found) + "..."
    }
    return cut + "..."
}

fn clean_desc(raw: String) -> String {
    let t: String = unescape(strip_tags(raw))
    return truncate_txt(md_trim(t), 180)
}

fn month_num(m: String) -> int {
    if m == "Jan" { return 1 }
    if m == "Feb" { return 2 }
    if m == "Mar" { return 3 }
    if m == "Apr" { return 4 }
    if m == "May" { return 5 }
    if m == "Jun" { return 6 }
    if m == "Jul" { return 7 }
    if m == "Aug" { return 8 }
    if m == "Sep" { return 9 }
    if m == "Oct" { return 10 }
    if m == "Nov" { return 11 }
    if m == "Dec" { return 12 }
    return 0
}

// "Mon, 29 Jun 2026 23:58:00 +0000" -> 202606292358 (clave de orden desc)
fn rfc822_key(s: String) -> int {
    let parts: Array = s.split(" ")
    if parts.length() < 5 {
        return 0
    }
    let pday: String = parts[1]
    let pmon: String = parts[2]
    let pyr: String = parts[3]
    let ptm: String = parts[4]
    let day: int = string_to_int(md_trim(pday))
    let mon: int = month_num(md_trim(pmon))
    let yr: int = string_to_int(md_trim(pyr))
    let tm: String = md_trim(ptm)
    var hh: int = 0
    var mm: int = 0
    let c1: int = tm.indexOf(":")
    if c1 > 0 {
        hh = string_to_int(tm.substring(0, c1))
        let rest: String = tm.substring(c1 + 1, tm.length())
        let c2: int = rest.indexOf(":")
        if c2 > 0 {
            mm = string_to_int(rest.substring(0, c2))
        } else {
            mm = string_to_int(rest)
        }
    }
    return ((yr * 100 + mon) * 100 + day) * 10000 + hh * 100 + mm
}

// Días desde 1970-01-01 (algoritmo de días civiles; para epoch de RFC822)
fn __dfc2(y: int, m: int, d: int) -> int {
    var yy: int = y
    if m <= 2 { yy = yy - 1 }
    let era: int = yy / 400
    let yoe: int = yy - era * 400
    var mp: int = m - 3
    if m <= 2 { mp = m + 9 }
    let doy: int = (153 * mp + 2) / 5 + d - 1
    let doe: int = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe - 719468
}

// "Mon, 29 Jun 2026 23:58:00 +0000" -> epoch UTC en segundos (0 si no parsea)
fn rfc822_epoch(s: String) -> int {
    let parts: Array = s.split(" ")
    if parts.length() < 5 {
        return 0
    }
    let pday: String = parts[1]
    let pmon: String = parts[2]
    let pyr: String = parts[3]
    let ptm: String = parts[4]
    let day: int = string_to_int(md_trim(pday))
    let mon: int = month_num(md_trim(pmon))
    let yr: int = string_to_int(md_trim(pyr))
    if yr < 1970 or mon < 1 or day < 1 {
        return 0
    }
    let tp: Array = md_trim(ptm).split(":")
    var hh: int = 0
    var mm: int = 0
    var ss: int = 0
    if tp.length() >= 2 {
        let h0: String = tp[0]
        let m0: String = tp[1]
        hh = string_to_int(h0)
        mm = string_to_int(m0)
        if tp.length() >= 3 {
            let s0: String = tp[2]
            ss = string_to_int(s0)
        }
    }
    var ep: int = __dfc2(yr, mon, day) * 86400 + hh * 3600 + mm * 60 + ss
    if parts.length() >= 6 {
        let z: String = md_trim(parts[5])
        if z.length() == 5 and (z.startsWith("+") or z.startsWith("-")) {
            let zh: int = string_to_int(z.substring(1, 3))
            let zm: int = string_to_int(z.substring(3, 5))
            let off: int = zh * 3600 + zm * 60
            if z.startsWith("+") { ep = ep - off } else { ep = ep + off }
        }
    }
    return ep
}

// Delta en segundos -> "hace X" (mismo formato que rel_time del wasm)
pub fn rel_txt(delta_s: int) -> String {
    var s: int = delta_s
    if s < 0 { s = 0 }
    if s < 60 { return "hace " + int_to_string(s) + " s" }
    if s < 3600 { return "hace " + int_to_string(s / 60) + " min" }
    if s < 86400 { return "hace " + int_to_string(s / 3600) + " h" }
    return "hace " + int_to_string(s / 86400) + " d"
}

// El HTML de noticias/BVC se CACHEA (~30 min); las fechas relativas se emiten
// como marcador @REL:<epoch>@ y esta fn los sustituye por "hace X" en CADA
// request (las páginas van con no-cache, así que quedan exactas).
pub fn rel_fill(html: String) -> String {
    if html.indexOf("@REL:") < 0 {
        return html
    }
    let now: int = time()
    var out: StringBuilder = StringBuilder.new()
    var rest: String = html
    var guard: int = 0
    while guard < 500 {
        let p: int = rest.indexOf("@REL:")
        if p < 0 {
            out.append(rest)
            return out.to_string()
        }
        out.append(rest.substring(0, p))
        let tail: String = rest.substring(p + 5, rest.length())
        let e: int = tail.indexOf("@")
        if e < 0 {
            out.append(tail)
            return out.to_string()
        }
        let eps: String = tail.substring(0, e)
        let ep: int = string_to_int(eps)
        if ep > 0 {
            out.append(rel_txt(now - ep))
        }
        rest = tail.substring(e + 1, tail.length())
        guard = guard + 1
    }
    out.append(rest)
    return out.to_string()
}

// Origin (esquema+host) de una URL: "https://x.com/a" -> "https://x.com".
fn origin_of(url: String) -> String {
    let p: int = url.indexOf("://")
    if p < 0 {
        return ""
    }
    let rest: String = url.substring(p + 3, url.length())
    let s: int = rest.indexOf("/")
    if s < 0 {
        return url
    }
    return url.substring(0, p + 3 + s)
}

// Primera imagen del contenido (absolutizada y forzada a https).
fn first_img(content: String, link: String) -> String {
    let ii: int = content.indexOf("<img")
    if ii < 0 {
        return ""
    }
    let si: int = find_from(content, "src=\"", ii)
    if si < 0 {
        return ""
    }
    let after: String = content.substring(si + 5, content.length())
    let q: int = after.indexOf("\"")
    if q < 0 {
        return ""
    }
    var url: String = after.substring(0, q)
    if url.startsWith("//") {
        url = "https:" + url
    } else if url.startsWith("/") {
        url = origin_of(link) + url
    }
    if url.startsWith("http://") {
        url = "https://" + url.substring(7, url.length())
    }
    return url
}

// Parsea un cuerpo RSS y agrega items a `out`.
// item = [title, link, pub, src, desc, key, img, excerpt].
fn parse_feed(xml: String, source: String, out: Array, cap: int) {
    var pos: int = 0
    var n: int = 0
    var go: bool = true
    while go and n < cap {
        let it: int = find_from(xml, "<item", pos)
        if it < 0 {
            go = false
        } else {
            let ite: int = find_from(xml, "</item>", it)
            if ite < 0 {
                go = false
            } else {
                let item: String = xml.substring(it, ite)
                let title: String = unescape(tag_text(item, "title"))
                let link: String = tag_text(item, "link")
                let pdate: String = tag_text(item, "pubDate")
                let desc: String = clean_desc(tag_text(item, "description"))
                let content: String = tag_text(item, "content:encoded")
                var img: String = ""
                var excerpt: String = desc
                if content.length() > 0 {
                    img = first_img(content, link)
                    excerpt = truncate_txt(md_trim(unescape(strip_tags(content))), 600)
                }
                if title.length() > 0 and link.length() > 0 {
                    let key: int = rfc822_key(pdate)
                    let epoch: int = rfc822_epoch(pdate)
                    let row: Array = [title, link, pdate, source, desc, key, img, excerpt, epoch]
                    out.push(row)
                    n = n + 1
                }
                pos = ite + 7
            }
        }
    }
}

fn fetch_into(out: Array, url: String, source: String) {
    let xml: String = net_get(url)
    if xml.length() > 0 {
        parse_feed(xml, source, out, 15)
    }
}

// Bubble sort por clave (item[5]) descendente.
fn sort_desc(items: Array) {
    let n: int = items.length()
    var a: int = 0
    while a < n {
        var b: int = 0
        while b + 1 < n {
            let x: Array = items[b]
            let y: Array = items[b + 1]
            let kx: int = x[5]
            let ky: int = y[5]
            if kx < ky {
                items[b] = y
                items[b + 1] = x
            }
            b = b + 1
        }
        a = a + 1
    }
}

fn render_list(items: Array, maxn: int, compact: bool) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = items.length()
    var i: int = 0
    while i < maxn and i < n {
        let it: Array = items[i]
        let title: String = it[0]
        let link: String = it[1]
        let pdate: String = it[2]
        let src: String = it[3]
        let desc: String = it[4]
        let img: String = it[6]
        let excerpt: String = it[7]
        let epoch: int = it[8]
        if compact {
            sb.append("<a class=\"news-item\" href=\"")
            sb.append(aesc2(link))
            sb.append("\" target=\"_blank\" rel=\"noopener nofollow\"><span class=\"news-src\">")
            sb.append(html_escape(src))
            sb.append("</span><span class=\"news-title\">")
            sb.append(html_escape(title))
            sb.append("</span><time class=\"news-date\" data-ts=\"")
            sb.append(aesc2(pdate))
            sb.append("\">@REL:")
            sb.append(int_to_string(epoch))
            sb.append("@</time></a>\n")
        } else {
            // data-idx (1-based, = posición nth-child) para el expand en wasm
            sb.append("<article class=\"news-item\" tabindex=\"0\" data-idx=\"")
            sb.append(int_to_string(i + 1))
            sb.append("\"><span class=\"news-src\">")
            sb.append(html_escape(src))
            sb.append("</span><span class=\"news-title\">")
            sb.append(html_escape(title))
            sb.append("</span><time class=\"news-date\" data-ts=\"")
            sb.append(aesc2(pdate))
            sb.append("\">@REL:")
            sb.append(int_to_string(epoch))
            sb.append("@</time>")
            if desc.length() > 0 {
                sb.append("<span class=\"news-sum\">")
                sb.append(html_escape(desc))
                sb.append("</span>")
            }
            sb.append("<div class=\"news-detail\">")
            if img.length() > 0 {
                sb.append("<img class=\"news-img\" loading=\"lazy\" alt=\"\" src=\"")
                sb.append(aesc2(img))
                sb.append("\">")
            }
            if excerpt.length() > 0 {
                sb.append("<p class=\"news-full\">")
                sb.append(html_escape(excerpt))
                sb.append("</p>")
            }
            sb.append("<a class=\"btn-map\" href=\"")
            sb.append(aesc2(link))
            sb.append("\" target=\"_blank\" rel=\"noopener nofollow\">Leer completo en ")
            sb.append(html_escape(src))
            sb.append(" &rarr;</a></div></article>\n")
        }
        i = i + 1
    }
    return sb.to_string()
}

// Slides para el rotador de la portada (titular suelto, sin enlace propio).
fn render_slides(items: Array, maxn: int) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = items.length()
    var i: int = 0
    while i < maxn and i < n {
        let it: Array = items[i]
        let title: String = it[0]
        let pdate: String = it[2]
        let src: String = it[3]
        let epoch: int = it[8]
        sb.append("<div class=\"rot-slide\"><span class=\"news-src\">")
        sb.append(html_escape(src))
        sb.append("</span><span class=\"rot-title\">")
        sb.append(html_escape(title))
        sb.append("</span><time class=\"news-date\" data-ts=\"")
        sb.append(aesc2(pdate))
        sb.append("\">@REL:")
        sb.append(int_to_string(epoch))
        sb.append("@</time></div>\n")
        i = i + 1
    }
    return sb.to_string()
}

fn refresh() {
    var items: Array = []
    var used: bool = false
    let h: int = news_conn()
    if h >= 0 {
        let srcs: Array = news_sources_h(h)
        kv_close(h)
        var i: int = 0
        while i < srcs.length() {
            let entry: String = srcs[i]
            let p: int = entry.indexOf("|")
            if p > 0 {
                let name: String = entry.substring(0, p)
                let url: String = entry.substring(p + 1, entry.length())
                if url.length() > 0 {
                    fetch_into(items, url, name)
                    used = true
                }
            }
            i = i + 1
        }
    }
    if !used {
        // Fallback: nyx-kv no disponible o sin fuentes → las 5 por defecto.
        fetch_into(items, "https://efectococuyo.com/feed/", "Efecto Cocuyo")
        fetch_into(items, "https://elpitazo.net/feed/", "El Pitazo")
        fetch_into(items, "https://runrun.es/feed/", "Runrun.es")
        fetch_into(items, "https://cronica.uno/feed/", "Cronica Uno")
        fetch_into(items, "https://www.elnacional.com/feed/", "El Nacional")
    }
    sort_desc(items)
    __news_full[0] = render_list(items, 60, false)
    __news_prev[0] = render_list(items, 5, true)
    __news_rot[0] = render_slides(items, 6)
}

fn ensure_fresh() {
    let now: int = time()
    let last: int = __news_ts[0]
    let cur: String = __news_full[0]
    if cur.length() == 0 or now - last > NEWS_TTL {
        refresh()
        __news_ts[0] = now
    }
}

// HTML de la lista completa (para /noticias). rel_fill fija el "hace X" del
// momento del request (el HTML cacheado trae marcadores @REL:).
pub fn news_full_html() -> String {
    ensure_fresh()
    let h: String = __news_full[0]
    if h.length() == 0 {
        return "<p class=\"error\">No se pudieron cargar las noticias en este momento.</p>"
    }
    return rel_fill(h)
}

// HTML del avance (5 titulares, para la portada). "" si no hay datos.
pub fn news_preview_html() -> String {
    ensure_fresh()
    let h: String = __news_prev[0]
    return rel_fill(h)
}

// HTML de los slides para el rotador de la portada. "" si no hay datos.
pub fn news_rotator_html() -> String {
    ensure_fresh()
    let h: String = __news_rot[0]
    return rel_fill(h)
}

// ---- Bolsa de Caracas (comunicados + IBC) via RSS de bolsadecaracas.com ----
fn bvc_refresh() {
    var items: Array = []
    let xml: String = net_get("https://www.bolsadecaracas.com/feed/")
    if xml.length() > 0 {
        parse_feed(xml, "BVC", items, 20)
    }
    __bvc_list[0] = render_list(items, 12, false)
    var ibc: String = ""
    var i: int = 0
    var go: bool = true
    while go and i < items.length() {
        let it: Array = items[i]
        let title: String = it[0]
        if title.indexOf("Caracas cerr") >= 0 {
            ibc = title
            go = false
        }
        i = i + 1
    }
    __bvc_ibc[0] = ibc
}

fn bvc_ensure() {
    let now: int = time()
    let last: int = __bvc_ts[0]
    let cur: String = __bvc_list[0]
    if cur.length() == 0 or now - last > NEWS_TTL {
        bvc_refresh()
        __bvc_ts[0] = now
    }
}

pub fn bvc_list_html() -> String {
    bvc_ensure()
    let h: String = __bvc_list[0]
    if h.length() == 0 {
        return "<p class=\"error\">No se pudieron cargar los comunicados de la BVC.</p>"
    }
    return rel_fill(h)
}

// Titular del ultimo cierre del Indice Bursatil Caracas (o "").
pub fn bvc_ibc_text() -> String {
    bvc_ensure()
    return __bvc_ibc[0]
}

// Fuerza el refresco de noticias + BVC (hilo de actualizacion periodica y
// pre-calentado al arrancar).
pub fn news_warm() {
    refresh()
    bvc_refresh()
    let now: int = time()
    __news_ts[0] = now
    __bvc_ts[0] = now
}
