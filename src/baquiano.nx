// src/baquiano.nx — "Baquiano": guia de sitios de Venezuela por zona (estado/region).
// Contenido editable desde el panel admin, almacenado en nyx-kv (namespace veninfo::).
//
// Modelo (todo plano, sin Maps anidados por el SEGV de la lib):
//   baq:zones            -> lista de ids de zona (estados/regiones)
//   baq:zone:<id>        -> nombre de la zona (string)
//   baq:zone:<id>:sites  -> lista de sitios "nombre|categoria|descripcion" (saneados)
//
// La escritura la usa el panel admin (src/admin.nx); la lectura, las rutas publicas
// /baquiano y /baquiano/{zona} y la tarjeta de la portada.

import "src/kv"
import "src/md"
import "src/articles"

fn baq_token() -> String {
    let e: String = getenv("NYXKV_CHAT_TOKEN")
    if e.length() > 0 {
        return md_trim(e)
    }
    let f: String = read_file("/home/admin/.veninfo-chat-token")
    return md_trim(f)
}

fn baq_conn() -> int {
    return kv_connect_auth("127.0.0.1", 6380, baq_token())
}

// Quita '|' y caracteres de control (a espacio), recorta y limita a maxb bytes.
fn baq_clean(s: String, maxb: int) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = s.length()
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c == 124 or c < 32 {
            sb.append(" ")
        } else {
            sb.append(s.substring(i, i + 1))
        }
        i = i + 1
    }
    var out: String = md_trim(sb.to_string())
    if out.length() > maxb {
        out = out.substring(0, maxb)
    }
    return out
}

fn zone_meta_key(id: String) -> String {
    return "baq:zone:" + id
}

fn zone_sites_key(id: String) -> String {
    return "baq:zone:" + id + ":sites"
}

fn zone_capital_key(id: String) -> String {
    return "baq:zone:" + id + ":capital"
}

fn zone_desc_key(id: String) -> String {
    return "baq:zone:" + id + ":desc"
}

fn zone_facts_key(id: String) -> String {
    return "baq:zone:" + id + ":facts"
}

fn zone_munis_key(id: String) -> String {
    return "baq:zone:" + id + ":municipios"
}

fn zone_poblados_key(id: String) -> String {
    return "baq:zone:" + id + ":poblados"
}

fn zone_img_key(id: String) -> String {
    return "baq:zone:" + id + ":img"
}

// ── Lectura ──────────────────────────────────────────────────────────────────

// Ids de zona (en orden de creacion).
fn zones_list_h(h: int) -> Array {
    return kv_lrange(h, "baq:zones", 0, -1)
}

fn zone_exists_h(h: int, id: String) -> bool {
    return kv_exists(h, zone_meta_key(id))
}

// ── Escritura (panel admin) ──────────────────────────────────────────────────

// Crea una zona. Devuelve "" si OK o el texto del error.
pub fn zone_create(id_raw: String, name_raw: String) -> String {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return "Identificador invalido (solo minusculas, numeros y guiones)"
    }
    var nm: String = baq_clean(name_raw, 60)
    if nm.length() == 0 {
        nm = id
    }
    let h: int = baq_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    if zone_exists_h(h, id) {
        kv_close(h)
        return "Esa zona ya existe"
    }
    kv_set(h, zone_meta_key(id), nm)
    kv_rpush(h, "baq:zones", id)
    kv_close(h)
    return ""
}

// Renombra una zona existente.
pub fn zone_rename(id_raw: String, name_raw: String) -> bool {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return false
    }
    let nm: String = baq_clean(name_raw, 60)
    if nm.length() == 0 {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    if !zone_exists_h(h, id) {
        kv_close(h)
        return false
    }
    kv_set(h, zone_meta_key(id), nm)
    kv_close(h)
    return true
}

// Borra una zona y sus sitios.
pub fn zone_delete(id_raw: String) -> bool {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    let ids: Array = zones_list_h(h)
    var survivors: Array = []
    var found: bool = false
    var i: int = 0
    while i < ids.length() {
        let z: String = ids[i]
        if z == id {
            found = true
        } else {
            survivors.push(z)
        }
        i = i + 1
    }
    kv_del(h, "baq:zones")
    var j: int = 0
    while j < survivors.length() {
        let s: String = survivors[j]
        kv_rpush(h, "baq:zones", s)
        j = j + 1
    }
    kv_del(h, zone_meta_key(id))
    kv_del(h, zone_sites_key(id))
    kv_del(h, zone_capital_key(id))
    kv_del(h, zone_desc_key(id))
    kv_del(h, zone_facts_key(id))
    kv_del(h, zone_munis_key(id))
    kv_del(h, zone_poblados_key(id))
    kv_del(h, zone_img_key(id))
    kv_close(h)
    return found
}

// ── Campos enriquecidos de la zona (capital, panorama, datos, municipios, poblados) ──

// Edita nombre + capital + descripcion + imagen de una zona existente. true si OK.
pub fn zone_edit(id_raw: String, name_raw: String, cap_raw: String, desc_raw: String, img_raw: String) -> bool {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    if !zone_exists_h(h, id) {
        kv_close(h)
        return false
    }
    let nm: String = baq_clean(name_raw, 60)
    if nm.length() > 0 {
        kv_set(h, zone_meta_key(id), nm)
    }
    kv_set(h, zone_capital_key(id), baq_clean(cap_raw, 60))
    // Codifica saltos de linea (textarea) como centinela "~~P~~" antes de guardar
    // (el cliente nyx-kv trunca valores con \n real).
    let de: String = desc_raw.replace("\r\n", "~~P~~").replace("\n", "~~P~~")
    kv_set(h, zone_desc_key(id), baq_clean(de, 8000))
    kv_set(h, zone_img_key(id), baq_clean(img_raw, 500))
    kv_close(h)
    return true
}

// Añade un dato practico (etiqueta|valor). "" si OK o el texto del error.
pub fn fact_add(zone_raw: String, label_raw: String, val_raw: String) -> String {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return "Zona invalida"
    }
    let label: String = baq_clean(label_raw, 60)
    if label.length() == 0 {
        return "La etiqueta es obligatoria"
    }
    let val: String = baq_clean(val_raw, 2000)
    let h: int = baq_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    if !zone_exists_h(h, zone) {
        kv_close(h)
        return "Esa zona no existe"
    }
    kv_rpush(h, zone_facts_key(zone), label + "|" + val)
    kv_close(h)
    return ""
}

// Añade un municipio (nombre|capital). "" si OK o el texto del error.
pub fn muni_add(zone_raw: String, name_raw: String, cap_raw: String) -> String {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return "Zona invalida"
    }
    let nm: String = baq_clean(name_raw, 80)
    if nm.length() == 0 {
        return "El nombre del municipio es obligatorio"
    }
    let cap: String = baq_clean(cap_raw, 80)
    let h: int = baq_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    if !zone_exists_h(h, zone) {
        kv_close(h)
        return "Esa zona no existe"
    }
    kv_rpush(h, zone_munis_key(zone), nm + "|" + cap)
    kv_close(h)
    return ""
}

// Añade una entrada del directorio de centros poblados (municipio|localidades).
pub fn poblado_add(zone_raw: String, muni_raw: String, locs_raw: String) -> String {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return "Zona invalida"
    }
    let muni: String = baq_clean(muni_raw, 80)
    if muni.length() == 0 {
        return "El municipio es obligatorio"
    }
    let locs: String = baq_clean(locs_raw, 4000)
    let h: int = baq_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    if !zone_exists_h(h, zone) {
        kv_close(h)
        return "Esa zona no existe"
    }
    kv_rpush(h, zone_poblados_key(zone), muni + "|" + locs)
    kv_close(h)
    return ""
}

// Borra por indice una entrada de una lista `key` de la zona (reconstruye la lista).
fn list_delete(zone_raw: String, keyfn_which: int, index: int) -> bool {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    var key: String = zone_facts_key(zone)
    if keyfn_which == 1 {
        key = zone_munis_key(zone)
    } else if keyfn_which == 2 {
        key = zone_poblados_key(zone)
    }
    let items: Array = kv_lrange(h, key, 0, -1)
    if index < 0 or index >= items.length() {
        kv_close(h)
        return false
    }
    var survivors: Array = []
    var i: int = 0
    while i < items.length() {
        if i != index {
            let s: String = items[i]
            survivors.push(s)
        }
        i = i + 1
    }
    kv_del(h, key)
    var j: int = 0
    while j < survivors.length() {
        let s2: String = survivors[j]
        kv_rpush(h, key, s2)
        j = j + 1
    }
    kv_close(h)
    return true
}

pub fn fact_delete(zone_raw: String, index: int) -> bool {
    return list_delete(zone_raw, 0, index)
}

pub fn muni_delete(zone_raw: String, index: int) -> bool {
    return list_delete(zone_raw, 1, index)
}

pub fn poblado_delete(zone_raw: String, index: int) -> bool {
    return list_delete(zone_raw, 2, index)
}

// ── Importacion desde content/baquiano-seed.txt ──────────────────────────────
// Una linea por registro; campos separados por "~~~" (token que no aparece en prosa);
// \n reales escapados como "\n" literal en los campos de texto (D/S):
//   Z~~~id~~~nombre~~~capital
//   D~~~id~~~desc            (panorama; "\n" escapados)
//   F~~~id~~~etiqueta~~~valor
//   M~~~id~~~municipio~~~capital
//   S~~~id~~~nombre~~~categoria~~~desc
//   P~~~id~~~municipio~~~localidades
// Carga el seed. wipe=1 borra todo y recarga (reemplazo total); wipe=0 NO borra (restaura
// sobre estado vacio/parcial, p.ej. tras perdida de datos). load_sites=0 NO toca los :sites
// (para conservar imagenes ya buscadas). Devuelve nº de zonas (-1 si falla).
pub fn baquiano_import_ex(wipe: int, load_sites: int) -> int {
    let raw: String = read_file("content/baquiano-seed.txt")
    if raw.length() == 0 {
        return -1
    }
    let h: int = baq_conn()
    if h < 0 {
        return -1
    }
    if wipe == 1 {
        let old: Array = zones_list_h(h)
        var oi: int = 0
        while oi < old.length() {
            let z: String = old[oi]
            kv_del(h, zone_meta_key(z))
            kv_del(h, zone_sites_key(z))
            kv_del(h, zone_capital_key(z))
            kv_del(h, zone_desc_key(z))
            kv_del(h, zone_facts_key(z))
            kv_del(h, zone_munis_key(z))
            kv_del(h, zone_poblados_key(z))
            kv_del(h, zone_img_key(z))
            oi = oi + 1
        }
        kv_del(h, "baq:zones")
    }
    // CARGA
    let lines: Array = raw.split("\n")
    var count: int = 0
    var i: int = 0
    while i < lines.length() {
        let line: String = lines[i]
        if line.length() > 2 {
            let f: Array = line.split("~~~")
            if f.length() >= 3 {
                let typ: String = f[0]
                let id: String = md_trim(f[1])
                if is_valid_slug(id) {
                    if typ == "Z" {
                        var nm: String = baq_clean(f[2], 60)
                        if nm.length() == 0 { nm = id }
                        kv_set(h, zone_meta_key(id), nm)
                        kv_rpush(h, "baq:zones", id)
                        if f.length() >= 4 {
                            kv_set(h, zone_capital_key(id), baq_clean(f[3], 60))
                        }
                        count = count + 1
                    } else if typ == "D" {
                        let d0: String = f[2]
                        kv_set(h, zone_desc_key(id), baq_clean(d0, 8000))
                    } else if typ == "F" and f.length() >= 4 {
                        let lb: String = baq_clean(f[2], 60)
                        let vl: String = baq_clean(f[3], 2000)
                        if lb.length() > 0 {
                            kv_rpush(h, zone_facts_key(id), lb + "|" + vl)
                        }
                    } else if typ == "M" and f.length() >= 4 {
                        let mn: String = baq_clean(f[2], 80)
                        let mc: String = baq_clean(f[3], 80)
                        if mn.length() > 0 {
                            kv_rpush(h, zone_munis_key(id), mn + "|" + mc)
                        }
                    } else if typ == "S" and f.length() >= 5 and load_sites == 1 {
                        let sn: String = baq_clean(f[2], 80)
                        let sc: String = baq_clean(f[3], 40)
                        let sd: String = baq_clean(f[4], 900)
                        var si: String = ""
                        if f.length() >= 6 { si = baq_clean(f[5], 500) }
                        if sn.length() > 0 {
                            var entry: String = sn + "|" + sc + "|" + sd
                            if si.length() > 0 { entry = entry + "|" + si }
                            kv_rpush(h, zone_sites_key(id), entry)
                        }
                    } else if typ == "I" {
                        kv_set(h, zone_img_key(id), baq_clean(f[2], 500))
                    } else if typ == "P" and f.length() >= 4 {
                        let pm: String = baq_clean(f[2], 80)
                        let pl: String = baq_clean(f[3], 4000)
                        if pm.length() > 0 {
                            kv_rpush(h, zone_poblados_key(id), pm + "|" + pl)
                        }
                    }
                }
            }
        }
        i = i + 1
    }
    kv_close(h)
    return count
}

// Import estandar (reemplazo total). Usado por el boton "Importar guia" del admin.
pub fn baquiano_import() -> int {
    return baquiano_import_ex(1, 1)
}

// Escapa un valor para el seed: quita "~~~" (delimitador de campos) y saltos de linea.
// Preserva el centinela de parrafos "~~P~~" (no contiene 3 tildes seguidas).
fn seed_ex(s: String) -> String {
    return s.replace("~~~", " ").replace("\r", " ").replace("\n", " ")
}

// Exporta el estado actual de Baquiano al formato del seed, INCLUYENDO imagenes
// (6o campo de S = imgurl del destino; registro I por zona = portada). Para respaldar.
pub fn baquiano_export() -> String {
    let h: int = baq_conn()
    if h < 0 {
        return ""
    }
    let ids: Array = zones_list_h(h)
    var sb: StringBuilder = StringBuilder.new()
    var i: int = 0
    while i < ids.length() {
        let id: String = ids[i]
        let nm: String = kv_get(h, zone_meta_key(id))
        let cap: String = kv_get(h, zone_capital_key(id))
        let desc: String = kv_get(h, zone_desc_key(id))
        let img: String = kv_get(h, zone_img_key(id))
        sb.append("Z~~~" + id + "~~~" + seed_ex(nm) + "~~~" + seed_ex(cap) + "\n")
        if img.length() > 0 {
            sb.append("I~~~" + id + "~~~" + seed_ex(img) + "\n")
        }
        if desc.length() > 0 {
            sb.append("D~~~" + id + "~~~" + seed_ex(desc) + "\n")
        }
        let facts: Array = kv_lrange(h, zone_facts_key(id), 0, -1)
        var j: int = 0
        while j < facts.length() {
            let e: String = facts[j]
            let p: int = e.indexOf("|")
            if p >= 0 {
                let a: String = e.substring(0, p)
                let b: String = e.substring(p + 1, e.length())
                sb.append("F~~~" + id + "~~~" + seed_ex(a) + "~~~" + seed_ex(b) + "\n")
            }
            j = j + 1
        }
        let munis: Array = kv_lrange(h, zone_munis_key(id), 0, -1)
        var m: int = 0
        while m < munis.length() {
            let e: String = munis[m]
            let p: int = e.indexOf("|")
            if p >= 0 {
                let a: String = e.substring(0, p)
                let b: String = e.substring(p + 1, e.length())
                sb.append("M~~~" + id + "~~~" + seed_ex(a) + "~~~" + seed_ex(b) + "\n")
            }
            m = m + 1
        }
        let sites: Array = kv_lrange(h, zone_sites_key(id), 0, -1)
        var s: int = 0
        while s < sites.length() {
            let e: String = sites[s]
            let f4: Array = site_split4(e)
            let sn: String = f4[0]
            let sc: String = f4[1]
            let sd: String = f4[2]
            let si: String = f4[3]
            sb.append("S~~~" + id + "~~~" + seed_ex(sn) + "~~~" + seed_ex(sc) + "~~~" + seed_ex(sd) + "~~~" + seed_ex(si) + "\n")
            s = s + 1
        }
        let pobs: Array = kv_lrange(h, zone_poblados_key(id), 0, -1)
        var pp: int = 0
        while pp < pobs.length() {
            let e: String = pobs[pp]
            let p: int = e.indexOf("|")
            if p >= 0 {
                let a: String = e.substring(0, p)
                let b: String = e.substring(p + 1, e.length())
                sb.append("P~~~" + id + "~~~" + seed_ex(a) + "~~~" + seed_ex(b) + "\n")
            }
            pp = pp + 1
        }
        i = i + 1
    }
    kv_close(h)
    return sb.to_string()
}

// Respalda el estado actual al archivo del seed (sobrevive perdidas de nyx-kv;
// una "Importar guia" luego restaura TODO, imagenes incluidas). Bytes escritos o -1.
pub fn baquiano_backup() -> int {
    let s: String = baquiano_export()
    if s.length() == 0 {
        return -1
    }
    write_file("content/baquiano-seed.txt", s)
    return s.length()
}

// Añade un sitio a una zona. Devuelve "" si OK o el texto del error.
pub fn site_add(zone_raw: String, name_raw: String, cat_raw: String, desc_raw: String) -> String {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return "Zona invalida"
    }
    let nm: String = baq_clean(name_raw, 80)
    if nm.length() == 0 {
        return "El nombre del sitio es obligatorio"
    }
    let cat: String = baq_clean(cat_raw, 40)
    let desc: String = baq_clean(desc_raw, 500)
    let h: int = baq_conn()
    if h < 0 {
        return "Almacen no disponible"
    }
    if !zone_exists_h(h, zone) {
        kv_close(h)
        return "Esa zona no existe"
    }
    kv_rpush(h, zone_sites_key(zone), nm + "|" + cat + "|" + desc)
    kv_close(h)
    return ""
}

// Borra el sitio en la posicion `index` de una zona (reconstruye la lista).
pub fn site_delete(zone_raw: String, index: int) -> bool {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    let sites: Array = kv_lrange(h, zone_sites_key(zone), 0, -1)
    if index < 0 or index >= sites.length() {
        kv_close(h)
        return false
    }
    var survivors: Array = []
    var i: int = 0
    while i < sites.length() {
        if i != index {
            let s: String = sites[i]
            survivors.push(s)
        }
        i = i + 1
    }
    kv_del(h, zone_sites_key(zone))
    var j: int = 0
    while j < survivors.length() {
        let s2: String = survivors[j]
        kv_rpush(h, zone_sites_key(zone), s2)
        j = j + 1
    }
    kv_close(h)
    return true
}

// ── Render de un sitio ("nombre|categoria|descripcion") como tarjeta ─────────
// Percent-encoding minimo (local, sin externs: evita el gotcha de redefinicion de
// nyx_url_*). Conserva [A-Za-z0-9], codifica el resto como %XX.
fn baq_hex2(b: int) -> String {
    var v: int = b
    if v < 0 {
        v = v + 256
    }
    let digits: String = "0123456789ABCDEF"
    let hi: int = v / 16
    let lo: int = v - hi * 16
    return digits.substring(hi, hi + 1) + digits.substring(lo, lo + 1)
}

fn baq_urlenc(s: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = s.length()
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122) {
            sb.append(s.substring(i, i + 1))
        } else {
            sb.append("%")
            sb.append(baq_hex2(c))
        }
        i = i + 1
    }
    return sb.to_string()
}

// Enlace de busqueda en Google Maps para "<sitio>, <zona>, Venezuela" (sin coordenadas).
fn maps_url(name: String, zone_label: String) -> String {
    let q: String = name + ", " + zone_label + ", Venezuela"
    return "https://www.google.com/maps/search/?api=1&query=" + baq_urlenc(q)
}

// Enlace a resultados de hoteles de Google Maps para un area.
fn hotels_url(area: String) -> String {
    return "https://www.google.com/maps/search/?api=1&query=" + baq_urlenc("hoteles en " + area + ", Venezuela")
}

// Descompone la entrada de un sitio "nombre|categoria|descripcion|imgurl" en 4 campos
// (los que falten quedan ""). Retrocompatible con entradas de 3 campos.
fn site_split4(entry: String) -> Array {
    var nm: String = entry
    var cat: String = ""
    var desc: String = ""
    var img: String = ""
    let p1: int = entry.indexOf("|")
    if p1 >= 0 {
        nm = entry.substring(0, p1)
        let r1: String = entry.substring(p1 + 1, entry.length())
        let p2: int = r1.indexOf("|")
        if p2 >= 0 {
            cat = r1.substring(0, p2)
            let r2: String = r1.substring(p2 + 1, r1.length())
            let p3: int = r2.indexOf("|")
            if p3 >= 0 {
                desc = r2.substring(0, p3)
                img = r2.substring(p3 + 1, r2.length())
            } else {
                desc = r2
            }
        } else {
            cat = r1
        }
    }
    let out: Array = [nm, cat, desc, img]
    return out
}

// GET a Wikipedia con User-Agent DESCRIPTIVO (la API lo exige; sin el, throttlea/bloquea
// la IP) + throttle de ~0.8 s por llamada (cortesia; evita el rate-limit por rafaga).
// Usa http_build_request/http_tls_request de std/http (scope global, importado por main).
fn wiki_get(url: String) -> String {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    let port: int = parsed[2]
    let path: String = parsed[3]
    let hd: Array = ["User-Agent", "venezuelainfo.org/1.0 (https://venezuelainfo.org; contacto: admin)", "Accept", "application/json"]
    let req: String = http_build_request("GET", host, path, hd, "")
    let resp: Array = http_tls_request(host, port, req)
    let body: String = resp[3]
    sleep(800)
    return body
}

// Busca en Wikipedia ES una imagen para `query` (+ " Venezuela"). URL del thumbnail o "".
// Parseo por scan manual de string (NO std/json: trunca floats y es mas fragil).
pub fn wiki_image(query: String) -> String {
    let url: String = "https://es.wikipedia.org/w/api.php?action=query&format=json&generator=search&gsrsearch=" + baq_urlenc(query + " Venezuela") + "&gsrlimit=1&prop=pageimages&piprop=thumbnail&pithumbsize=640"
    let body: String = wiki_get(url)
    if body.length() == 0 {
        return ""
    }
    let pat: String = "\"source\":\""
    let p: int = body.indexOf(pat)
    if p < 0 {
        return ""
    }
    let rest: String = body.substring(p + pat.length(), body.length())
    let q: int = rest.indexOf("\"")
    if q < 0 {
        return ""
    }
    var u: String = rest.substring(0, q)
    u = u.replace("\\/", "/")
    return u
}

// Fija/limpia la URL de imagen (4o campo) del sitio `index` de una zona.
pub fn site_set_img(zone_raw: String, index: int, url_raw: String) -> bool {
    let zone: String = md_trim(zone_raw)
    if !is_valid_slug(zone) {
        return false
    }
    let h: int = baq_conn()
    if h < 0 {
        return false
    }
    let sites: Array = kv_lrange(h, zone_sites_key(zone), 0, -1)
    if index < 0 or index >= sites.length() {
        kv_close(h)
        return false
    }
    let url: String = baq_clean(url_raw, 500)
    var rebuilt: Array = []
    var i: int = 0
    while i < sites.length() {
        let e: String = sites[i]
        if i == index {
            let f: Array = site_split4(e)
            let nm: String = f[0]
            let cat: String = f[1]
            let desc: String = f[2]
            rebuilt.push(nm + "|" + cat + "|" + desc + "|" + url)
        } else {
            rebuilt.push(e)
        }
        i = i + 1
    }
    kv_del(h, zone_sites_key(zone))
    var j: int = 0
    while j < rebuilt.length() {
        let s2: String = rebuilt[j]
        kv_rpush(h, zone_sites_key(zone), s2)
        j = j + 1
    }
    kv_close(h)
    return true
}

// Rellena las imagenes de UNA zona (portada + sitios) buscando en Wikipedia. SINCRONO
// (rapido, ~1s por zona; se llama desde el handler del admin, donde https_get es fiable).
// Conexiones kv CORTAS (lectura/escritura); los https_get van en medio SIN kv abierta.
// force=1 sobrescribe; si no, solo rellena vacias. Devuelve nº de imagenes rellenadas.
pub fn baquiano_fetch_zone(id_raw: String, force: int) -> int {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return 0
    }
    let h1: int = baq_conn()
    if h1 < 0 {
        return 0
    }
    if !zone_exists_h(h1, id) {
        kv_close(h1)
        return 0
    }
    let zname: String = kv_get(h1, zone_meta_key(id))
    let curimg: String = kv_get(h1, zone_img_key(id))
    let sites: Array = kv_lrange(h1, zone_sites_key(id), 0, -1)
    kv_close(h1)
    var filled: int = 0
    var newzimg: String = curimg
    if force == 1 or curimg.length() == 0 {
        var q: String = zname
        if q.length() == 0 {
            q = id
        }
        let zi: String = wiki_image(q)
        if zi.length() > 0 {
            newzimg = zi
        }
    }
    var rebuilt: Array = []
    var changed: bool = false
    var j: int = 0
    while j < sites.length() {
        let e: String = sites[j]
        let f: Array = site_split4(e)
        let nm: String = f[0]
        let cat: String = f[1]
        let desc: String = f[2]
        var img: String = f[3]
        if force == 1 or img.length() == 0 {
            let found: String = wiki_image(nm)
            if found.length() > 0 {
                img = found
                changed = true
                filled = filled + 1
            }
        }
        rebuilt.push(nm + "|" + cat + "|" + desc + "|" + img)
        j = j + 1
    }
    let h2: int = baq_conn()
    if h2 >= 0 {
        if newzimg != curimg and newzimg.length() > 0 {
            kv_set(h2, zone_img_key(id), newzimg)
            filled = filled + 1
        }
        if changed {
            kv_del(h2, zone_sites_key(id))
            var k: int = 0
            while k < rebuilt.length() {
                let s2: String = rebuilt[k]
                kv_rpush(h2, zone_sites_key(id), s2)
                k = k + 1
            }
        }
        kv_close(h2)
    }
    return filled
}

// Rellena TODAS las zonas (best-effort; se usa desde el hilo de fondo). Itera zona a zona.
pub fn baquiano_fetch_images(force: int) -> int {
    let h0: int = baq_conn()
    if h0 < 0 {
        return 0
    }
    let ids: Array = zones_list_h(h0)
    kv_close(h0)
    var filled: int = 0
    var i: int = 0
    while i < ids.length() {
        let id: String = ids[i]
        filled = filled + baquiano_fetch_zone(id, force)
        i = i + 1
    }
    return filled
}

fn baq_fetch_worker() -> int {
    baquiano_fetch_images(0)
    return 0
}

fn baq_fetch_worker_force() -> int {
    baquiano_fetch_images(1)
    return 0
}

// Lanza el relleno de imagenes en un hilo (no bloquea el request del admin).
pub fn baquiano_fetch_start(force: int) {
    if force == 1 {
        thread_spawn(baq_fetch_worker_force)
    } else {
        thread_spawn(baq_fetch_worker)
    }
}

fn render_site_entry(entry: String, zone_label: String) -> String {
    let f: Array = site_split4(entry)
    let nm: String = f[0]
    let cat: String = f[1]
    let desc: String = f[2]
    let img: String = f[3]
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<div class=\"baq-site\">")
    if img.length() > 0 {
        sb.append("<img class=\"baq-site-img\" loading=\"lazy\" alt=\"")
        sb.append(attr_escape(nm))
        sb.append("\" src=\"")
        sb.append(attr_escape(img))
        sb.append("\">")
    }
    sb.append("<div class=\"baq-site-body\">")
    sb.append("<div class=\"baq-site-head\"><h3>")
    sb.append(html_escape(nm))
    sb.append("</h3>")
    if cat.length() > 0 {
        sb.append("<span class=\"baq-cat\">")
        sb.append(html_escape(cat))
        sb.append("</span>")
    }
    sb.append("</div>")
    if desc.length() > 0 {
        sb.append("<p>")
        sb.append(html_escape(desc))
        sb.append("</p>")
    }
    sb.append("<div class=\"baq-links\"><a class=\"baq-map\" href=\"")
    sb.append(maps_url(nm, zone_label))
    sb.append("\" target=\"_blank\" rel=\"noopener\">&#128205; Ver en Google Maps (rese&ntilde;as y fotos)</a>")
    sb.append("<a class=\"baq-hotels\" href=\"")
    sb.append("https://www.google.com/maps/search/?api=1&query=")
    sb.append(baq_urlenc("hoteles cerca de " + nm + ", " + zone_label + ", Venezuela"))
    sb.append("\" target=\"_blank\" rel=\"noopener\">&#127976; Hoteles cerca</a></div>")
    sb.append("</div></div>\n")
    return sb.to_string()
}

// ── Render publico ───────────────────────────────────────────────────────────

// Indice: rejilla de zonas (estados) con su conteo de sitios.
pub fn render_baquiano_index() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"baquiano\">\n")
    sb.append("<p><a href=\"/\">&larr; Volver al inicio</a></p>\n")
    sb.append("<h1>Baquiano &mdash; guia de sitios</h1>\n")
    sb.append("<p class=\"lede\">Lugares recomendados de Venezuela, organizados por zona. Un baquiano conoce el camino.</p>\n")
    let h: int = baq_conn()
    if h < 0 {
        sb.append("<p class=\"hint\">La guia no esta disponible ahora mismo.</p>\n</section>\n")
        return sb.to_string()
    }
    let ids: Array = zones_list_h(h)
    if ids.length() == 0 {
        sb.append("<p class=\"hint\">Todavia no hay zonas publicadas. Vuelve pronto.</p>\n")
    } else {
        sb.append("<div class=\"baq-zones\">\n")
        var i: int = 0
        while i < ids.length() {
            let id: String = ids[i]
            let nm: String = kv_get(h, zone_meta_key(id))
            let sites: Array = kv_lrange(h, zone_sites_key(id), 0, -1)
            var label: String = nm
            if label.length() == 0 {
                label = id
            }
            sb.append("<a class=\"baq-zone-card\" href=\"/baquiano/")
            sb.append(id)
            sb.append("\"><span class=\"baq-zone-name\">")
            sb.append(html_escape(label))
            sb.append("</span><span class=\"baq-zone-count\">")
            sb.append(int_to_string(sites.length()))
            sb.append(" sitios</span></a>\n")
            i = i + 1
        }
        sb.append("</div>\n")
    }
    kv_close(h)
    sb.append("</section>\n")
    return sb.to_string()
}

// Panorama (desc con \n) -> parrafos.
fn render_desc_html(desc: String) -> String {
    if desc.length() == 0 {
        return ""
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<div class=\"baq-desc\">\n")
    // Los parrafos van separados por el centinela "~~P~~" (NO por \n real: el
    // cliente nyx-kv trunca valores con salto de linea al escribir).
    let lines: Array = desc.split("~~P~~")
    var i: int = 0
    while i < lines.length() {
        let ln: String = lines[i]
        let t: String = md_trim(ln)
        if t.length() > 0 {
            sb.append("<p>")
            sb.append(html_escape(t))
            sb.append("</p>\n")
        }
        i = i + 1
    }
    sb.append("</div>\n")
    return sb.to_string()
}

// Datos practicos (etiqueta|valor) -> lista de definiciones.
fn render_facts_html(facts: Array) -> String {
    if facts.length() == 0 {
        return ""
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<h2>Datos practicos</h2>\n<dl class=\"baq-facts\">\n")
    var i: int = 0
    while i < facts.length() {
        let e: String = facts[i]
        let p: int = e.indexOf("|")
        var lb: String = e
        var vl: String = ""
        if p >= 0 {
            lb = e.substring(0, p)
            vl = e.substring(p + 1, e.length())
        }
        sb.append("<dt>")
        sb.append(html_escape(lb))
        sb.append("</dt><dd>")
        sb.append(html_escape(vl))
        sb.append("</dd>\n")
        i = i + 1
    }
    sb.append("</dl>\n")
    return sb.to_string()
}

// Municipios (nombre|capital) -> tabla.
fn render_munis_html(munis: Array) -> String {
    if munis.length() == 0 {
        return ""
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<h2>Municipios</h2>\n<table class=\"baq-muni\"><thead><tr><th>Municipio</th><th>Capital</th></tr></thead><tbody>\n")
    var i: int = 0
    while i < munis.length() {
        let e: String = munis[i]
        let p: int = e.indexOf("|")
        var mn: String = e
        var mc: String = ""
        if p >= 0 {
            mn = e.substring(0, p)
            mc = e.substring(p + 1, e.length())
        }
        sb.append("<tr><td>")
        sb.append(html_escape(mn))
        sb.append("</td><td>")
        sb.append(html_escape(mc))
        sb.append("</td></tr>\n")
        i = i + 1
    }
    sb.append("</tbody></table>\n")
    return sb.to_string()
}

// Directorio de centros poblados (municipio|localidades) -> bloque colapsable.
fn render_poblados_html(poblados: Array) -> String {
    if poblados.length() == 0 {
        return ""
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<details class=\"baq-poblados\"><summary>Directorio de centros poblados</summary>\n")
    var i: int = 0
    while i < poblados.length() {
        let e: String = poblados[i]
        let p: int = e.indexOf("|")
        var mu: String = e
        var lo: String = ""
        if p >= 0 {
            mu = e.substring(0, p)
            lo = e.substring(p + 1, e.length())
        }
        sb.append("<p><strong>")
        sb.append(html_escape(mu))
        sb.append("</strong>: ")
        sb.append(html_escape(lo))
        sb.append("</p>\n")
        i = i + 1
    }
    sb.append("</details>\n")
    return sb.to_string()
}

// Pagina de una zona: cabecera + panorama + datos + municipios + destinos + directorio.
// Devuelve "" si la zona no existe.
pub fn render_baquiano_zone(id_raw: String) -> String {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return ""
    }
    let h: int = baq_conn()
    if h < 0 {
        return ""
    }
    if !zone_exists_h(h, id) {
        kv_close(h)
        return ""
    }
    let nm: String = kv_get(h, zone_meta_key(id))
    let capital: String = kv_get(h, zone_capital_key(id))
    let desc: String = kv_get(h, zone_desc_key(id))
    let img: String = kv_get(h, zone_img_key(id))
    let facts: Array = kv_lrange(h, zone_facts_key(id), 0, -1)
    let munis: Array = kv_lrange(h, zone_munis_key(id), 0, -1)
    let sites: Array = kv_lrange(h, zone_sites_key(id), 0, -1)
    let poblados: Array = kv_lrange(h, zone_poblados_key(id), 0, -1)
    kv_close(h)
    var label: String = nm
    if label.length() == 0 {
        label = id
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"baquiano baquiano-zone\">\n")
    sb.append("<p><a href=\"/baquiano\">&larr; Todas las zonas</a></p>\n")
    if img.length() > 0 {
        sb.append("<img class=\"baq-hero\" loading=\"lazy\" alt=\"")
        sb.append(attr_escape(label))
        sb.append("\" src=\"")
        sb.append(attr_escape(img))
        sb.append("\">\n")
    }
    sb.append("<h1>")
    sb.append(html_escape(label))
    sb.append("</h1>\n")
    if capital.length() > 0 {
        sb.append("<p class=\"baq-capital\">Capital: <strong>")
        sb.append(html_escape(capital))
        sb.append("</strong></p>\n")
    }
    sb.append("<p class=\"baq-zone-links\"><a class=\"baq-hotels\" href=\"")
    sb.append(hotels_url(label))
    sb.append("\" target=\"_blank\" rel=\"noopener\">&#127976; Hoteles en ")
    sb.append(html_escape(label))
    sb.append("</a></p>\n")
    sb.append(render_desc_html(desc))
    // Destinos turisticos (sitios)
    if sites.length() > 0 {
        sb.append("<h2>Destinos turisticos</h2>\n<div class=\"baq-sites\">\n")
        var i: int = 0
        while i < sites.length() {
            let entry: String = sites[i]
            sb.append(render_site_entry(entry, label))
            i = i + 1
        }
        sb.append("</div>\n")
    }
    sb.append(render_facts_html(facts))
    sb.append(render_munis_html(munis))
    sb.append(render_poblados_html(poblados))
    if sites.length() == 0 and desc.length() == 0 and facts.length() == 0 {
        sb.append("<p class=\"hint\">Aun no hay informacion en esta zona.</p>\n")
    }
    if img.length() > 0 {
        sb.append("<p class=\"baq-credit\">Im&aacute;genes: <a href=\"https://commons.wikimedia.org\" target=\"_blank\" rel=\"noopener\">Wikimedia Commons</a>.</p>\n")
    }
    sb.append("</section>\n")
    return sb.to_string()
}

// Tarjeta de la portada: enlaza a /baquiano y muestra algunas zonas como chips.
pub fn baquiano_card() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<a class=\"baq-card\" href=\"/baquiano\">")
    sb.append("<div class=\"baq-card-head\"><span class=\"baq-card-ico\">&#128205;</span><h2>Baquiano</h2></div>")
    sb.append("<p class=\"baq-card-sub\">Guia de sitios de Venezuela por zona.</p>")
    let h: int = baq_conn()
    if h >= 0 {
        let ids: Array = zones_list_h(h)
        if ids.length() > 0 {
            sb.append("<div class=\"baq-card-chips\">")
            var i: int = 0
            var shown: int = 0
            while i < ids.length() and shown < 6 {
                let id: String = ids[i]
                let nm: String = kv_get(h, zone_meta_key(id))
                var label: String = nm
                if label.length() == 0 {
                    label = id
                }
                sb.append("<span class=\"baq-chip\">")
                sb.append(html_escape(label))
                sb.append("</span>")
                shown = shown + 1
                i = i + 1
            }
            sb.append("</div>")
        }
        kv_close(h)
    }
    sb.append("<span class=\"baq-card-cta\">Explorar la guia &rarr;</span>")
    sb.append("</a>")
    return sb.to_string()
}
