// src/chat.nx — chat colectivo con SALAS: guarda/lee mensajes en nyx-kv (RESP2+TLS).
// Moderacion: saneo (quita | y control), topes de longitud, filtro de groserias,
// cupo de ritmo por sala. Token dedicado (NO admin) para aislar el namespace.
//
// Salas: la sala "general" usa la clave legacy "chat:msgs" (no perder historial);
// el resto usan "chat:room:<id>:msgs". El indice de salas creadas por el admin vive
// en la lista "chat:rooms" con entradas "id|nombre". Solo el admin crea/borra salas.

import "src/kv"
import "src/md"
import "src/articles"
import "src/ws"

// nyx_url_decode (percent %XX + '+') viene de std/web (import en main.nx); el scope
// global plano lo hace visible aqui. NO redeclarar el extern: duplicarlo con el de
// std/web da "invalid redefinition of function 'nyx_url_decode'" en el link.

const KV_HOST: String = "127.0.0.1"
const KV_PORT: int = 6380

// Mutex del cupo de ritmo: el GET->computar->SET de chat_post no es atómico y
// los 16 workers de nyx-serve son HILOS de este mismo proceso — sin esto, N
// POSTs paralelos leen el mismo "count|inicio" y el contador subcuenta justo
// bajo flood. Mismo patrón holder+init que WS_MU (src/ws.nx).
var CHAT_RL_MU: Map = Map.new()
var CHAT_RL_READY: int = 0

// Llamar una vez desde main() antes de servir (crea el mutex).
pub fn chat_init() {
    if CHAT_RL_READY == 1 {
        return
    }
    CHAT_RL_MU = mutex_new()
    CHAT_RL_READY = 1
}

// true si s no está vacío y son solo dígitos. string_to_int ABORTA el proceso
// con entrada no numérica (runtime/strings.c), y el valor viene de nyx-kv, que
// ya ha sufrido corrupción/pérdida: nunca parsearlo sin validar. pub: también
// lo usa src/push.nx (tasa_2dec, valores de nyx-db).
pub fn all_digits(s: String) -> bool {
    let n: int = s.length()
    if n == 0 {
        return false
    }
    var i: int = 0
    while i < n {
        let c: String = s.substring(i, i + 1)
        if "0123456789".indexOf(c) < 0 {
            return false
        }
        i = i + 1
    }
    return true
}

// Extrae un campo de un body x-www-form-urlencoded y lo decodifica.
pub fn form_field(body: String, key: String) -> String {
    let pairs: Array = body.split("&")
    var i: int = 0
    while i < pairs.length() {
        let pair: String = pairs[i]
        let eq: int = pair.indexOf("=")
        if eq > 0 {
            let k: String = pair.substring(0, eq)
            if k == key {
                let v: String = pair.substring(eq + 1, pair.length())
                return nyx_url_decode(v)
            }
        }
        i = i + 1
    }
    return ""
}

// Token del chat: env NYXKV_CHAT_TOKEN o el archivo dedicado (fuera del repo).
fn chat_token() -> String {
    let e: String = getenv("NYXKV_CHAT_TOKEN")
    if e.length() > 0 {
        return md_trim(e)
    }
    let f: String = read_file("/home/admin/.veninfo-chat-token")
    return md_trim(f)
}

pub fn chat_conn() -> int {
    return kv_connect_auth(KV_HOST, KV_PORT, chat_token())
}

// Quita '|' y caracteres de control (los pasa a espacio), recorta y limita.
fn sanitize(s: String, maxb: int) -> String {
    var sb: StringBuilder = StringBuilder.new()
    let n: int = s.length()
    var i: int = 0
    while i < n {
        let c: int = s.charAt(i)
        if c == 124 or c < 32 {
            sb.append(" ")
        } else {
            sb.append(s.substring(i, i + 1))
        }
        i = i + 1
    }
    var out: String = md_trim(sb.to_string())
    if out.length() > maxb {
        out = out.substring(0, maxb)
    }
    return out
}

// Filtro de groserias basico (formas en minuscula -> asteriscos).
fn censor(s: String) -> String {
    var o: String = s.replace("mierda", "******")
    o = o.replace("puta", "****")
    o = o.replace("puto", "****")
    o = o.replace("coño", "****")
    o = o.replace("marico", "******")
    o = o.replace("marica", "******")
    o = o.replace("verga", "*****")
    o = o.replace("carajo", "******")
    return o
}

// Escapa para JSON ("/\\ y comillas). El control ya se elimino en sanitize.
fn json_esc(s: String) -> String {
    var o: String = s.replace("\\", "\\\\")
    o = o.replace("\"", "\\\"")
    return o
}

// ── Salas ────────────────────────────────────────────────────────────────────

// Clave de la lista de mensajes de una sala. "general" -> clave legacy.
fn room_msgs_key(room: String) -> String {
    if room == "general" {
        return "chat:msgs"
    }
    return "chat:room:" + room + ":msgs"
}

// Clave del cupo de ritmo por sala.
fn room_rl_key(room: String) -> String {
    return "chat:rl:" + room
}

// Lee el indice crudo de salas creadas por el admin ("id|nombre" por entrada).
fn rooms_raw(h: int) -> Array {
    return kv_lrange(h, "chat:rooms", 0, -1)
}

// Devuelve true si la sala existe (general siempre existe; el resto en chat:rooms).
fn room_exists_h(h: int, room: String) -> bool {
    if room == "general" {
        return true
    }
    let raw: Array = rooms_raw(h)
    var i: int = 0
    while i < raw.length() {
        let entry: String = raw[i]
        let bar: int = entry.indexOf("|")
        var id: String = entry
        if bar >= 0 {
            id = entry.substring(0, bar)
        }
        if id == room {
            return true
        }
        i = i + 1
    }
    return false
}

// Sala valida para postear/leer: slug seguro + existente.
fn valid_room(h: int, room: String) -> bool {
    if !is_valid_slug(room) {
        return false
    }
    return room_exists_h(h, room)
}

// Lista publica de salas como JSON [{"id":..,"n":..}]. Incluye "general" primero.
pub fn chat_rooms_json() -> String {
    let h: int = chat_conn()
    var sb: StringBuilder = StringBuilder.new()
    sb.append("[{\"id\":\"general\",\"n\":\"General\"}")
    if h < 0 {
        sb.append("]")
        return sb.to_string()
    }
    let raw: Array = rooms_raw(h)
    kv_close(h)
    var i: int = 0
    while i < raw.length() {
        let entry: String = raw[i]
        let bar: int = entry.indexOf("|")
        if bar > 0 {
            let id: String = entry.substring(0, bar)
            let nm: String = entry.substring(bar + 1, entry.length())
            sb.append(",{\"id\":\"")
            sb.append(json_esc(id))
            sb.append("\",\"n\":\"")
            sb.append(json_esc(nm))
            sb.append("\"}")
        }
        i = i + 1
    }
    sb.append("]")
    return sb.to_string()
}

// Lista de salas para el panel admin: Array de "id|nombre" (sin general).
pub fn chat_rooms_list() -> Array {
    let h: int = chat_conn()
    if h < 0 {
        var empty: Array = []
        return empty
    }
    let raw: Array = rooms_raw(h)
    kv_close(h)
    return raw
}

// Crea una sala (solo admin). Devuelve "" si OK o el texto del error.
pub fn room_create(id_raw: String, name_raw: String) -> String {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) {
        return "Identificador invalido (solo minusculas, numeros y guiones)"
    }
    if id == "general" {
        return "Esa sala ya existe"
    }
    var nm: String = sanitize(name_raw, 40)
    if nm.length() == 0 {
        nm = id
    }
    let h: int = chat_conn()
    if h < 0 {
        return "Chat no disponible"
    }
    if room_exists_h(h, id) {
        kv_close(h)
        return "Esa sala ya existe"
    }
    kv_rpush(h, "chat:rooms", id + "|" + nm)
    kv_close(h)
    return ""
}

// Borra una sala y sus mensajes (solo admin). No se puede borrar "general".
pub fn room_delete(id_raw: String) -> bool {
    let id: String = md_trim(id_raw)
    if !is_valid_slug(id) or id == "general" {
        return false
    }
    let h: int = chat_conn()
    if h < 0 {
        return false
    }
    let raw: Array = rooms_raw(h)
    // Reconstruye la lista sin la sala borrada (nyx-kv no garantiza LREM).
    var survivors: Array = []
    var found: bool = false
    var i: int = 0
    while i < raw.length() {
        let entry: String = raw[i]
        let bar: int = entry.indexOf("|")
        var eid: String = entry
        if bar >= 0 {
            eid = entry.substring(0, bar)
        }
        if eid == id {
            found = true
        } else {
            survivors.push(entry)
        }
        i = i + 1
    }
    kv_del(h, "chat:rooms")
    var j: int = 0
    while j < survivors.length() {
        let s: String = survivors[j]
        kv_rpush(h, "chat:rooms", s)
        j = j + 1
    }
    kv_del(h, room_msgs_key(id))
    kv_close(h)
    return found
}

// Vacia los mensajes de una sala (moderacion, solo admin).
pub fn chat_room_clear(room_raw: String) -> bool {
    let room: String = md_trim(room_raw)
    if !is_valid_slug(room) {
        return false
    }
    let h: int = chat_conn()
    if h < 0 {
        return false
    }
    kv_del(h, room_msgs_key(room))
    kv_close(h)
    return true
}

// ── Publicar / leer mensajes ─────────────────────────────────────────────────

// Publica un mensaje en una sala. Devuelve "" si OK, o el texto del error.
pub fn chat_post(room_raw: String, nick_raw: String, texto_raw: String) -> String {
    let room: String = md_trim(room_raw)
    let texto: String = censor(sanitize(texto_raw, 280))
    if texto.length() == 0 {
        return "Mensaje vacio"
    }
    var nick: String = sanitize(nick_raw, 24)
    if nick.length() == 0 {
        nick = "Anonimo"
    }
    let h: int = chat_conn()
    if h < 0 {
        return "Chat no disponible"
    }
    if !valid_room(h, room) {
        kv_close(h)
        return "Sala no valida"
    }
    // cupo de ritmo por sala: max ~25 mensajes por ventana de 10s. Ventana por
    // timestamp en el propio valor ("count|inicio") para NO depender de EXPIRE:
    // nyx-kv puede tener EXPIRE roto (deja TTL -1) y un INCR+EXPIRE dejaría el
    // contador atascado -> "Demasiados mensajes" permanente. GET/SET bajo
    // CHAT_RL_MU (la atomicidad del INCR se recupera con el mutex: los workers
    // son hilos de este proceso). Un valor corrupto se descarta (all_digits)
    // en vez de abortar el proceso con string_to_int.
    let rlk: String = room_rl_key(room)
    let now: int = time()
    var cnt: int = 1
    var win: String = int_to_string(now)   // inicio de ventana a persistir
    mutex_lock(CHAT_RL_MU)
    let raw: String = kv_get(h, rlk)
    if raw.length() > 0 {
        let bar: int = raw.indexOf("|")
        if bar > 0 {
            let cs: String = raw.substring(0, bar)
            let ss: String = raw.substring(bar + 1, raw.length())
            if all_digits(cs) and all_digits(ss) {
                let start: int = string_to_int(ss)
                if now - start < 10 {
                    cnt = string_to_int(cs) + 1
                    win = ss
                }
            }
        }
    }
    kv_set(h, rlk, int_to_string(cnt) + "|" + win)
    kv_expire(h, rlk, 600)   // limpieza best-effort; si EXPIRE funciona, la clave se va sola
    mutex_unlock(CHAT_RL_MU)
    if cnt > 25 {
        kv_close(h)
        return "Demasiados mensajes ahora mismo, espera unos segundos"
    }
    let ts: String = int_to_string(time())
    let val: String = ts + "|" + nick + "|" + texto
    kv_rpush(h, room_msgs_key(room), val)
    kv_ltrim(h, room_msgs_key(room), -200, -1)
    kv_close(h)
    // Empuja el mensaje a los WebSocket suscritos a la sala (mismo shape que
    // los items de /api/chat: {t,n,m}).
    var wsb: StringBuilder = StringBuilder.new()
    wsb.append("{\"t\":")
    wsb.append(ts)
    wsb.append(",\"n\":\"")
    wsb.append(json_esc(nick))
    wsb.append("\",\"m\":\"")
    wsb.append(json_esc(texto))
    wsb.append("\"}")
    ws_broadcast(room, wsb.to_string())
    return ""
}

// Handler del upgrade WebSocket (registrado con serve_ws en main). info =
// [fd, path, headers_flat]. Path esperado: /ws/chat/<sala> (o /ws/chat ->
// general). Valida la sala contra nyx-kv antes de aceptar. Devuelve 1 si el
// fd queda en manos de src/ws, 0 para que nyx-serve cierre la conexion.
pub fn chat_ws_handler(info: Array) -> int {
    let fd: int = info[0]
    var path: String = info[1]
    let headers: Array = info[2]
    let qp: int = path.indexOf("?")
    if qp >= 0 {
        path = path.substring(0, qp)
    }
    var room: String = "general"
    let pre: String = "/ws/chat/"
    if path.indexOf(pre) == 0 and path.length() > pre.length() {
        room = path.substring(pre.length(), path.length())
    } else {
        if path != "/ws/chat" {
            tcp_write(fd, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
            return 0
        }
    }
    let h: int = chat_conn()
    if h < 0 {
        tcp_write(fd, "HTTP/1.1 503 Service Unavailable\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        return 0
    }
    let ok: bool = valid_room(h, room)
    kv_close(h)
    if !ok {
        tcp_write(fd, "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        return 0
    }
    return ws_accept(fd, room, headers)
}

// Devuelve los ultimos 50 mensajes de una sala como JSON [{t,n,m}].
pub fn chat_list_json(room_raw: String) -> String {
    let room: String = md_trim(room_raw)
    let h: int = chat_conn()
    if h < 0 {
        return "[]"
    }
    if !valid_room(h, room) {
        kv_close(h)
        return "[]"
    }
    let rows: Array = kv_lrange(h, room_msgs_key(room), -50, -1)
    kv_close(h)
    var sb: StringBuilder = StringBuilder.new()
    sb.append("[")
    var i: int = 0
    var first: bool = true
    while i < rows.length() {
        let row: String = rows[i]
        let p1: int = row.indexOf("|")
        if p1 > 0 {
            let ts: String = row.substring(0, p1)
            let rest: String = row.substring(p1 + 1, row.length())
            let p2: int = rest.indexOf("|")
            var nick: String = rest
            var texto: String = ""
            if p2 >= 0 {
                nick = rest.substring(0, p2)
                texto = rest.substring(p2 + 1, rest.length())
            }
            if !first {
                sb.append(",")
            }
            first = false
            sb.append("{\"t\":")
            sb.append(ts)
            sb.append(",\"n\":\"")
            sb.append(json_esc(nick))
            sb.append("\",\"m\":\"")
            sb.append(json_esc(texto))
            sb.append("\"}")
        }
        i = i + 1
    }
    sb.append("]")
    return sb.to_string()
}

// Sala EFECTIVA de un body de POST /api/chat/send: default general + el mismo
// md_trim que aplica chat_post. Único parser de la sala — lo usa también
// handle_chat_send (main.nx) para push_chat_mark: si divergieran, el push
// marcaría claves meta fantasma (" general") con throttle propio.
pub fn chat_body_room(body: String) -> String {
    var room: String = form_field(body, "room")
    if room.length() == 0 {
        room = "general"
    }
    return md_trim(room)
}

// Recibe el body crudo del POST /api/chat/send, extrae room/nick/texto y publica.
// Devuelve "" si OK o el texto del error. Sala por defecto: general.
pub fn chat_send_body(body: String) -> String {
    let nick: String = form_field(body, "nick")
    let texto: String = form_field(body, "texto")
    return chat_post(chat_body_room(body), nick, texto)
}
