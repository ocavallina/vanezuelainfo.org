// src/rates.nx — Histórico de tasas de cambio en nyx-db (SQL en Nyx, embebido).
//
// El servidor toma un snapshot de las 3 tasas del calculador (Dólar BCV, Euro BCV,
// Dólar Binance P2P) desde el refresher_worker (cada 30 min) y guarda el valor de
// "cierre" del día en la tabla `rates` (day, kind, value). La sección "Histórico"
// de /finanzas se pinta server-side leyendo con SELECT + agregados (MIN/MAX/AVG).
//
// Gotcha respetado: NO se usa std/json (histórico de truncado de floats); las tasas
// se extraen con scanners de string mínimos. Toda celda que devuelve nyx-db es String.

import "src/sqldb"
import "src/news"
import "src/bcv"

// Float -> "entero,frac" (2 decimales, coma) para MOSTRAR. Redondea.
fn fmt2(v: float) -> String {
    var x: float = v
    if x < 0.0 { x = 0.0 - x }
    let cents: int = float_to_int(x * 100.0 + 0.5)
    let whole: int = cents / 100
    let frac: int = cents % 100
    var fs: String = int_to_string(frac)
    if frac < 10 { fs = "0" + fs }
    var out: String = int_to_string(whole) + "," + fs
    if v < 0.0 { out = "-" + out }
    return out
}

// Float -> "entero.frac" (2 decimales, PUNTO) para GUARDAR en SQL (numérico).
fn dec2(v: float) -> String {
    var x: float = v
    if x < 0.0 { x = 0.0 - x }
    let cents: int = float_to_int(x * 100.0 + 0.5)
    let whole: int = cents / 100
    let frac: int = cents % 100
    var fs: String = int_to_string(frac)
    if frac < 10 { fs = "0" + fs }
    return int_to_string(whole) + "." + fs
}

// Lee el número que sigue a "key": dentro de `s` (desde la primera aparición).
fn rt_num(s: String, key: String) -> String {
    let kq: String = "\"" + key + "\""
    let ki: int = s.indexOf(kq)
    if ki < 0 { return "" }
    var i: int = ki + kq.length()
    let n: int = s.length()
    while i < n and s.substring(i, i + 1) != ":" { i = i + 1 }
    if i >= n { return "" }
    i = i + 1
    while i < n and s.substring(i, i + 1) == " " { i = i + 1 }
    let start: int = i
    var go: bool = true
    while i < n and go {
        let c: String = s.substring(i, i + 1)
        if c == "," or c == "}" or c == "]" or c == " " or c == "\n" or c == "\r" {
            go = false
        } else {
            i = i + 1
        }
    }
    if i == start { return "" }
    let tok: String = s.substring(start, i)
    if tok == "null" { return "" }
    return tok
}

// Extrae "promedio" del objeto "oficial" de una respuesta DolarAPI (array).
fn dolarapi_oficial(body: String) -> String {
    let p: int = body.indexOf("\"oficial\"")
    if p < 0 { return "" }
    return rt_num(body.substring(p, body.length()), "promedio")
}

// Upsert del valor de una tasa para el día `ds` (borra + inserta; escritura del
// refresher, single-thread). `val` es un token numérico (dígitos/./-): sin comillas
// ni riesgo de inyección; `kind` es un literal fijo del código.
fn rate_put(ds: String, kind: String, val: String) {
    sql_exec("DELETE FROM rates WHERE day = " + ds + " AND kind = '" + kind + "'")
    sql_exec("INSERT INTO rates VALUES (" + ds + ", '" + kind + "', " + val + ")")
}

// Snapshot de las 3 tasas -> tabla rates. Llamado desde el refresher_worker.
// Si una fuente falla, se salta ESA tasa (no borra días previos).
pub fn rates_snapshot() {
    let d: int = db_day()
    let ds: String = int_to_string(d)

    // BCV DIRECTO (dólar/euro), guardado por FECHA VALOR (day = ordinal de vigencia).
    // Respaldo a DolarAPI si BCV falla o no parsea (sin fecha valor -> día de hoy).
    let b: Array = bcv_fetch()
    let bdolar: String = b[0]
    let beuro: String = b[1]
    let bord: int = b[2]
    if bdolar.length() > 0 and bord > 0 {
        let os: String = int_to_string(bord)
        rate_put(os, "bcv", bdolar)
        if beuro.length() > 0 { rate_put(os, "eur", beuro) }
    } else {
        let bd: String = https_get("https://ve.dolarapi.com/v1/dolares")
        if bd.length() > 0 {
            let bcv: String = dolarapi_oficial(bd)
            if bcv.length() > 0 { rate_put(ds, "bcv", bcv) }
        }
        let ed: String = https_get("https://ve.dolarapi.com/v1/euros")
        if ed.length() > 0 {
            let eur: String = dolarapi_oficial(ed)
            if eur.length() > 0 { rate_put(ds, "eur", eur) }
        }
    }
    let cd: String = https_get("https://criptoya.com/api/USDT/VES/1")
    if cd.length() > 0 {
        let seg0: int = cd.indexOf("\"binancep2p\"")
        if seg0 >= 0 {
            let seg: String = cd.substring(seg0, cd.length())
            let ask: String = rt_num(seg, "ask")
            let bid: String = rt_num(seg, "bid")
            if ask.length() > 0 and bid.length() > 0 {
                let avg: float = (string_to_float(ask) + string_to_float(bid)) / 2.0
                rate_put(ds, "bin", dec2(avg))
            }
        }
    }

    // Marca de "última actualización" (tabla meta).
    sql_exec("DELETE FROM meta WHERE k = 'rates_upd'")
    sql_exec("INSERT INTO meta VALUES ('rates_upd', '" + int_to_string(time()) + "')")
    // Retención: ~30 días.
    sql_exec("DELETE FROM rates WHERE day < " + int_to_string(d - 30))
}

// Celda [j] de la fila de datos [i] (i>=1 salta el header) como String.
fn cell(rows: Array, i: int, j: int) -> String {
    let row: Array = rows[i]
    let s: String = row[j]
    return s
}

// Parseo seguro: nyx-db devuelve "__NULL__" para NULL (p.ej. agregado vacío).
fn sf(s: String) -> float {
    if s.length() == 0 { return 0.0 }
    if s == "__NULL__" { return 0.0 }
    return string_to_float(s)
}

// Valor de una tasa para un día (ordinal) exacto. "" si no hay.
fn rate_on(kind: String, day: int) -> String {
    if day == 0 {
        return ""
    }
    let rows: Array = sql_rows("SELECT value FROM rates WHERE kind = '" + kind + "' AND day = " + int_to_string(day))
    if rows.length() < 2 {
        return ""
    }
    let v: String = cell(rows, 1, 0)
    if v == "__NULL__" {
        return ""
    }
    return v
}

// Valor más reciente de una tasa (mayor day de los últimos ~8 días). "" si no hay.
fn rate_latest(kind: String) -> String {
    let lo: String = int_to_string(db_day() - 8)
    let rows: Array = sql_rows("SELECT day, value FROM rates WHERE kind = '" + kind + "' AND day > " + lo)
    var best: int = 0
    var val: String = ""
    var i: int = 1
    while i < rows.length() {
        let dy: int = string_to_int(cell(rows, i, 0))
        if dy >= best {
            best = dy
            val = cell(rows, i, 1)
        }
        i = i + 1
    }
    return val
}

// JSON para GET /api/rates que consume el front (wasm): tasa BCV que aplica HOY
// (fecha valor <= hoy, la más reciente) y la PRÓXIMA (fecha valor > hoy, si está
// publicada), cada una con dólar/euro y su fecha; más Binance (bin). Números sin
// comillas (0 si faltan); fecha entre comillas.
pub fn rates_api_json() -> String {
    let today: int = db_day()
    let lo: String = int_to_string(today - 8)
    let rows: Array = sql_rows("SELECT day, value FROM rates WHERE kind = 'bcv' AND day > " + lo)
    var hoy_day: int = 0
    var hoy_bcv: String = ""
    var prox_day: int = 0
    var prox_bcv: String = ""
    var i: int = 1
    while i < rows.length() {
        let dy: int = string_to_int(cell(rows, i, 0))
        let vv: String = cell(rows, i, 1)
        if dy <= today {
            if dy >= hoy_day {
                hoy_day = dy
                hoy_bcv = vv
            }
        } else {
            if prox_day == 0 or dy < prox_day {
                prox_day = dy
                prox_bcv = vv
            }
        }
        i = i + 1
    }
    var hoy_eur: String = rate_on("eur", hoy_day)
    var prox_eur: String = rate_on("eur", prox_day)
    if hoy_bcv.length() == 0 { hoy_bcv = "0" }
    if hoy_eur.length() == 0 { hoy_eur = "0" }
    let bin: String = rate_latest("bin")
    var binv: String = bin
    if binv.length() == 0 { binv = "0" }

    var sb: StringBuilder = StringBuilder.new()
    sb.append("{\"hoy\":{\"bcv\":")
    sb.append(hoy_bcv)
    sb.append(",\"eur\":")
    sb.append(hoy_eur)
    sb.append(",\"fecha\":\"")
    if hoy_day > 0 { sb.append(ord_to_iso(hoy_day)) }
    sb.append("\"}")
    if prox_day > 0 and prox_bcv.length() > 0 {
        if prox_eur.length() == 0 { prox_eur = "0" }
        sb.append(",\"prox\":{\"bcv\":")
        sb.append(prox_bcv)
        sb.append(",\"eur\":")
        sb.append(prox_eur)
        sb.append(",\"fecha\":\"")
        sb.append(ord_to_iso(prox_day))
        sb.append("\"}")
    }
    sb.append(",\"bin\":")
    sb.append(binv)
    sb.append("}")
    return sb.to_string()
}

// Un mini-gráfico (hasta 14 días) para una tasa (`kind` = literal fijo).
fn rate_chart(kind: String, name: String) -> String {
    let d0: int = db_day()
    let lo: String = int_to_string(d0 - 14)
    let rows: Array = sql_rows("SELECT value FROM rates WHERE kind = '" + kind + "' AND day > " + lo + " ORDER BY day ASC")
    let cnt: int = rows.length() - 1  // menos el header

    var sb: StringBuilder = StringBuilder.new()
    sb.append("<div class=\"rate-chart\">")
    if cnt < 2 {
        sb.append("<div class=\"rate-head\"><b>" + name + "</b></div>")
        sb.append("<p class=\"rate-wait\">Reuniendo datos del hist&oacute;rico&hellip;</p></div>")
        return sb.to_string()
    }

    let last: int = rows.length() - 1
    let cur: float = sf(cell(rows, last, 0))
    let old: float = sf(cell(rows, 1, 0))
    let delta: float = cur - old

    // min/max/promedio sobre los días con dato (en código: los agregados SQL con
    // WHERE de nyx-db v0.5.0 devuelven NULL; el SELECT de rango sí funciona).
    var mn: float = cur
    var mx: float = cur
    var sum: float = 0.0
    var i: int = 1
    while i <= last {
        let v: float = sf(cell(rows, i, 0))
        if v < mn { mn = v }
        if v > mx { mx = v }
        sum = sum + v
        i = i + 1
    }
    let avg: float = sum / int_to_float(last)

    var dcls: String = "flat"
    var darrow: String = "&rarr;"
    if delta > 0.0 { dcls = "up"; darrow = "&#9650;" }
    if delta < 0.0 { dcls = "down"; darrow = "&#9660;" }

    sb.append("<div class=\"rate-head\"><b>" + name + "</b>")
    sb.append("<span class=\"rate-val\">Bs " + fmt2(cur) + "</span>")
    sb.append("<span class=\"rate-delta " + dcls + "\">" + darrow + " " + fmt2(delta) + " <small>14d</small></span>")
    sb.append("</div>")

    // Barras (oldest->newest, escala min→max)
    sb.append("<div class=\"rate-bars\">")
    let span: float = mx - mn
    var b: int = 1
    while b <= last {
        let v: float = sf(cell(rows, b, 0))
        var pct: int = 50
        if span > 0.0 {
            pct = float_to_int((v - mn) / span * 94.0) + 6
        }
        sb.append("<div class=\"rate-bar\" title=\"Bs " + fmt2(v) + "\"><div class=\"rate-fill\" style=\"height:" + int_to_string(pct) + "%\"></div></div>")
        b = b + 1
    }
    sb.append("</div>")

    // Resumen mín/máx/promedio de la ventana.
    sb.append("<p class=\"rate-agg\">14 d&iacute;as &middot; m&iacute;n Bs " + fmt2(mn) + " &middot; m&aacute;x Bs " + fmt2(mx) + " &middot; prom Bs " + fmt2(avg) + "</p>")

    sb.append("</div>")
    return sb.to_string()
}

// Sección "Histórico" completa para /finanzas (server-side, desde nyx-db SQL).
pub fn rates_history_html() -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<div class=\"rate-hist\">")
    sb.append(rate_chart("bcv", "D&oacute;lar BCV"))
    sb.append(rate_chart("eur", "Euro BCV"))
    sb.append(rate_chart("bin", "D&oacute;lar Binance"))
    let upd: Array = sql_rows("SELECT v FROM meta WHERE k = 'rates_upd'")
    if upd.length() > 1 {
        let us: String = cell(upd, 1, 0)
        sb.append("<p class=\"rate-upd\">Actualizado " + rel_txt(time() - string_to_int(us)) + "</p>")
    }
    sb.append("</div>")
    return sb.to_string()
}
