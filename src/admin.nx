// ── Visitas: contador + log ────────────────────────────────────────────────────
// Un middleware global (app_use en main.nx) hace INCR por cada carga de pagina
// publica y anexa al log. La cookie "vv" (visitante) la crea un <script> del
// layout; aqui solo se LEE (nyx-serve no deja fijar Set-Cookie al continuar).

// (El índice de día civil de Venezuela vive ahora en src/sqldb.nx como db_day().)

// IP del cliente segun el gateway (X-Forwarded-For / X-Real-IP; "" si no llega).
fn client_ip(req: Request) -> String {
    var ip: String = http_find_header(req.headers_flat, "X-Forwarded-For")
    if ip.length() > 0 {
        let c: int = ip.indexOf(",")
        if c > 0 {
            ip = ip.substring(0, c)
        }
        return md_trim(ip)
    }
    ip = http_find_header(req.headers_flat, "X-Real-IP")
    if ip.length() > 0 {
        return md_trim(ip)
    }
    return ""
}

// True SOLO si la ruta es una página real del sitio (lista blanca). Así los sondeos
// de bots (/wp-admin, *.php, /.env, /xmlrpc…) y todo lo demás (assets, /api, /admin,
// iconos, typos) no cuentan de forma natural, sin perseguir patrones uno por uno.
fn visit_counts(method: String, path: String) -> bool {
    if method != "GET" { return false }
    // Páginas estáticas conocidas.
    if path == "/" { return true }
    if path == "/clima" { return true }
    if path == "/finanzas" { return true }
    if path == "/calculadora" { return true }
    if path == "/noticias" { return true }
    if path == "/chat" { return true }
    if path == "/baquiano" { return true }
    if path == "/sismos" { return true }
    // Secciones dinámicas.
    if path.startsWith("/articulo/") { return true }
    if path.startsWith("/baquiano/") { return true }
    if path.startsWith("/sismos/") { return true }
    return false
}

// Middleware global: registra la visita en nyx-db (SQL) con un INSERT. Devuelve
// status 0 (continuar) SIEMPRE (una metrica jamas debe romper ni bloquear la pagina;
// sql_exec no lanza, y nyx-db serializa internamente con su g_db_mtx).
pub fn visit_middleware(req: Request) -> Response {
    let cont: Array = []
    if !visit_counts(req.method, req.path) {
        return Response { status: 0, headers_flat: cont, body: "" }
    }
    let ip: String = client_ip(req)
    let ua: String = http_find_header(req.headers_flat, "User-Agent")
    var uniq: int = 0
    if !req.cookies.contains("vv") { uniq = 1 }
    let sql: String = "INSERT INTO visits VALUES (" + int_to_string(time()) + ", " + int_to_string(db_day()) + ", '" + sql_esc(req.path) + "', '" + sql_esc(ip) + "', '" + sql_esc(ua) + "', " + int_to_string(uniq) + ")"
    sql_exec(sql)
    return Response { status: 0, headers_flat: cont, body: "" }
}

// Entero con separador de miles (1284 -> "1.284").
fn fmt_miles(n: int) -> String {
    let s: String = int_to_string(n)
    let len: int = s.length()
    if len <= 3 {
        return s
    }
    var out: String = ""
    var i: int = 0
    while i < len {
        if i > 0 and (len - i) % 3 == 0 {
            out = out + "."
        }
        out = out + s.substring(i, i + 1)
        i = i + 1
    }
    return out
}

// User-Agent -> etiqueta corta "Navegador · SO" (el UA completo va en el title).
fn ua_short(ua: String) -> String {
    if ua.length() == 0 {
        return "?"
    }
    var br: String = "Otro"
    if ua.indexOf("Edg") >= 0 {
        br = "Edge"
    } else if ua.indexOf("OPR") >= 0 or ua.indexOf("Opera") >= 0 {
        br = "Opera"
    } else if ua.indexOf("Firefox") >= 0 {
        br = "Firefox"
    } else if ua.indexOf("Chrome") >= 0 {
        br = "Chrome"
    } else if ua.indexOf("Safari") >= 0 {
        br = "Safari"
    } else if ua.indexOf("curl") >= 0 {
        br = "curl"
    } else if ua.indexOf("bot") >= 0 or ua.indexOf("Bot") >= 0 or ua.indexOf("spider") >= 0 {
        br = "Bot"
    }
    var os: String = ""
    if ua.indexOf("Android") >= 0 {
        os = "Android"
    } else if ua.indexOf("iPhone") >= 0 {
        os = "iPhone"
    } else if ua.indexOf("iPad") >= 0 {
        os = "iPad"
    } else if ua.indexOf("Windows") >= 0 {
        os = "Windows"
    } else if ua.indexOf("Mac OS") >= 0 or ua.indexOf("Macintosh") >= 0 {
        os = "Mac"
    } else if ua.indexOf("Linux") >= 0 {
        os = "Linux"
    }
    if os.length() > 0 {
        return br + " · " + os
    }
    return br
}

// "Lo más visto": GROUP BY path en nyx-db; se ordena en Nyx (ORDER BY sobre agregado
// no es fiable en nyx-db v0.5.0) y se toma el top 10. Arrays de String (patrón seguro).
fn render_top_pages() -> String {
    let rows: Array = sql_rows("SELECT path, COUNT(*) FROM visits GROUP BY path")
    let m: int = rows.length() - 1
    if m < 1 {
        return ""
    }
    var paths: Array = []
    var counts: Array = []
    var i: int = 1
    while i < rows.length() {
        let row: Array = rows[i]
        let p: String = row[0]
        let c: String = row[1]
        paths.push(p)
        counts.push(c)
        i = i + 1
    }
    var top: int = 10
    if m < top { top = m }
    // Selección parcial descendente por count (datos pequeños: pocas rutas distintas).
    var a: int = 0
    while a < top {
        var best: int = a
        var b: int = a + 1
        while b < m {
            let cb: String = counts[b]
            let cbest: String = counts[best]
            if string_to_int(cb) > string_to_int(cbest) { best = b }
            b = b + 1
        }
        if best != a {
            let pa: String = paths[a]
            let pb: String = paths[best]
            paths[a] = pb
            paths[best] = pa
            let ca: String = counts[a]
            let cc: String = counts[best]
            counts[a] = cc
            counts[best] = ca
        }
        a = a + 1
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<h2 class=\"finz-h\">Lo m&aacute;s visto</h2>\n<div class=\"top-pages\">")
    var t: int = 0
    while t < top {
        let p: String = paths[t]
        let c: String = counts[t]
        sb.append("<div class=\"top-row\"><span class=\"top-path\">" + aesc(p) + "</span><span class=\"top-n\">" + fmt_miles(string_to_int(c)) + "</span></div>")
        t = t + 1
    }
    sb.append("</div>\n")
    return sb.to_string()
}

fn render_admin_visitas(csrf: String) -> String {
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<section class=\"admin\">\n")
    sb.append("<p><a href=\"/admin\">&larr; Panel</a></p>\n")
    sb.append("<h1>Visitas</h1>\n")
    let d0: int = db_day()
    let ds0: String = int_to_string(d0)
    // Contadores por agregados SQL (nyx-db).
    let total: int = sql_count("SELECT COUNT(*) FROM visits")
    let uniq: int = sql_count("SELECT COUNT(*) FROM visits WHERE uniq = 1")
    let today: int = sql_count("SELECT COUNT(*) FROM visits WHERE day = " + ds0)
    sb.append("<div class=\"visit-nums\">")
    sb.append("<div class=\"visit-num\"><span class=\"vn-n\">" + fmt_miles(total) + "</span><small>Visitas totales</small></div>")
    sb.append("<div class=\"visit-num\"><span class=\"vn-n\">" + fmt_miles(uniq) + "</span><small>Visitantes unicos</small></div>")
    sb.append("<div class=\"visit-num\"><span class=\"vn-n\">" + fmt_miles(today) + "</span><small>Hoy</small></div>")
    sb.append("</div>\n")
    // Mini-grafico de 7 dias (un COUNT por dia; hoy a la derecha).
    var dayvals: Array = []
    var maxv: int = 1
    var i: int = 0
    while i < 7 {
        let n: int = sql_count("SELECT COUNT(*) FROM visits WHERE day = " + int_to_string(d0 - i))
        dayvals.push(n)
        if n > maxv { maxv = n }
        i = i + 1
    }
    sb.append("<h2 class=\"finz-h\">Ultimos 7 dias</h2>\n<div class=\"visit-bars\">")
    var k: int = 6
    while k >= 0 {
        let n: int = dayvals[k]
        var lab: String = int_to_string(k) + "d"
        if k == 0 { lab = "Hoy" }
        if k == 1 { lab = "Ayer" }
        var pct: int = n * 100 / maxv
        if pct < 3 and n > 0 { pct = 3 }
        sb.append("<div class=\"visit-bar\"><span class=\"vb-n\">" + fmt_miles(n) + "</span><div class=\"vb-track\"><div class=\"vb-fill\" style=\"height:" + int_to_string(pct) + "%\"></div></div><span class=\"vb-lab\">" + lab + "</span></div>")
        k = k - 1
    }
    sb.append("</div>\n")
    // Lo más visto (GROUP BY path; se ordena en Nyx y se toma el top 10).
    sb.append(render_top_pages())
    // Registro reciente (últimas 50).
    sb.append("<h2 class=\"finz-h\">Registro (ultimas 50)</h2>\n")
    let log: Array = sql_rows("SELECT ts, path, ip, ua FROM visits ORDER BY ts DESC LIMIT 50")
    sb.append("<div class=\"visit-log\">")
    let now: int = time()
    var j: int = 1
    while j < log.length() {
        let row: Array = log[j]
        let ts0: String = row[0]
        let pth: String = row[1]
        let ip0: String = row[2]
        let ua0: String = row[3]
        let ep: int = string_to_int(ts0)
        var meta: String = "&mdash;"
        if ip0.length() > 0 { meta = aesc(ip0) }
        sb.append("<div class=\"visit-row\">")
        sb.append("<span class=\"vr-when\">" + rel_txt(now - ep) + "</span>")
        sb.append("<span class=\"vr-path\">" + aesc(pth) + "</span>")
        sb.append("<span class=\"vr-meta\" title=\"" + aesc(ua0) + "\">" + meta + " &middot; " + aesc(ua_short(ua0)) + "</span>")
        sb.append("</div>")
        j = j + 1
    }
    if log.length() < 2 {
        sb.append("<p>Sin visitas registradas.</p>")
    }
    sb.append("</div>\n")
    sb.append("<div class=\"admin-actions\">")
    sb.append("<form method=\"post\" action=\"/admin/visitas\" class=\"admin-inline\" onsubmit=\"return confirm('Vaciar el registro?');\">")
    sb.append(csrf_input(csrf))
    sb.append("<input type=\"hidden\" name=\"act\" value=\"clear_log\"><button type=\"submit\" class=\"admin-del\">Vaciar registro</button></form>")
    sb.append("<form method=\"post\" action=\"/admin/visitas\" class=\"admin-inline\" onsubmit=\"return confirm('Reiniciar el contador a cero?');\">")
    sb.append(csrf_input(csrf))
    sb.append("<input type=\"hidden\" name=\"act\" value=\"reset_counter\"><button type=\"submit\" class=\"admin-del\">Reiniciar contador</button></form>")
    sb.append("</div>\n")
    sb.append("<p><a href=\"/admin\">&larr; Panel</a></p>\n")
    sb.append("</section>\n")
    return page("Admin visitas", sb.to_string())
}

pub fn handle_admin_visitas(req: Request) -> Response {
    let sid: String = current_sid(req)
    let csrf: String = lookup_admin_session(sid)
    if csrf.length() == 0 {
        return admin_html(200, render_login(""))
    }
    return admin_html(200, render_admin_visitas(csrf))
}

pub fn handle_admin_visitas_post(req: Request) -> Response {
    let sid: String = current_sid(req)
    let csrf: String = lookup_admin_session(sid)
    if csrf.length() == 0 {
        return admin_html(403, render_login("Sesion expirada."))
    }
    let tok: String = form_field(req.body, "csrf")
    if tok != csrf {
        return admin_html(403, render_login("Token invalido."))
    }
    let act: String = form_field(req.body, "act")
    // En SQL, el log y los contadores son la misma tabla: vaciar = borrar todo.
    if act == "clear_log" or act == "reset_counter" {
        sql_exec("DELETE FROM visits")
    }
    return redirect("/admin/visitas")
}
