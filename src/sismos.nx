// src/sismos.nx — Sismos recientes en Venezuela desde la API publica del EMSC.
//
// Fuente: EMSC (www.seismicportal.eu), formato FDSN "text". Se eligio EMSC
// porque earthquake.usgs.gov esta interceptado/inalcanzable desde este host;
// EMSC expone EXACTAMENTE las mismas columnas FDSN, asi que el parser no cambia.
//
// Formato de columnas FDSN estandar (0-based):
//   0 EventID | 1 Time | 2 Latitude | 3 Longitude | 4 Depth/km | 5 Author |
//   6 Catalog | 7 Contributor | 8 ContributorID | 9 MagType | 10 Magnitude |
//   11 MagAuthor | 12 EventLocationName
// La primera linea es una cabecera que empieza con '#'.

import "src/md"
import "src/funvisis"

// Caché del cuerpo CRUDO de EMSC (no del HTML), para poder tanto renderizar la
// lista como buscar un evento por id para su pagina de detalle. Holders de 1
// elemento (el literal global de array no se materializa fiable; se asignan en
// sismos_init() — mismo patron que __serve_app en nyx-serve).
var __emsc_body: Array = [""]
var __emsc_ts: Array = [0]

// TTL de caché en segundos (3 minutos).
const CACHE_TTL: int = 180

pub fn sismos_init() {
    __emsc_body = [""]
    __emsc_ts = [0]
    ve_poly_init()
}

// ── Polígono de Venezuela + ~60 km de margen ────────────────────────────────
// Sustituye a la caja lat 0.5..12.9 / lon -73.6..-60.5. POR QUÉ no una caja:
// Venezuela es CÓNCAVA, así que cualquier rectángulo que la contenga (Zulia al
// oeste, Delta Amacuro al este) contiene también el nido de Bucaramanga, Guyana
// entera y el norte de Brasil. No era una caja mal calibrada: la herramienta no
// daba para más. Medido sobre los 211 eventos del feed del 2026-07-16, la caja
// dejaba pasar 65 eventos M≥3.5 de Colombia — 48 de ellos del nido de
// Bucaramanga (~6.75/-73.03), que produce M4+ a diario a ~116 km de la frontera
// y a gran profundidad (no se sienten aquí) — más Grenada, Tobago y un M6.3 en
// Colombia central a ~700 km. Con esto el criterio es la DISTANCIA, no la
// nacionalidad: un M4.9 colombiano pegado a Cúcuta (~40 km de San Cristóbal) SÍ
// entra, y el nido de Bucaramanga NO.
//
// Los vértices son la frontera real desplazada ~0.55° (~60 km) hacia afuera, e
// incluyen las dependencias federales (Los Roques, La Orchila, La Blanquilla,
// Los Testigos) y la franja costa afuera donde está la falla de El Pilar.
// Calibrado contra 49 puntos de control (49/49) — ver el bloque de tests.
// OJO: al norte de Paria la transición Venezuela→Grenada es gradual y la línea
// es necesariamente arbitraria (±15 km); ahí manda el atajo por nombre de abajo.
//
// Holders: un literal de array global multi-elemento NO se materializa fiable
// (gotcha del proyecto) — se llenan en sismos_init().
// OJO: el literal va con 0 (int) y NO con 0.0, aunque el contenido real sea float:
// un literal FLOAT en un array GLOBAL revienta el codegen del compilador — emite
// `call void @nyx_array_push(..., i64 0.0)` (i64 con constante float) y clang aborta
// con "floating point constant invalid for type". El contenido float se asigna en
// ve_poly_init(), donde sí funciona.
var __ve_lon: Array = [0]
var __ve_lat: Array = [0]

fn ve_push(lons: Array, lats: Array, lon: float, lat: float) {
    lons.push(lon)
    lats.push(lat)
}

fn ve_poly_init() {
    let lons: Array = []
    let lats: Array = []
    // Caribe (norte), de oeste a este
    ve_push(lons, lats, -72.05, 12.05)   // mar al NO de la Guajira (Castilletes -71.35/11.83)
    ve_push(lons, lats, -71.20, 12.55)
    ve_push(lons, lats, -70.00, 12.75)   // norte de Paraguaná (cabo San Román 12.19)
    ve_push(lons, lats, -69.30, 12.10)
    ve_push(lons, lats, -68.20, 11.60)   // frente a Falcón (deja fuera Curazao/Bonaire, a >60 km)
    ve_push(lons, lats, -67.20, 12.00)   // sube para cubrir Los Roques
    ve_push(lons, lats, -66.00, 12.05)   // Los Roques (11.85/-66.75) / La Orchila
    ve_push(lons, lats, -64.30, 12.10)   // La Blanquilla (11.85/-64.60)
    ve_push(lons, lats, -63.10, 11.95)   // Los Testigos (11.37/-63.10)
    ve_push(lons, lats, -62.15, 11.50)   // mar al N de Paria (falla de El Pilar)
    ve_push(lons, lats, -61.30, 11.20)   // NE: Trinidad occidental (a ~15 km de Paria); Grenada fuera
    ve_push(lons, lats, -60.85, 10.55)   // Trinidad centro
    ve_push(lons, lats, -60.45, 9.90)    // SE de Trinidad
    ve_push(lons, lats, -60.00, 9.30)    // Atlántico frente al Delta
    // Frontera con Guyana (este)
    ve_push(lons, lats, -59.28, 8.60)    // Punta Playa (-59.83/8.55)
    ve_push(lons, lats, -59.85, 7.40)
    ve_push(lons, lats, -59.95, 6.30)
    ve_push(lons, lats, -60.20, 5.00)    // Roraima (-60.75/5.20)
    // Frontera con Brasil (sur), de este a oeste
    ve_push(lons, lats, -60.75, 4.00)    // Santa Elena de Uairén (-61.10/4.60)
    ve_push(lons, lats, -62.00, 3.35)
    ve_push(lons, lats, -63.50, 1.70)
    ve_push(lons, lats, -64.60, 1.15)
    ve_push(lons, lats, -65.60, 0.55)
    ve_push(lons, lats, -66.60, 0.60)    // Piedra del Cocuy (-66.85/1.20)
    // Frontera con Colombia (oeste), de sur a norte
    ve_push(lons, lats, -67.45, 1.50)
    ve_push(lons, lats, -67.70, 2.60)
    ve_push(lons, lats, -68.30, 4.05)    // San Fernando de Atabapo (-67.70/4.05)
    ve_push(lons, lats, -68.42, 5.20)
    ve_push(lons, lats, -68.10, 6.30)    // Puerto Carreño (-67.48/6.19)
    ve_push(lons, lats, -69.20, 5.65)    // el Meta hacia el oeste
    ve_push(lons, lats, -70.20, 5.60)
    ve_push(lons, lats, -71.00, 6.45)    // río Arauca
    ve_push(lons, lats, -71.60, 6.85)
    ve_push(lons, lats, -72.35, 6.95)    // SO del Táchira
    ve_push(lons, lats, -72.95, 7.85)    // Cúcuta (-72.50/7.89) — ZONA CRÍTICA: el nido de
                                         // Bucaramanga (-73.03/6.75) debe quedar FUERA
    ve_push(lons, lats, -73.05, 8.60)
    ve_push(lons, lats, -73.45, 9.60)    // Sierra de Perijá (-72.90)
    ve_push(lons, lats, -73.45, 10.60)
    ve_push(lons, lats, -72.95, 11.15)
    __ve_lon = lons
    __ve_lat = lats
}

// Ray casting estándar: cuenta cruces de una semirrecta hacia el oeste.
pub fn point_in_ve(lat: float, lon: float) -> bool {
    let xs: Array = __ve_lon
    let ys: Array = __ve_lat
    let n: int = xs.length()
    // Sin polígono cargado NO filtramos (mejor de más que tragarse todos los
    // sismos en silencio si sismos_init no llegó a correr).
    if n < 3 {
        return true
    }
    var ins: bool = false
    var i: int = 0
    var j: int = n - 1
    while i < n {
        let xi: float = xs[i]
        let yi: float = ys[i]
        let xj: float = xs[j]
        let yj: float = ys[j]
        let a: bool = yi > lat
        let b: bool = yj > lat
        if a != b {
            let xint: float = (xj - xi) * (lat - yi) / (yj - yi) + xi
            if lon < xint {
                ins = !ins
            }
        }
        j = i
        i = i + 1
    }
    return ins
}

fn emsc_url() -> String {
    // EMSC FDSN: ruta /event/1/ y parametros minmag/minlat/maxlat/minlon/maxlon.
    // Bounding box de fetch: lat 0..13, lon -74..-59. Filtramos a mag>=2.5 (los
    // sismos aun menores los cubre FUNVISIS, sin API publica). La inclusion final
    // la decide quake_in_region() por GEOGRAFIA (no solo por el nombre del lugar),
    // para captar eventos fronterizos sentidos en Venezuela con etiqueta vecina.
    var u: String = "https://www.seismicportal.eu/fdsnws/event/1/query?format=text"
    u = u + "&orderby=time&limit=200&minmag=2.5"
    u = u + "&minlat=0&maxlat=13&minlon=-74&maxlon=-59"
    return u
}

// Cuerpo FDSN cacheado; descarga del EMSC si esta vacio o vencido.
fn emsc_body() -> String {
    let now: int = time()
    let last: int = __emsc_ts[0]
    var body: String = __emsc_body[0]
    if body.length() == 0 or now - last > CACHE_TTL {
        let fresh: String = net_get(emsc_url())
        if fresh.length() > 0 {
            __emsc_body[0] = fresh
            __emsc_ts[0] = now
            body = fresh
        }
    }
    return body
}

// Epoch (segundos) de la ultima descarga exitosa, mirando las DOS fuentes: la
// tabla sale de all_quakes() (FUNVISIS + EMSC), asi que quedarse solo con el ts de
// EMSC mentia — con EMSC caido y FUNVISIS respondiendo, la pagina tenia datos
// frescos pero devolvia 0, y el front pintaba la hora del epoch 0 ("Actualizado
// 20:00", de 1969). Se devuelve el mas reciente de los dos; 0 solo si no hay ninguno.
pub fn sismos_ts() -> int {
    let e: int = __emsc_ts[0]
    let f: int = funvisis_ts()
    if f > e {
        return f
    }
    return e
}

fn attr_escape(s: String) -> String {
    return html_escape(s).replace("\"", "&quot;")
}

// ¿El evento es de Venezuela (o de su franja fronteriza, donde SÍ se siente)?
// Dos vías, y las dos hacen falta:
//  1. La etiqueta de EMSC dice VENEZUELA -> pase directo. Es la autoridad sobre
//     sus propios eventos, y resuelve limpiamente la franja costa afuera del
//     norte de Paria, donde la línea geográfica es arbitraria (un OFFSHORE SUCRE
//     y un GRENADA REGION pueden estar a 16 km uno de otro).
//  2. Si no, GEOGRAFÍA: epicentro dentro del polígono Venezuela + ~60 km. Hace
//     falta porque muchos sismos sentidos aquí llevan etiqueta vecina (NORTHERN
//     COLOMBIA, GULF OF PARIA, TRINIDAD, CARIBBEAN SEA); filtrar solo por nombre
//     descartaba ~la mitad de los eventos reales.
// Ver ve_poly_init() para por qué es un polígono y no una caja.
fn quake_in_region(lat_s: String, lon_s: String, place: String) -> bool {
    if place.indexOf("VENEZUELA") >= 0 {
        return true
    }
    // to_float0 (src/num.nx), NO string_to_float: lat/lon vienen del feed y un
    // valor corrupto abortaría el proceso. Basura -> 0.0 -> (0,0) cae en el golfo
    // de Guinea, fuera del polígono -> el evento se descarta, que es lo que queremos.
    let lat: float = to_float0(lat_s)
    let lon: float = to_float0(lon_s)
    return point_in_ve(lat, lon)
}

// Epoch UTC de un ISO EMSC "2026-07-07T08:41:38.68Z" (siempre Z/UTC). 0 si corto.
fn emsc_iso_epoch(iso: String) -> int {
    if iso.length() < 16 {
        return 0
    }
    // to_int0 (src/num.nx), NO string_to_int: el ISO viene del feed y un campo
    // corrupto abortaría el proceso.
    let y: int = to_int0(iso.substring(0, 4))
    let mo: int = to_int0(iso.substring(5, 7))
    let d: int = to_int0(iso.substring(8, 10))
    let h: int = to_int0(iso.substring(11, 13))
    let mi: int = to_int0(iso.substring(14, 16))
    // Fecha no plausible (campo corrupto) -> 0: el llamador ya descarta el epoch 0.
    if y < 2000 or mo < 1 or d < 1 {
        return 0
    }
    return fv_days_from_civil(y, mo, d) * 86400 + h * 3600 + mi * 60
}

// Registros EMSC normalizados (aplica quake_in_region + epoch). Mismo shape que FUNVISIS.
fn emsc_records() -> Array {
    let body: String = emsc_body()
    let out: Array = []
    if body.length() == 0 {
        return out
    }
    let lines: Array = body.split("\n")
    var i: int = 0
    while i < lines.length() {
        let line: String = lines[i]
        if line.length() > 5 and !line.startsWith("#") and !line.startsWith("<") {
            let parts: Array = line.split("|")
            if parts.length() >= 13 {
                let place: String = md_trim(parts[12])
                let lat: String = md_trim(parts[2])
                let lon: String = md_trim(parts[3])
                if quake_in_region(lat, lon, place) {
                    let eid: String = md_trim(parts[0])
                    let t: String = md_trim(parts[1])
                    let depth: String = md_trim(parts[4])
                    let mtype: String = md_trim(parts[9])
                    let mag: String = md_trim(parts[10])
                    let ep: int = emsc_iso_epoch(t)
                    let rec: Array = [eid, t, lat, lon, depth, mtype, mag, place, ep]
                    out.push(rec)
                }
            }
        }
        i = i + 1
    }
    return out
}

// ¿Hay en fvrecs un evento que coincida (|Δt|<=90s y |Δlat|,|Δlon|<=0.3)?
fn dup_in_funvisis(fvrecs: Array, ep: int, lat: float, lon: float) -> bool {
    var j: int = 0
    while j < fvrecs.length() {
        let r: Array = fvrecs[j]
        let fep: int = r[8]
        var dt: int = ep - fep
        if dt < 0 { dt = -dt }
        if dt <= 90 {
            let flat: String = r[2]
            let flon: String = r[3]
            var dla: float = string_to_float(flat) - lat
            var dlo: float = string_to_float(flon) - lon
            if dla < 0.0 { dla = -dla }
            if dlo < 0.0 { dlo = -dlo }
            if dla <= 0.3 and dlo <= 0.3 {
                return true
            }
        }
        j = j + 1
    }
    return false
}

// Selection sort in-place por epoch (campo 8) descendente. N pequeño (<=~220).
fn sort_recs_desc(recs: Array) {
    var i: int = 0
    let n: int = recs.length()
    while i < n {
        var best: int = i
        var j: int = i + 1
        while j < n {
            let rj: Array = recs[j]
            let rb: Array = recs[best]
            let ej: int = rj[8]
            let eb: int = rb[8]
            if ej > eb {
                best = j
            }
            j = j + 1
        }
        if best != i {
            let tmp: Array = recs[i]
            recs[i] = recs[best]
            recs[best] = tmp
        }
        i = i + 1
    }
}

// Lista unificada: FUNVISIS (primaria en tierra) + EMSC no-duplicado (fronterizos/
// offshore que FUNVISIS no lista), orden por fecha desc.
pub fn all_quakes() -> Array {
    let fv: Array = funvisis_records()
    let em: Array = emsc_records()
    let merged: Array = []
    var a: int = 0
    while a < fv.length() {
        let fr: Array = fv[a]
        merged.push(fr)
        a = a + 1
    }
    var k: int = 0
    while k < em.length() {
        let r: Array = em[k]
        let ep: int = r[8]
        let la: String = r[2]
        let lo: String = r[3]
        let latf: float = string_to_float(la)
        let lonf: float = string_to_float(lo)
        if !dup_in_funvisis(fv, ep, latf, lonf) {
            merged.push(r)
        }
        k = k + 1
    }
    sort_recs_desc(merged)
    return merged
}

// "2026-06-28T12:34:56.789Z" -> "2026-06-28 12:34"
pub fn format_time(t: String) -> String {
    let tp: int = t.indexOf("T")
    if tp < 0 {
        return t
    }
    let date: String = t.substring(0, tp)
    let rest: String = t.substring(tp + 1, t.length())
    var hm: String = rest
    if rest.length() >= 5 {
        hm = rest.substring(0, 5)
    }
    return date + " " + hm
}

fn fmt_depth(d: String) -> String {
    if d.length() == 0 {
        return "-"
    }
    return d + " km"
}

// Parser puro: registros unificados -> tabla HTML. "" si no hay nada.
// OJO: el markup de fila lo REPLICA s_row_html en wasm/veninfo.nx — cambiarlos JUNTOS.
pub fn render_quakes(recs: Array) -> String {
    if recs.length() == 0 {
        return "<p>No hay sismos recientes registrados en la zona.</p>"
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<table class=\"quakes\">\n")
    sb.append("<thead><tr><th>Fecha</th><th>Magnitud</th><th>Profundidad</th><th>Lugar</th><th>Distancia</th></tr></thead>\n")
    sb.append("<tbody id=\"qtbody\">\n")
    var i: int = 0
    while i < recs.length() {
        let r: Array = recs[i]
        let eid: String = r[0]
        let t: String = r[1]
        let lat: String = r[2]
        let lon: String = r[3]
        let depth: String = r[4]
        let mtype: String = r[5]
        let mag: String = r[6]
        let place: String = r[7]
        let ft: String = format_time(t)
        let sp: int = ft.indexOf(" ")
        var fdia: String = ft
        var fhora: String = ""
        if sp >= 0 {
            fdia = ft.substring(0, sp)
            fhora = ft.substring(sp + 1, ft.length())
        }
        sb.append("<tr data-id=\"")
        sb.append(attr_escape(eid))
        sb.append("\" data-lat=\"")
        sb.append(attr_escape(lat))
        sb.append("\" data-lon=\"")
        sb.append(attr_escape(lon))
        sb.append("\" data-mag=\"")
        sb.append(attr_escape(mag))
        sb.append("\" data-type=\"")
        sb.append(attr_escape(mtype))
        sb.append("\" data-depth=\"")
        sb.append(attr_escape(depth))
        sb.append("\" data-time=\"")
        sb.append(attr_escape(ft))
        sb.append("\" data-iso=\"")
        sb.append(attr_escape(t))
        sb.append("\" data-place=\"")
        sb.append(attr_escape(place))
        sb.append("\"><td class=\"fh\"><span class=\"f-dia\">")
        sb.append(html_escape(fdia))
        sb.append("</span><span class=\"f-hora\">")
        sb.append(html_escape(fhora))
        sb.append("</span></td><td class=\"mag\">")
        sb.append(html_escape(mag))
        sb.append("</td><td>")
        sb.append(html_escape(fmt_depth(depth)))
        sb.append("</td><td>")
        sb.append(html_escape(place))
        sb.append("</td><td class=\"dist\">&mdash;</td></tr>\n")
        i = i + 1
    }
    sb.append("</tbody>\n</table>\n")
    return sb.to_string()
}

// Bloque de datos crudos para el front Nyx→WASM: <textarea id="s-data" hidden>
// con una línea TSV por sismo (id, iso, lat, lon, depth, type, mag, place).
// veninfo.wasm (sismos_boot) lo lee con dom_get_value y deriva epoch/hora
// local él mismo. Fuente: all_quakes() (unificado FUNVISIS+EMSC).
pub fn sismos_data_block() -> String {
    let recs: Array = all_quakes()
    if recs.length() == 0 {
        return ""
    }
    var sb: StringBuilder = StringBuilder.new()
    sb.append("<textarea id=\"s-data\" hidden>")
    var i: int = 0
    while i < recs.length() {
        let r: Array = recs[i]
        let eid: String = r[0]
        let t: String = r[1]
        let lat: String = r[2]
        let lon: String = r[3]
        let depth: String = r[4]
        let mtype: String = r[5]
        let mag: String = r[6]
        let place: String = r[7]
        sb.append(html_escape(eid + "\t" + t + "\t" + lat + "\t" + lon + "\t" + depth + "\t" + mtype + "\t" + mag + "\t" + place))
        sb.append("\n")
        i = i + 1
    }
    sb.append("</textarea>\n")
    return sb.to_string()
}

// HTML de la lista (usa la lista unificada FUNVISIS+EMSC).
pub fn sismos_section() -> String {
    let recs: Array = all_quakes()
    if recs.length() == 0 {
        return "<p class=\"error\">No se pudieron cargar los sismos en este momento. Intenta de nuevo en unos minutos.</p>"
    }
    return render_quakes(recs)
}

// Slides para el rotador de la portada: los N sismos mas recientes de Venezuela.
pub fn sismos_rotator_html(maxn: int) -> String {
    let recs: Array = all_quakes()
    var sb: StringBuilder = StringBuilder.new()
    var i: int = 0
    var cnt: int = 0
    while i < recs.length() and cnt < maxn {
        let r: Array = recs[i]
        let mag: String = r[6]
        let place: String = r[7]
        let t: String = r[1]
        sb.append("<div class=\"rot-slide\"><span class=\"news-src mag-badge\">M ")
        sb.append(html_escape(mag))
        sb.append("</span><span class=\"rot-title\">")
        sb.append(html_escape(place))
        sb.append("</span><time class=\"news-date\" data-ts=\"")
        sb.append(attr_escape(t))
        sb.append("\"></time></div>\n")
        cnt = cnt + 1
        i = i + 1
    }
    return sb.to_string()
}

// Pre-calienta la caché de sismos (para el hilo de refresco).
pub fn sismos_warm() {
    let b: String = emsc_body()
    if b.length() > 0 {
        __emsc_ts[0] = time()
    }
}

// Busca un evento por id (EMSC o FUNVISIS) en la lista unificada.
// Devuelve [id, iso, lat, lon, depth, mtype, mag, place] o [] si no existe.
pub fn quake_by_id(id: String) -> Array {
    let recs: Array = all_quakes()
    var i: int = 0
    while i < recs.length() {
        let r: Array = recs[i]
        let eid: String = r[0]
        if eid == id {
            let out: Array = [r[0], r[1], r[2], r[3], r[4], r[5], r[6], r[7]]
            return out
        }
        i = i + 1
    }
    let e: Array = []
    return e
}
