// src/net.nx — cliente HTTP(S) de salida del sitio. UN solo sitio por el que
// bajamos datos de terceros (BCV, EMSC, CriptoYa, DolarAPI, RSS de noticias).
//
// ORIGEN (2026-07-16): nació porque el builtin `https_get` NO desencapsulaba
// `Transfer-Encoding: chunked` y devolvía el cuerpo con los marcadores de tamaño
// DENTRO. criptoya.com y bolsadecaracas.com responden chunked: mientras la
// respuesta cabía en UN chunk el marcador quedaba ANTES del JSON y los parsers lo
// saltaban sin enterarse (por eso pasó meses oculto), pero al pasar de un chunk
// caía DENTRO y partía un número por la mitad -> string_to_float abortaba el
// PROCESO. El sitio se cayó así el 2026-07-16 06:32:43 UTC (ver src/num.nx).
//
// ESO YA ESTÁ ARREGLADO EN EL RUNTIME (el mismo día, a raíz de este incidente:
// read_http_response de tls.c ahora des-chunkea), así que https_get ya no
// corrompe cuerpos. El módulo SE MANTIENE porque su valor no era solo ese:
//   - https_get devuelve SOLO el body, sin STATUS: un 403 o un 500 son
//     indistinguibles de un éxito (se ve "" o basura, y se sirve caché vieja
//     creyendo que la red falló). net_get mira el status y devuelve "" a propósito.
//   - https_get no deja mandar cabeceras -> va con "User-Agent: Nyx/1.0", que a la
//     API de Wikipedia le vale un bloqueo por ráfaga (ver wiki_get, src/baquiano.nx).
// std/http da las dos cosas. Si el builtin llega a exponer status y cabeceras,
// este módulo se puede replantear.
//
// http_parse_url/http_build_request/http_tls_request/http_get salen de std/http
// por scope global (lo importa src/main.nx); no hay que importarlo aquí.
//
// CERTIFICADOS (2026-11-15): desde nyx 0.44 std/http VERIFICA el certificado por
// omisión (antes el runtime no validaba nada). Se verifica TODO salvo los hosts de
// NET_TLS_SIN_VERIFICAR: bcv.org.ve sirve una cadena que no valida contra las CAs
// del sistema, y sin la excepción las tasas caerían al respaldo de DolarAPI y se
// perdería la fecha valor. La excepción va POR PETICIÓN (HttpOpts.verificar_tls),
// no con http_tls_inseguro(), que apaga la verificación de todo el proceso.
// Riesgo aceptado: quien intercepte la ruta a BCV puede falsear la tasa (igual que
// antes de 0.44). Si BCV arregla su cadena, vaciar la lista.

const NET_UA: String = "venezuelainfo.org/1.0 (+https://venezuelainfo.org)"

// Body de una respuesta de std/http, "" si el status no es 2xx (o si la conexión
// falló: http_tls_request devuelve status -1). Todos los llamadores ya tratan ""
// como fallo y conservan su caché, así que no hay que cambiar su lógica.
fn net_resp_body(resp: Array) -> String {
    let status: int = resp[1]
    if status < 200 or status >= 300 {
        return ""
    }
    let body: String = resp[3]
    return body
}

// Hosts a los que se conecta SIN verificar el certificado (comparación exacta).
fn net_tls_sin_verificar(host: String) -> bool {
    return host == "www.bcv.org.ve" or host == "bcv.org.ve"
}

// GET con cabeceras propias. Devuelve la respuesta de std/http
// ["response", status, headers, body]; status -1 ante fallo de transporte
// (conexión, certificado, plazo vencido, respuesta cortada).
// Plazos: 10 s para conectar y 20 s para la respuesta COMPLETA (tope total, no por
// lectura: un servidor que gotea bytes no cuelga al hilo que llama).
pub fn net_request(url: String, headers: Array) -> Array {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    var o: HttpOpts = http_opts()
    o.connect_ms = 10000
    o.respuesta_ms = 20000
    o.verificar_tls = !net_tls_sin_verificar(host)
    let r: Result<Array, Error> = try_http_request_opts("GET", url, headers, "", o)
    match r {
        Result.Ok(resp) => { return resp }
        Result.Err(_e) => {}
    }
    let fail: Array = ["response", -1, [], ""]
    return fail
}

// POST con cabeceras propias y plazo TOTAL de `total_ms` para la respuesta. Misma
// forma de respuesta que net_request (status -1 ante fallo de transporte).
pub fn net_post(url: String, headers: Array, body: String, total_ms: int) -> Array {
    let parsed: Array = http_parse_url(url)
    let host: String = parsed[1]
    var o: HttpOpts = http_opts()
    o.connect_ms = 8000
    o.respuesta_ms = total_ms
    o.verificar_tls = !net_tls_sin_verificar(host)
    let r: Result<Array, Error> = try_http_request_opts("POST", url, headers, body, o)
    match r {
        Result.Ok(resp) => { return resp }
        Result.Err(_e) => {}
    }
    let fail: Array = ["response", -1, [], ""]
    return fail
}

// GET de una URL externa (http o https). Devuelve el body YA des-chunkeado, o ""
// ante fallo o status no 2xx. Sustituye a https_get en todo el proyecto.
pub fn net_get(url: String) -> String {
    let hd: Array = ["User-Agent", NET_UA, "Accept", "*/*"]
    return net_resp_body(net_request(url, hd))
}
