// src/push.nx — Notificaciones Web Push (VAPID RFC 8292 + cifrado aes128gcm RFC 8291).
// Todo el trabajo criptográfico lo hace std/webpush (que el monorepo ya entregó);
// aquí vive la lógica del proyecto: claves VAPID, tabla de suscripciones (en nyx-db,
// NO en nyx-kv por su inestabilidad), disparadores (sismos/tasas/chat) y el hilo emisor.
//
// Frontera de datos: el body cifrado es BINARIO (bytes NUL) y sobrevive de punta a
// punta (nyx_string_from_ptr con longitud + Content-Length por str_byte_length +
// tls_write sobre data->length). Ver notas en el plan/CLAUDE.md.

import "std/webpush"
import "std/webpushcrypto"
import "std/base64"
import "src/sqldb"
import "src/sismos"
import "src/chat"
import "src/md"

// Contacto VAPID (llega a los push services; informativo). Umbral de sismos para
// notificar. Ventana de coalescencia del chat (s). Respaldo de la clave en disco.
const VAPID_SUBJECT: String = "mailto:ottaviocavallinaleon@gmail.com"
const PUSH_MAG_MIN: float = 3.5
const CHAT_THROTTLE: int = 300
const VAPID_FILE: String = "/home/admin/.veninfo-vapid-key"
// Sismos: solo se consideran eventos de las últimas 6 h (los feeds pueden publicar
// tarde; más allá de eso el aviso ya no es noticia). Tope por tick para no vaciar
// la batería en un enjambre. Retención del registro de ya-notificados.
const PUSH_SISMO_MAXAGE: int = 21600
const PUSH_SISMO_BURST: int = 5
const PUSH_SEEN_KEEP: int = 172800
// Tope de longitud del endpoint (los reales pueden superar los 256 del sql_esc
// por defecto; WNS llega a ~450+). Se usa con sql_esc_n en TODA query de endpoint.
const PUSH_EP_MAX: int = 2048

// Claves VAPID raw (32B priv / 65B pub). Patrón holder single-element (el literal
// global de array multi-elemento no se materializa fiable; se asignan en push_init).
var __vpriv: Array = [""]
var __vpub: Array = [""]

// ── Helpers de strings ──────────────────────────────────────────────────────
fn starts_with(s: String, pre: String) -> bool {
    let m: int = pre.length()
    if m > s.length() { return false }
    return s.substring(0, m) == pre
}

fn ends_with(s: String, suf: String) -> bool {
    let n: int = s.length()
    let m: int = suf.length()
    if m > n { return false }
    return s.substring(n - m, n) == suf
}

// to_int0 vivía aquí y NO era seguro (filtraba "" y "__NULL__" y luego llamaba
// string_to_int a pelo -> abortaba con basura tipo "3d1c"). Ahora está en
// src/num.nx, validado de verdad, junto a to_float0. Scope global plano: se usa
// igual, sin importar nada.

// Escape mínimo para meter un valor en un JSON de una línea (payload del push).
fn pjson_esc(s: String) -> String {
    var out: String = ""
    let n: int = s.length()
    var i: int = 0
    while i < n {
        let c: String = s.substring(i, i + 1)
        if c == "\"" {
            out = out + "\\\""
        } else if c == "\\" {
            out = out + "\\\\"
        } else if c == "\n" or c == "\r" or c == "\t" {
            out = out + " "
        } else {
            out = out + c
        }
        i = i + 1
    }
    return out
}

// ── Tabla meta (watermarks / clave VAPID) ───────────────────────────────────
fn meta_get(k: String) -> String {
    let rows: Array = sql_rows("SELECT v FROM meta WHERE k = '" + sql_esc(k) + "'")
    if rows.length() < 2 {
        return ""
    }
    let row: Array = rows[1]
    let v: String = row[0]
    if v == "__NULL__" {
        return ""
    }
    return v
}

fn meta_set(k: String, v: String) {
    let ke: String = sql_esc(k)
    sql_exec("DELETE FROM meta WHERE k = '" + ke + "'")
    sql_exec("INSERT INTO meta VALUES ('" + ke + "', '" + sql_esc(v) + "')")
}

// ── Arranque: esquema + claves VAPID (una vez) ──────────────────────────────
// true si kpb decodifica a un keypair completo (97B = 32 priv ‖ 65 pub). Una
// clave corta/truncada (env mal seteada, fila meta corrupta) NO debe usarse:
// substring clampa en silencio y saldrían claves basura -> pushes 403 sin pista.
fn vapid_kp_ok(kpb: String) -> bool {
    if kpb.length() == 0 {
        return false
    }
    let raw: String = base64url_decode(kpb)
    return raw.length() == 97
}

pub fn push_init() {
    // Idempotente (si ya existe, sql_exec devuelve -1 y se ignora).
    sql_exec("CREATE TABLE push_subs (endpoint TEXT, p256dh TEXT, auth TEXT, topics TEXT, created INTEGER)")
    // Sismos ya notificados, por ID de evento. En TABLA y no en meta a propósito:
    // meta_set escribe con sql_esc, que CAPA a 256 chars (src/sqldb.nx) — una lista
    // de ids se truncaría en silencio a la docena de eventos y volveríamos a avisar
    // de sismos viejos. Se poda por tick (PUSH_SEEN_KEEP).
    sql_exec("CREATE TABLE push_seen (id TEXT, ts INTEGER)")

    // Keypair: env > meta (nyx-db) > respaldo en disco > generar. Cada fuente se
    // VALIDA (vapid_kp_ok) antes de usarse. El respaldo existe justamente para
    // sobrevivir a la pérdida del .ndb: si meta viene vacía pero el archivo está,
    // se re-siembra meta desde él en vez de generar una clave nueva (que
    // invalidaría TODAS las suscripciones).
    var kpb: String = md_trim(getenv("VENINFO_VAPID_KEY"))
    if !vapid_kp_ok(kpb) {
        kpb = meta_get("vapid_kp")
    }
    if !vapid_kp_ok(kpb) {
        kpb = md_trim(read_file(VAPID_FILE))    // "" si no existe
        if vapid_kp_ok(kpb) {
            meta_set("vapid_kp", kpb)
        }
    }
    if !vapid_kp_ok(kpb) {
        let kp: String = ec_p256_keypair()      // 97 bytes raw (32 priv ‖ 65 pub)
        kpb = base64url_encode(kp)
        meta_set("vapid_kp", kpb)
        write_file(VAPID_FILE, kpb)
    }
    let raw: String = base64url_decode(kpb)
    __vpriv = [raw.substring(0, 32)]
    __vpub  = [raw.substring(32, 97)]
}

// Clave pública VAPID en base64url (~87 chars) — para el applicationServerKey del cliente.
pub fn vapid_pub_b64() -> String {
    let p: String = __vpub[0]
    return base64url_encode(p)
}

// Nº de suscripciones activas (para el panel admin).
pub fn push_sub_count() -> int {
    return sql_count("SELECT COUNT(*) FROM push_subs")
}

// Resumen legible de la última "Enviar prueba" (lo persiste push_test_worker desde
// su hilo: el POST /admin/push ya ha redirigido cuando terminan los envíos). "" si
// nunca se lanzó ninguna. Sin esto, la única herramienta de diagnóstico del push no
// diagnosticaba nada: 40 envíos correctos y 40 rechazos 403 se veían idénticos.
pub fn push_test_summary() -> String {
    let raw: String = meta_get("push_test_result")
    let p: Array = raw.split("|")
    if p.length() < 7 {
        return ""
    }
    let ts: String = p[0]
    let topic: String = p[1]
    let sent: String = p[2]
    let ok: String = p[3]
    let gone: String = p[4]
    let err: String = p[5]
    let last: String = p[6]
    var s: String = "Ultima prueba (" + topic + ") hace " + rel_txt(time() - to_int0(ts)) + ": " + sent + " enviados, " + ok + " OK"
    if to_int0(gone) > 0 {
        s = s + ", " + gone + " expiradas (borradas)"
    }
    if to_int0(err) > 0 {
        s = s + ", " + err + " con error (ultimo codigo " + last + ")"
    }
    return s
}

// ── Suscripción ─────────────────────────────────────────────────────────────
// Allowlist de host del endpoint (anti-SSRF: sin esto el server haría POST a hosts arbitrarios).
fn push_host_ok(endpoint: String) -> bool {
    if !starts_with(endpoint, "https://") {
        return false
    }
    let rest: String = endpoint.substring(8, endpoint.length())
    let slash: int = rest.indexOf("/")
    var host: String = rest
    if slash > 0 {
        host = rest.substring(0, slash)
    }
    if host == "fcm.googleapis.com" {
        return true
    }
    if ends_with(host, ".push.services.mozilla.com") {
        return true
    }
    if host == "web.push.apple.com" {
        return true
    }
    if ends_with(host, ".push.apple.com") {
        return true
    }
    if ends_with(host, ".notify.windows.com") {
        return true
    }
    return false
}

// Deja solo los temas conocidos, en CSV.
fn clean_topics(raw: String) -> String {
    var out: String = ""
    let parts: Array = raw.split(",")
    var i: int = 0
    while i < parts.length() {
        let t: String = parts[i]
        if t == "sismos" or t == "tasas" or t == "chat" {
            if out.length() > 0 {
                out = out + ","
            }
            out = out + t
        }
        i = i + 1
    }
    return out
}

// Guarda (dedup por endpoint) una suscripción. Devuelve "" en éxito o un mensaje corto.
pub fn push_subscribe(body: String) -> String {
    let endpoint: String = form_field(body, "endpoint")
    let p256dh: String = form_field(body, "p256dh")
    let auth: String = form_field(body, "auth")
    let topics_raw: String = form_field(body, "topics")
    if endpoint.length() == 0 or p256dh.length() == 0 or auth.length() == 0 {
        return "Datos incompletos"
    }
    // OJO: sql_esc por defecto CAPA a 256 chars y los endpoints reales lo superan
    // (WNS rutinariamente >256): se guardaría truncado en silencio, el primer envío
    // daría 404 y borraría la fila -> suscriptor roto sin error visible. Tope 2048
    // (sql_esc_n) en TODO lo que toque endpoint, y rechazo explícito si excede.
    if endpoint.length() > PUSH_EP_MAX {
        return "Endpoint demasiado largo"
    }
    if !push_host_ok(endpoint) {
        return "Origen no permitido"
    }
    let topics: String = clean_topics(topics_raw)
    let ee: String = sql_esc_n(endpoint, PUSH_EP_MAX)
    // El DELETE va PRIMERO e incondicional. Antes el `return "Sin temas"` estaba
    // ANTES del DELETE: quien desmarcaba todos los temas dejaba viva la fila vieja
    // (con los 3 temas) y SEGUÍA recibiendo avisos. Encima el cliente lo llama con
    // silent=true (src/layout.nx), así que ni veía el error: desmarcabas todo, no
    // pasaba nada visible, y los sismos seguían sonando.
    sql_exec("DELETE FROM push_subs WHERE endpoint = '" + ee + "'")
    // Sin temas = baja voluntaria, no error: el DELETE de arriba ya la efectuó.
    if topics.length() == 0 {
        return ""
    }
    sql_exec("INSERT INTO push_subs VALUES ('" + ee + "', '" + sql_esc(p256dh) + "', '" + sql_esc(auth) + "', '" + sql_esc(topics) + "', " + int_to_string(time()) + ")")
    return ""
}

pub fn push_unsubscribe(body: String) -> String {
    let endpoint: String = form_field(body, "endpoint")
    if endpoint.length() == 0 {
        return "Datos incompletos"
    }
    sql_exec("DELETE FROM push_subs WHERE endpoint = '" + sql_esc_n(endpoint, PUSH_EP_MAX) + "'")
    return ""
}

// ── Envío ───────────────────────────────────────────────────────────────────
fn audience_of(endpoint: String) -> String {
    let rest: String = endpoint.substring(8, endpoint.length())   // tras "https://"
    let slash: int = rest.indexOf("/")
    var host: String = rest
    if slash > 0 {
        host = rest.substring(0, slash)
    }
    return "https://" + host
}

// Payload JSON del push. `tag` decide QUÉ REEMPLAZA A QUÉ en el sistema: dos
// notificaciones con el mismo tag no se apilan, la nueva sustituye a la vieja.
// Por tema (tasas/chat) es lo que queremos: solo interesa el último valor. Por
// evento (sismos: tag "sismo-<id>") también, porque cada sismo es una noticia
// distinta y con tag compartido el lote entero colapsaba en UNA sola notificación.
fn push_payload(title: String, body: String, url: String, tag: String) -> String {
    return "{\"t\":\"" + pjson_esc(title) + "\",\"b\":\"" + pjson_esc(body) + "\",\"u\":\"" + pjson_esc(url) + "\",\"tag\":\"" + pjson_esc(tag) + "\"}"
}

// Cifra y envía UN push con un JWT ya firmado. Devuelve el código HTTP; borra la
// suscripción si el push service dice 404/410 (suscripción expirada).
fn push_send_raw(endpoint: String, p256dh_b64: String, auth_b64: String, jwt: String, payload: String) -> int {
    let pubkey: String = __vpub[0]
    let p256raw: String = base64url_decode(p256dh_b64)
    let authraw: String = base64url_decode(auth_b64)
    let enc: String = webpush_encrypt(payload, p256raw, authraw)
    let resp: Array = webpush_send(endpoint, jwt, pubkey, enc)
    let code: int = resp[1]
    if code == 404 or code == 410 {
        sql_exec("DELETE FROM push_subs WHERE endpoint = '" + sql_esc_n(endpoint, PUSH_EP_MAX) + "'")
    }
    return code
}

// Envía UN push suelto (firma su propio JWT).
pub fn push_send_one(endpoint: String, p256dh_b64: String, auth_b64: String, title: String, body: String, url: String, tag: String) -> int {
    let priv: String = __vpriv[0]
    let jwt: String = vapid_jwt(priv, audience_of(endpoint), VAPID_SUBJECT, time() + 43200)
    return push_send_raw(endpoint, p256dh_b64, auth_b64, jwt, push_payload(title, body, url, tag))
}

fn topic_in(csv: String, t: String) -> bool {
    let parts: Array = csv.split(",")
    var i: int = 0
    while i < parts.length() {
        let x: String = parts[i]
        if x == t {
            return true
        }
        i = i + 1
    }
    return false
}

// Envía un push a todas las suscripciones cuyo `topics` incluya `topic`.
// `tag` = tag de la notificación (ver push_payload): normalmente el propio tema,
// pero sismos manda uno POR EVENTO para que no se tapen entre sí.
// El payload se arma UNA vez y el JWT VAPID se cachea POR AUDIENCIA (la firma ECDSA
// solo depende del host; casi todos los endpoints comparten fcm.googleapis.com) —
// solo el cifrado (webpush_encrypt) es inherentemente por-suscriptor.
//
// Devuelve un resumen "sent|ok|gone|err|last" (antes: solo el nº de INTENTOS, que
// no distinguía 40 envíos correctos de 40 rechazos 403 por clave VAPID mala).
pub fn push_send_topic(topic: String, title: String, body: String, url: String, tag: String) -> String {
    let rows: Array = sql_rows("SELECT endpoint, p256dh, auth, topics FROM push_subs")
    let payload: String = push_payload(title, body, url, tag)
    let priv: String = __vpriv[0]
    var auds: Array = []
    var jwts: Array = []
    var sent: int = 0
    var ok: int = 0
    var gone: int = 0
    var err: int = 0
    var last: int = 0
    var i: int = 1
    while i < rows.length() {
        let row: Array = rows[i]
        let tp: String = row[3]
        if topic_in(tp, topic) {
            let ep: String = row[0]
            let pd: String = row[1]
            let au: String = row[2]
            let aud: String = audience_of(ep)
            var jwt: String = ""
            var j: int = 0
            while j < auds.length() {
                let a: String = auds[j]
                if a == aud {
                    let cached: String = jwts[j]
                    jwt = cached
                }
                j = j + 1
            }
            if jwt.length() == 0 {
                jwt = vapid_jwt(priv, aud, VAPID_SUBJECT, time() + 43200)
                auds.push(aud)
                jwts.push(jwt)
            }
            let code: int = push_send_raw(ep, pd, au, jwt, payload)
            sent = sent + 1
            if code >= 200 and code < 300 {
                ok = ok + 1
            } else if code == 404 or code == 410 {
                gone = gone + 1          // suscripción expirada: push_send_raw ya la borró
            } else {
                err = err + 1
                last = code              // -1 = fallo de conexión TLS
            }
        }
        i = i + 1
    }
    return int_to_string(sent) + "|" + int_to_string(ok) + "|" + int_to_string(gone) + "|" + int_to_string(err) + "|" + int_to_string(last)
}

// ── Prueba desde /admin (fuera del hilo de request) ─────────────────────────
// Los envíos van en serie (TLS + hasta ~10s por endpoint colgado): hacerlos
// dentro del POST /admin/push excede el timeout del gateway (502 -> el admin
// reintenta -> notificaciones duplicadas). Holders single-element + hilo.
var __test_topic: Array = [""]
var __test_title: Array = [""]
var __test_body: Array = [""]

fn push_test_worker() -> int {
    let topic: String = __test_topic[0]
    let title: String = __test_title[0]
    let body: String = __test_body[0]
    var url: String = "/sismos"
    if topic == "tasas" {
        url = "/finanzas"
    }
    if topic == "chat" {
        url = "/chat"
    }
    // El tema como tag: dos pruebas seguidas del mismo tema se reemplazan (con
    // renotify en el SW, la segunda vuelve a sonar). El resultado se PERSISTE porque
    // esto corre en un hilo aparte y el POST /admin/push ya redirigió: sin esto,
    // "Enviar prueba" no podía distinguir 40 envíos correctos de 40 errores 403.
    let res: String = push_send_topic(topic, title, body, url, topic)
    meta_set("push_test_result", int_to_string(time()) + "|" + topic + "|" + res)
    return 0
}

pub fn push_send_test_async(topic: String, title: String, body: String) {
    __test_topic = [topic]
    __test_title = [title]
    __test_body = [body]
    thread_spawn(push_test_worker)
}

// ── Disparadores ────────────────────────────────────────────────────────────
// Marca una sala con actividad nueva (llamado desde chat_post al publicar).
pub fn push_chat_mark(room: String) {
    meta_set("push_chat_dirty:" + room, int_to_string(time()))
}

// Tasa BCV dólar más reciente (mayor day de los últimos ~8 días). "" si no hay.
fn push_bcv_latest() -> String {
    let lo: String = int_to_string(db_day() - 8)
    let rows: Array = sql_rows("SELECT day, value FROM rates WHERE kind = 'bcv' AND day > " + lo)
    var best: int = 0
    var val: String = ""
    var i: int = 1
    while i < rows.length() {
        let row: Array = rows[i]
        let ds: String = row[0]
        let dy: int = to_int0(ds)
        if dy >= best {
            best = dy
            let vv: String = row[1]
            val = vv
        }
        i = i + 1
    }
    return val
}

// ¿Ya avisamos de este evento? Un solo agregado (nyx-db devuelve NULL si se
// combinan varios sin GROUP BY — ver CLAUDE.md).
fn push_seen_has(id: String) -> bool {
    return sql_count("SELECT COUNT(*) FROM push_seen WHERE id = '" + sql_esc(id) + "'") > 0
}

fn push_seen_add(id: String) {
    sql_exec("INSERT INTO push_seen VALUES ('" + sql_esc(id) + "', " + int_to_string(time()) + ")")
}

// Selection sort de registros por magnitud desc (in-place). Lotes diminutos.
fn push_sort_by_mag_desc(recs: Array) {
    var i: int = 0
    let n: int = recs.length()
    while i < n {
        var best: int = i
        var j: int = i + 1
        while j < n {
            let rj: Array = recs[j]
            let rb: Array = recs[best]
            let mj: String = rj[6]
            let mb: String = rb[6]
            if to_float0(mj) > to_float0(mb) {
                best = j
            }
            j = j + 1
        }
        if best != i {
            let tmp: Array = recs[i]
            recs[i] = recs[best]
            recs[best] = tmp
        }
        i = i + 1
    }
}

// Avisos de sismos. Dedup por ID DE EVENTO (tabla push_seen), no por watermark de
// tiempo. El watermark solo sobrevive como marca de "primer arranque".
//
// POR QUÉ NO un watermark de epoch (el diseño anterior perdía sismos de dos formas):
//  1. El epoch tiene granularidad de MINUTO (ni emsc_iso_epoch ni fv_iso_epoch
//     parsean segundos). Dos eventos del mismo minuto compartían epoch, así que el
//     corte `epoch <= wm` descartaba el segundo Y ADEMÁS cortaba el bucle ahí. Los
//     enjambres de réplicas producen justo eso.
//  2. Un solo watermark sobre DOS feeds con latencias distintas: EMSC publica rápido
//     y FUNVISIS tarda minutos. Un evento EMSC reciente subía el watermark por encima
//     del epoch de un sismo local que FUNVISIS aún no había publicado -> cuando por
//     fin llegaba, `epoch <= wm` lo descartaba PARA SIEMPRE.
// Con dedup por id ambos casos se avisan: lo que decide es si ya lo notificamos.
fn push_do_sismos() {
    let qs: Array = all_quakes()
    if qs.length() == 0 {
        return
    }
    let now: int = time()
    let cutoff: int = now - PUSH_SISMO_MAXAGE
    // Primera vuelta CON ESTE REGISTRO: sembrar sin notificar, para no volcar el
    // feed entero encima del usuario. La marca es propia de push_seen y NO el
    // watermark viejo: al desplegar esto sobre una instalación existente, el
    // watermark YA existía pero la tabla push_seen nacía vacía -> se habrían
    // re-notificado de golpe todos los M>=3.5 de las últimas 6 h. Mismo caso si se
    // pierde el .ndb (ya ha pasado) y la tabla vuelve a empezar de cero.
    let first: bool = to_int0(meta_get("push_seen_init")) == 0

    // Candidatos: recientes, con magnitud suficiente y no avisados. El filtro de
    // magnitud va ANTES del lookup en la tabla (comparar floats es más barato que
    // una query por evento).
    var cand: Array = []
    var i: int = 0
    while i < qs.length() {
        let rec: Array = qs[i]
        // OJO: el registro es un Array NATIVO; rec[8] (epoch) es int (NO String).
        // Leerlo como String coacciona i64->ptr -> SEGV. (Las filas de nyx-db sí
        // son todas String.)
        let epoch: int = rec[8]
        if epoch >= cutoff {
            let mags: String = rec[6]
            // to_float0 (src/num.nx), NO string_to_float: la magnitud sale del feed
            // (en FUNVISIS, del campo "phone" de una plantilla mal nombrada) y un
            // valor raro abortaba el proceso ENTERO — matando el sitio y este mismo
            // hilo de avisos.
            let mag: float = to_float0(mags)
            if mag >= PUSH_MAG_MIN {
                let id: String = rec[0]
                if !push_seen_has(id) {
                    cand.push(rec)
                }
            }
        }
        i = i + 1
    }

    if cand.length() > 0 {
        // Tope anti-enjambre: si califican demasiados, avisar de los más FUERTES (en
        // un enjambre el que importa es el mayor, no el último) y dar por vistos el
        // resto para no arrastrarlos tick tras tick.
        if cand.length() > PUSH_SISMO_BURST {
            push_sort_by_mag_desc(cand)
            var k: int = PUSH_SISMO_BURST
            while k < cand.length() {
                let rec: Array = cand[k]
                let id: String = rec[0]
                push_seen_add(id)
                k = k + 1
            }
            let top: Array = []
            var t: int = 0
            while t < PUSH_SISMO_BURST {
                top.push(cand[t])
                t = t + 1
            }
            cand = top
        }
        // Emitir del más VIEJO al más NUEVO: así el más reciente queda ARRIBA en la
        // pila de notificaciones del sistema. (qs viene ordenado por epoch desc, y
        // push_sort_by_mag_desc puede haberlo revuelto, así que se reordena por
        // epoch desc y se recorre al revés.)
        sort_recs_desc(cand)
        var e: int = cand.length() - 1
        while e >= 0 {
            let rec: Array = cand[e]
            let id: String = rec[0]
            if first {
                push_seen_add(id)
            } else {
                let mags: String = rec[6]
                let lugar: String = rec[7]
                // tag POR EVENTO: con el tag fijo "sismos" cada aviso reemplazaba al
                // anterior, así que de un lote solo quedaba visible el ÚLTIMO
                // entregado — el más viejo, porque se emitía de nuevo a viejo. Un
                // M6.0 seguido de un premonitor M3.6 se veía como "Sismo M3.6".
                push_send_topic("sismos", "Sismo M" + mags + " " + lugar, "Toca para ver detalles", "/sismos", "sismo-" + id)
                push_seen_add(id)
            }
            e = e - 1
        }
    }

    // Marca de siembra: se pone SIEMPRE al final de la primera vuelta, aunque no
    // hubiera candidatos (si no, el primer sismo real seguiría viéndose como
    // "primera vez" y se sembraría en vez de notificarse).
    if first {
        meta_set("push_seen_init", int_to_string(now))
    }
    // Watermark: ya solo es informativo (deja de decidir qué se notifica).
    let top0: Array = qs[0]
    let newest: int = top0[8]
    if newest > 0 {
        meta_set("push_wm_sismos", int_to_string(newest))
    }
    // Poda del registro de vistos (la ventana de candidatos es de 6 h; 48 h sobra).
    sql_exec("DELETE FROM push_seen WHERE ts < " + int_to_string(now - PUSH_SEEN_KEEP))
}

// "108.236400" -> "108,24": 2 decimales con coma (formato del sitio) y redondeo,
// TODO sobre el string — string_to_float con un valor no numérico de la DB
// (p.ej. "__NULL__") abortaría el proceso; ante algo raro se devuelve crudo.
// Solo para MOSTRAR: el watermark push_wm_tasa compara el valor crudo.
fn tasa_2dec(v: String) -> String {
    let dot: int = v.indexOf(".")
    if dot < 0 {
        if all_digits(v) {
            return v + ",00"
        }
        return v
    }
    let whole: String = v.substring(0, dot)
    var frac: String = v.substring(dot + 1, v.length())
    if !all_digits(whole) or !all_digits(frac) {
        return v
    }
    while frac.length() < 3 {
        frac = frac + "0"
    }
    var cents: int = string_to_int(frac.substring(0, 2))
    if "56789".indexOf(frac.substring(2, 3)) >= 0 {
        cents = cents + 1
    }
    var w: int = string_to_int(whole)
    if cents >= 100 {
        cents = cents - 100
        w = w + 1
    }
    var fs: String = int_to_string(cents)
    if cents < 10 {
        fs = "0" + fs
    }
    return int_to_string(w) + "," + fs
}

fn push_do_tasas() {
    let val: String = push_bcv_latest()
    if val.length() == 0 {
        return
    }
    let prev: String = meta_get("push_wm_tasa")
    if val == prev {
        return
    }
    // Primera vez: fija el valor sin notificar.
    if prev.length() == 0 {
        meta_set("push_wm_tasa", val)
        return
    }
    push_send_topic("tasas", "Nueva tasa BCV", "Dolar BCV: Bs " + tasa_2dec(val), "/finanzas", "tasas")
    meta_set("push_wm_tasa", val)
}

fn push_do_chat() {
    let rows: Array = sql_rows("SELECT k, v FROM meta")
    let now: int = time()
    var i: int = 1
    while i < rows.length() {
        let row: Array = rows[i]
        let k: String = row[0]
        if starts_with(k, "push_chat_dirty:") {
            let room: String = k.substring(16, k.length())
            let lastk: String = "push_chat_last:" + room
            let last: int = to_int0(meta_get(lastk))
            if now - last >= CHAT_THROTTLE {
                push_send_topic("chat", "Nuevos mensajes", "en #" + room, "/chat", "chat")
                meta_set(lastk, int_to_string(now))
                // Consumir el flag SOLO al notificar. Dentro de la ventana se
                // CONSERVA para coalescer: el aviso sale cuando expire el throttle.
                // (Borrarlo aquí descartaba el aviso de cualquier mensaje llegado
                // en los 5 min posteriores al último push si nadie más escribía.)
                sql_exec("DELETE FROM meta WHERE k = '" + sql_esc(k) + "'")
            }
        }
        i = i + 1
    }
}

// Hilo emisor: fuera del camino de request. Lee cachés ya calientes (all_quakes,
// tasa BCV) + flags de chat y emite los push. Cada 30 s.
pub fn push_worker() -> int {
    var go: bool = true
    while go {
        sleep(30000)
        push_do_sismos()
        push_do_tasas()
        push_do_chat()
    }
    return 0
}
